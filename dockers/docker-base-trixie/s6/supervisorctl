#!/usr/bin/env python3
"""Drop-in supervisorctl shim backed by s6.

SONiC health tooling (system-health's service_checker, monit) runs
    docker exec <c> bash -c "supervisorctl status"
and parses each line as "<name> <STATUS> ...", treating a critical process as
healthy only when STATUS == RUNNING (names absent from the output are ignored).
Where s6 replaced supervisord (otherwise the call is passed to supervisorctl.real),
this shim answers from the live s6 scandir and mimics supervisor 4.x closely
enough for those checks and for sonic-mgmt / containercfgd / monit:

  status [names]      one line per process, "%-*s%-10s%s" like supervisor
                      (RUNNING "pid N, uptime H:MM:SS", STARTING, BACKOFF, FATAL,
                      STOPPED, EXITED); exit 3 if any listed process is STOPPED/EXITED/
                      FATAL, 4 for an unknown name (supervisor's LSB status codes).
  start <names>       wait until the process has stayed up for startsecs, else
                      "ERROR (abnormal termination)" (rc 7); clears BACKOFF/FATAL.
  stop <names>        wait until the process (and its finish script) is down.
  restart <names>     stop then start, printing "X: stopped" / "X: started"
                      (supervisor's do_restart; there is no "restarted" string).
  reread              diff the config files against the programs loaded at container start
                      ("X: available" / "changed" / "disappeared", else "No config updates
                      to processes").
  update [groups]     add NEW programs to the live s6 scan directory (servicedir generated by
                      supervisord2s6's generate(), `s6-svscanctl -a`, autostart honoured):
                      "X: added process group". CHANGED non-critical programs are applied in
                      place: stopped, their servicedir files replaced by a fresh render of the
                      new config (supervisord2s6.swap_servicedir), started again if autostart:
                      "X: stopped" / "X: updated process group" (supervisor's wording). Removed
                      groups, and changed groups with a critical program, stay notice-only:
                      stderr "X: changed|removed; restart the container to apply".
  signal <SIG> <names>  send a signal to the supervised pid (os.kill of the pid s6-svstat reports):
                      "X: signalled"; stock errors "X: ERROR (no such process|bad signal name|
                      not running)" (rc 1 / 1 / 3).  SIG is a name with or without the SIG prefix,
                      any case, or a number.  `group:*` and `all` signal only running processes.
  pid [name|all]      the pid of one program ("0" and rc 3 when it is not running, "No such process
                      X" and rc 1 for an unknown name), of every program, or (no argument) of the
                      supervisor itself (s6-svscan).
  reload, tail, maintail, avail, and any other subcommand: not implemented.  They used to succeed
                      silently, which hid the problem from the caller; they now print a notice on
                      stderr and still exit 0 so that probes that only look at the exit code keep working.

The s6 state is read with `s6-svstat -o up,wantedup,pid,updownfor,exitcode,signum`
(machine-readable); the legacy human-readable format is only a fallback for an s6
without `-o`. Per-program startsecs/startretries/stopwaitsecs come from the
`supervisor-meta` file the converter (supervisord2s6) drops in each service dir, and the
"group:program" display name from its `supervisor-name` file; both are read from
`<servicedir>/data/` first (the only place they survive s6-rc-compile for boot services),
then `<servicedir>/`. When supervisor-meta is missing, supervisor's defaults (1 / 3 / 10) apply.
"""
import contextlib
import datetime
import io
import os
import re
import shutil
import signal
import sys
import subprocess
import time

SCANDIR = "/run/service"
EXPECTED_DIR = "/run/s6-expected"      # keep in sync with supervisord2s6.EXPECTED_DIR
SUPER_DIR = "/run/s6-super"            # keep in sync with supervisord2s6.SUPER_DIR
# s6-overlay puts its tools in /command; fall back to PATH.
S6_SVSTAT = "/command/s6-svstat" if os.path.exists("/command/s6-svstat") else "s6-svstat"
S6_SVC = "/command/s6-svc" if os.path.exists("/command/s6-svc") else "s6-svc"

# s6-rc/s6 internal services that are not SONiC processes.
SKIP_PREFIXES = ("s6-", "s6rc-", ".s6")
SKIP_EXACT = {"s6rc-fdholder", "s6rc-oneshot-runner", "s6-linux-init-shutdownd"}

# supervisor's defaults for a program that does not set the key
DEFAULT_STARTSECS = 1
DEFAULT_STARTRETRIES = 3
DEFAULT_STOPWAITSECS = 10
SPAWNERR = "Exited too quickly (process log may have details)"
# supervisor.states.STOPPED_STATES (status exits 3 if any listed process is in one)
STOPPED_STATES = ("STOPPED", "EXITED", "FATAL")
# supervisor exit codes (LSBStatusExitCode / ExitCodes)
RC_OK, RC_FAILED, RC_USAGE, RC_NOT_RUNNING, RC_STATUS_UNKNOWN, RC_ABNORMAL = 0, 1, 2, 3, 4, 7
# s6-supervise's own finish timeout (timeout-finish default), added to stop waits
FINISH_TIMEOUT_MS = 5000


# ---------------------------------------------------------------- s6 state

def _stat(path):
    """-> dict(up, wanted, pid, secs, exitcode, signum) for a service dir, or None
    when s6-supervise is not running there / the probe fails."""
    try:
        r = subprocess.run([S6_SVSTAT, "-o", "up,wantedup,pid,updownfor,exitcode,signum", path],
                           capture_output=True, text=True, timeout=5)
    except Exception:
        return None
    if r.returncode == 100:                     # usage error: s6 without -o
        return _stat_legacy(path)
    if r.returncode != 0:
        return None
    p = r.stdout.split()
    if len(p) != 6:
        return None
    try:
        return {"up": p[0] == "true", "wanted": p[1] == "true", "pid": int(p[2]),
                "secs": int(p[3]), "exitcode": int(p[4]), "signum": int(p[5])}
    except ValueError:
        return None


def _stat_legacy(path):
    """Fallback for an s6 without `s6-svstat -o`: parse the human-readable summary
    ("up (pid 52 pgid 52) 68095 seconds", "down (exitcode 0) 3 seconds, want up")."""
    try:
        r = subprocess.run([S6_SVSTAT, path], capture_output=True, text=True, timeout=5)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    st = r.stdout.strip()
    m = re.match(r"(up|down) \((pid|exitcode|signal) (\S+?)(?: pgid -?\d+)?\) (\d+) seconds(.*)", st)
    if not m:
        return None
    state, kind, val, secs, rest = m.groups()
    up = state == "up"
    wanted = ("want down" not in rest) if up else ("want up" in rest)
    exitcode, signum, pid = -1, -1, -1
    if kind == "pid":
        pid = int(val)
    elif kind == "exitcode":
        exitcode = int(val)
    else:
        signum = int(val) if val.isdigit() else {"SIGTERM": 15, "SIGKILL": 9, "SIGHUP": 1, "SIGINT": 2,
                                                "SIGQUIT": 3, "SIGUSR1": 10, "SIGUSR2": 12}.get(val, 0)
    return {"up": up, "wanted": wanted, "pid": pid, "secs": int(secs),
            "exitcode": exitcode, "signum": signum}


def _int(v, default):
    try:
        return int(float(str(v).strip()))
    except (TypeError, ValueError):
        return default


def _servicedir_file(path, name):
    """Contents of the converter's metadata file `name` (supervisor-name, supervisor-meta) of the
    live servicedir `path` (/run/service/<svc>, followed through its symlink), or None.

    s6-rc-compile copies only its known files plus data/ and env/ from a source servicedir into
    /run/s6-rc/servicedirs/<svc>, so on a boot-time service the file exists only as data/<name>;
    a servicedir built by `supervisorctl update` (/run/s6-dyn) has it in both places.  data/
    first, then the top level (older trees, hand-made servicedirs).  An empty file counts as
    missing."""
    for rel in (os.path.join("data", name), name):
        try:
            with open(os.path.join(path, rel)) as f:
                text = f.read()
        except OSError:
            continue
        if text.strip():
            return text
    return None


def _meta(path):
    """supervisor-meta (key=value lines written by the converter) with supervisor's defaults."""
    m = {"startsecs": DEFAULT_STARTSECS, "startretries": DEFAULT_STARTRETRIES,
         "stopwaitsecs": DEFAULT_STOPWAITSECS}
    for line in (_servicedir_file(path, "supervisor-meta") or "").splitlines():
        k, sep, v = line.strip().partition("=")
        if sep:
            m[k.strip()] = v.strip()
    for k, d in (("startsecs", DEFAULT_STARTSECS), ("startretries", DEFAULT_STARTRETRIES),
                 ("stopwaitsecs", DEFAULT_STOPWAITSECS)):
        m[k] = _int(m[k], d)
    return m


def _super_file(svc, name):
    return os.path.join(SUPER_DIR, svc, name)


def _read_state(svc):
    """One-word state a finish script / this shim left behind: backoff|fatal|exited|stopped|''."""
    try:
        with open(_super_file(svc, "state")) as f:
            return f.read().strip()
    except OSError:
        return ""


def _write_state(svc, value):
    try:
        os.makedirs(os.path.join(SUPER_DIR, svc), exist_ok=True)
        with open(_super_file(svc, "state"), "w") as f:
            f.write(value + "\n")
    except OSError:
        pass


def _clear_run_state(svc):
    """Forget BACKOFF/FATAL/stopped accounting (supervisor resets it on a (re)start)."""
    for n in ("state", "backoff", "stop-request"):
        try:
            os.remove(_super_file(svc, n))
        except OSError:
            pass


def _touch(path):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        open(path, "w").close()
    except OSError:
        pass


def _rm(path):
    try:
        os.remove(path)
    except OSError:
        pass


def _fmt_uptime(seconds):
    """supervisor prints str(timedelta): 0:00:05, 1 day, 2:03:04, 3 days, 0:00:09."""
    try:
        return str(datetime.timedelta(seconds=int(seconds)))
    except (TypeError, ValueError, OverflowError):
        return "0:00:00"


def _fmt_stop_time(secs):
    """supervisor's STOPPED/EXITED description: the stop time as '%b %d %I:%M %p'."""
    return time.strftime("%b %d %I:%M %p", time.localtime(time.time() - max(0, secs)))


def proc_state(svc, path, st=None, meta=None):
    """-> (STATE, description, stat) the way supervisor would describe the process.

    s6 only knows up/down/wanted; BACKOFF/FATAL/STOPPED come from the state file the
    finish script (retry accounting) and this shim leave under SUPER_DIR/<svc>/.
    """
    st = st or _stat(path)
    if st is None:
        return None, "", None
    meta = meta or _meta(path)
    if st["up"]:
        # supervisor reports RUNNING only once the process has stayed up for startsecs
        if meta["startsecs"] == 0 or st["secs"] >= meta["startsecs"]:
            return "RUNNING", "pid %d, uptime %s" % (st["pid"], _fmt_uptime(st["secs"])), st
        return "STARTING", "", st
    state = _read_state(svc)
    if state == "fatal":
        return "FATAL", SPAWNERR, st
    if state == "backoff" and st["wanted"]:
        return "BACKOFF", SPAWNERR, st
    if state == "stopped":
        return "STOPPED", _fmt_stop_time(st["secs"]), st
    if state == "exited" or not st["wanted"]:
        return "EXITED", _fmt_stop_time(st["secs"]), st
    # wanted and down with no verdict yet: s6 is about to (re)spawn it
    return "STARTING", "", st


# ---------------------------------------------------------------- name handling

def _display_name(dirname, path):
    # supervisord prints "group:program" for processes that belong to a
    # [group:X] section; the converter records that mapping in a
    # "supervisor-name" file in the service definition (data/supervisor-name:
    # the only place it survives s6-rc-compile, see _servicedir_file) since the
    # s6 service directory itself must still be named after the bare program
    # (dependencies.d/ edges reference it). Fall back to the bare dirname
    # for ungrouped programs or if the file is missing.
    name = _servicedir_file(path, "supervisor-name")
    return name.strip() if name else dirname


def _services():
    """-> sorted [(display_name, dirname, path)] of every supervised program."""
    try:
        entries = os.listdir(SCANDIR)
    except FileNotFoundError:
        return []
    out = []
    for dirname in entries:
        path = os.path.join(SCANDIR, dirname)
        if not os.path.isdir(path):
            continue
        if dirname in SKIP_EXACT or dirname.startswith(SKIP_PREFIXES):
            continue
        out.append((_display_name(dirname, path), dirname, path))
    return sorted(out)


def _match(token, svcs):
    """Services selected by one name token: a bare program name, "group:program",
    "group:*" / "group:" (every member), or "all"."""
    if token == "all":
        return list(svcs)
    if token.endswith(":*") or (token.endswith(":") and len(token) > 1):
        grp = token.rsplit(":", 1)[0]
        return [s for s in svcs if s[0].startswith(grp + ":")]
    # accept the bare program name or the group-qualified name so both conventions work
    # (readiness_probe.sh uses the former, a "group:program" filter the latter)
    return [s for s in svcs if token in (s[0], s[1])]


def _resolve(name):
    """Resolve a bare or "group:program" name to its s6 service dir name."""
    path = os.path.join(SCANDIR, name)
    if os.path.isdir(path):
        return name
    try:
        for dirname in os.listdir(SCANDIR):
            dpath = os.path.join(SCANDIR, dirname)
            if os.path.isdir(dpath) and _display_name(dirname, dpath) == name:
                return dirname
    except FileNotFoundError:
        pass
    return name


# ---------------------------------------------------------------- status

def cmd_status(args):
    svcs = _services()
    wanted = list(args)
    if not wanted or "all" in wanted:
        selected = svcs
        bad = []
    else:
        selected, seen, bad = [], set(), []
        for tok in wanted:
            hit = _match(tok, svcs)
            if not hit:
                bad.append(tok)
            for s in hit:
                if s[1] not in seen:
                    seen.add(s[1])
                    selected.append(s)
        selected.sort()
    rows = []
    for name, dirname, path in selected:
        state, desc, _ = proc_state(dirname, path)
        if state is None:
            continue
        rows.append((name, state, desc))
    width = max([30] + [len(r[0]) for r in rows]) + 3
    for name, state, desc in rows:
        print("%-*s%-10s%s" % (width, name, state, desc))
    rc = RC_OK
    for tok in bad:
        group_form = tok.endswith(":*") or tok.endswith(":")
        print("%s: ERROR (%s)" % (tok, "no such group" if group_form else "no such process"))
        rc = RC_STATUS_UNKNOWN
    if any(r[1] in STOPPED_STATES for r in rows):     # supervisor: NOT_RUNNING wins over STATUS_UNKNOWN
        rc = RC_NOT_RUNNING
    return rc


# ---------------------------------------------------------------- start / stop / restart

def _stop_timeout_ms(path, meta):
    """Upper bound for `s6-svc -wD`: timeout-kill + finish timeout + slack."""
    kill_ms = meta["stopwaitsecs"] * 1000
    try:
        with open(os.path.join(path, "timeout-kill")) as f:
            kill_ms = _int(f.read(), kill_ms)
    except OSError:
        pass
    return kill_ms + FINISH_TIMEOUT_MS + 3000


def stop_one(name, svc, path):
    """supervisor's stop: wait until it is down; rc 0 even if it was not running."""
    st = _stat(path)
    state, _, st = proc_state(svc, path, st)
    if state not in ("RUNNING", "STARTING", "BACKOFF"):
        print("%s: ERROR (not running)" % name)
        return RC_OK
    meta = _meta(path)
    if st["up"]:
        # Mark the stop as requested so a critical process' finish does not halt the
        # container. Only when a process is alive: a marker left for a service that is not
        # running would make the next *real* crash look like a requested stop.
        _touch(os.path.join(EXPECTED_DIR, svc))
    # the finish script's BACKOFF wait polls this, so stopping a backing-off program is prompt
    _touch(_super_file(svc, "stop-request"))
    try:
        r = subprocess.run([S6_SVC, "-d", "-wD", "-T", str(_stop_timeout_ms(path, meta)), path],
                           timeout=_stop_timeout_ms(path, meta) / 1000.0 + 5)
        ok = r.returncode == 0
    except Exception:
        ok = False
    _rm(os.path.join(EXPECTED_DIR, svc))      # normally consumed by finish already
    _rm(_super_file(svc, "stop-request"))
    if not ok:
        print("%s: ERROR (abnormal termination)" % name)
        return RC_FAILED
    _write_state(svc, "stopped")
    try:
        os.remove(_super_file(svc, "backoff"))
    except OSError:
        pass
    print("%s: stopped" % name)
    return RC_OK


def start_one(name, svc, path):
    """supervisor's start: wait until the process has stayed up for startsecs."""
    st = _stat(path)
    state, _, st = proc_state(svc, path, st)
    if state in ("RUNNING", "STARTING", "BACKOFF"):
        print("%s: ERROR (already started)" % name)
        return RC_OK
    meta = _meta(path)
    # a FATAL/stopped verdict and any stale "requested stop" marker die with the new start
    _clear_run_state(svc)
    _rm(os.path.join(EXPECTED_DIR, svc))
    try:
        # -u in the down state starts at once, even after a finish script's exit 125
        r = subprocess.run([S6_SVC, "-u", "-wu", "-T", "5000", path], timeout=15)
        spawned = r.returncode == 0
    except Exception:
        spawned = False
    if not spawned:
        print("%s: ERROR (spawn error)" % name)
        return RC_ABNORMAL
    t0 = time.monotonic()
    first_pid = None
    while True:
        cur = _stat(path)
        if cur is None or not cur["up"] or (first_pid is not None and cur["pid"] != first_pid):
            if meta["startsecs"] > 0:     # died (or was respawned) inside startsecs
                print("%s: ERROR (abnormal termination)" % name)
                return RC_ABNORMAL
            break
        first_pid = cur["pid"] if first_pid is None else first_pid
        remaining = meta["startsecs"] - (time.monotonic() - t0)
        if remaining <= 0:
            break
        time.sleep(min(0.1, remaining))
    print("%s: started" % name)
    return RC_OK


def _targets(args, only):
    """-> ([(display, dirname, path)], rc) for a start/stop/restart name list. `only` is a
    predicate on proc_state names selecting what `all` / `group:*` act on (supervisor's
    start all / stop all skip processes that are already in the wanted state)."""
    svcs = _services()
    out, seen, rc = [], set(), RC_OK
    for tok in args:
        if tok == "all":
            hit = [s for s in svcs if only(proc_state(s[1], s[2])[0])]
        else:
            hit = _match(tok, svcs)
            if not hit:
                # a bare name may be a service dir that is not in the scan list (kept lenient)
                svc = _resolve(tok)
                path = os.path.join(SCANDIR, svc)
                if os.path.isdir(path):
                    hit = [(tok, svc, path)]
        if not hit:
            print("%s: ERROR (%s)" % (tok, "no such group" if tok.endswith(":*") or tok.endswith(":")
                                  else "no such process"))
            rc = RC_FAILED
            continue
        for s in hit:
            if s[1] not in seen:
                seen.add(s[1])
                out.append(s)
    return out, rc


_RUNNING_LIKE = ("RUNNING", "STARTING", "BACKOFF")


def cmd_ctl(action, args):
    if not args:
        print("Error: %s requires a process name" % action)
        return RC_USAGE if action == "start" else RC_FAILED
    rc = RC_OK
    if action in ("stop", "restart"):
        targets, trc = _targets(args, lambda s: s in _RUNNING_LIKE)
        rc = max(rc, trc)
        for name, svc, path in targets:
            rc = max(rc, stop_one(name, svc, path))
    if action in ("start", "restart"):
        targets, trc = _targets(args, lambda s: s is not None and s not in _RUNNING_LIKE)
        rc = max(rc, trc)
        for name, svc, path in targets:
            rc = max(rc, start_one(name, svc, path))
    return rc


# ---------------------------------------------------------------- reread / update

S6_SVSCANCTL = "/command/s6-svscanctl" if os.path.exists("/command/s6-svscanctl") else "s6-svscanctl"
RESTART_NOTICE = "restart the container to apply"
SUPERVISE_WAIT = 5.0       # s: s6-svscan spawns s6-supervise for a new servicedir within ms


def _converter():
    """The supervisord2s6 module (shared generation code), imported lazily: only reread/update
    need it. Installed as /usr/local/bin/supervisord2s6; a sibling .py is used from a source tree."""
    import importlib.machinery
    import importlib.util
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.environ.get("SUPERVISORD2S6"), os.path.join(here, "supervisord2s6.py"),
              "/usr/local/bin/supervisord2s6", "/usr/bin/supervisord2s6"):
        if p and os.path.isfile(p):
            loader = importlib.machinery.SourceFileLoader("supervisord2s6", p)
            spec = importlib.util.spec_from_loader("supervisord2s6", loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            return mod
    raise ImportError("supervisord2s6 not found")


def _config_diff():
    """-> (diff, rc): diff = (s2s, manifest, sections, order, group_of, (added, changed, removed))
    from the config files on disk vs what was loaded, or None (rc says how to exit) when it cannot
    be determined: a container without the manifest is a no-op like before (rc 0), an invalid
    config is an error like supervisor's CANT_REREAD (rc 1)."""
    s2s = _converter()
    manifest = s2s.read_loaded_manifest()
    if manifest is None:
        sys.stderr.write("supervisorctl: no loaded-program manifest (%s); reread/update need a container "
                         "started by this s6 shim\n" % s2s.LOADED_MANIFEST)
        return None, RC_OK
    sections, order, group_of = s2s.current_config(manifest)
    for name in order:      # supervisord refuses the whole config on a program without command
        if name.startswith("program:") and not sections[name].get("command", "").strip():
            print("ERROR: CANT_REREAD: section '%s' is missing required key 'command'" % name)
            return None, RC_FAILED
    new = s2s.loaded_programs(sections, order, group_of)
    return (s2s, manifest, sections, order, group_of, s2s.diff_loaded(manifest["programs"], new)), RC_OK


def cmd_reread(args):
    """supervisor's reread: report what the config files add/change/drop vs the loaded config
    (nothing is applied; `update` applies new programs)."""
    if args:
        print("Error: reread accepts no arguments")
        return RC_FAILED
    got, rc = _config_diff()
    if got is None:
        return rc
    added, changed, removed = got[5]
    lines = {}
    for names, word in ((added, "available"), (changed, "changed"), (removed, "disappeared")):
        lines.update({n: word for n in names})
    for n in sorted(lines):
        print("%s: %s" % (n, lines[n]))
    if not lines:
        print("No config updates to processes")
    return RC_OK


def _autostart(attrs):
    """supervisord's autostart (default true when the key is absent)."""
    return str(attrs.get("autostart", "true")).strip().lower() in ("true", "1", "yes", "on")


def _build_program(s2s, pname, attrs, group_of):
    """Create the servicedir of one new program under DYN_DIR (not yet visible to s6-svscan).
    -> error string or None."""
    if (not pname or pname.startswith(".") or "/" in pname or pname in SKIP_EXACT
            or pname.startswith(SKIP_PREFIXES)):
        return "bad program name"
    if os.path.lexists(os.path.join(SCANDIR, pname)):   # also a boot-time s6-rc service of that name
        return "already exists"
    dest = os.path.join(s2s.DYN_DIR, pname)
    try:
        s2s.build_runtime_servicedir(pname, attrs, group_of, dest, autostart=_autostart(attrs))
    except Exception as e:                  # e.g. unbalanced quotes in command=
        sys.stderr.write("supervisorctl: %s: cannot create service: %s\n" % (pname, e))
        shutil.rmtree(dest, ignore_errors=True)
        return "spawn error"
    return None


def _wait_supervised(path):
    """True once s6-supervise answers on the servicedir."""
    deadline = time.monotonic() + SUPERVISE_WAIT
    while True:
        if _stat(path) is not None:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.05)


def _link_groups(s2s, groups, sections, group_of):
    """Make NEW programs live: build every listed program's servicedir (generate(), like the boot-time
    conversion), link it into the scan directory, one `s6-svscanctl -a` for all of them.
    `groups` = {group: [programs to add]}; a group is all-or-nothing and is rolled back as a whole.
    -> ({group: error}, linked): `linked` = [(group, program, link)] of every symlink made, so the caller
    knows whether the manifest needs a save (also for the groups that failed: they are rolled back)."""
    failed = {}
    # phase 1: build every member's servicedir
    for g, progs in groups.items():
        for i, p in enumerate(progs):
            err = _build_program(s2s, p, sections["program:" + p], group_of)
            if err:
                failed[g] = err
                for q in progs[:i]:
                    shutil.rmtree(os.path.join(s2s.DYN_DIR, q), ignore_errors=True)
                break
    # phase 2: make the complete groups visible to s6-svscan, one rescan for all of them
    linked = []
    for g, progs in groups.items():
        if g in failed:
            continue
        for p in progs:
            _clear_run_state(p)
            link = os.path.join(SCANDIR, p)
            try:
                os.symlink(os.path.join(s2s.DYN_DIR, p), link)    # atomic: never a half-written dir
            except OSError as e:
                sys.stderr.write("supervisorctl: %s: cannot link into %s: %s\n" % (p, SCANDIR, e))
                failed[g] = "spawn error"
                break
            linked.append((g, p, link))
    if linked:
        scanned = subprocess.run([S6_SVSCANCTL, "-a", SCANDIR], capture_output=True).returncode == 0
        for g, p, link in linked:
            if g not in failed and not (scanned and _wait_supervised(link)):
                failed[g] = "spawn error"
        for g, p, link in linked:
            if g in failed:
                _rm(link)
                shutil.rmtree(os.path.join(s2s.DYN_DIR, p), ignore_errors=True)
    return failed, linked


def _critical_programs(s2s, group_of):
    """Programs critical_processes names (read like at boot; empty when unreadable)."""
    try:
        return set(s2s.read_critical(s2s.DEFAULT_CRITICAL, group_of))
    except Exception:
        return set()


def _plan_changed(s2s, g, manifest, cur, members, old_members, group_of):
    """What `update` does for the changed group `g` -> {"swap": [...], "link": [...]} or None when it
    cannot be applied to the running tree (the caller then prints the restart notice).

    swap = loaded programs of `g` whose config changed and that have a live servicedir (their files are
           replaced in place, the process restarted); unchanged members are left running.
    link = members with no servicedir yet: new in the group, or loaded at boot but never given a
           servicedir (autostart=false) - built like an added program.
    None  = a member that would be swapped is critical (a stop would run its halt logic;
            critical_processes is a boot-time input), or a member left the group (dropped from the
            config or moved to another group, supervisord would stop it).  All or nothing: the group's
            other members wait for the container restart too.  An unchanged critical member is never
            touched, so it does not block its group."""
    if set(old_members.get(g, {})) - set(members.get(g, {})):
        return None
    critical = _critical_programs(s2s, group_of)
    swap, link = [], []
    for p in sorted(members[g]):
        old = manifest["programs"].get(p)
        if old is not None and old == cur[p]:
            continue
        path = os.path.join(SCANDIR, p)
        if old is None or not os.path.lexists(path):
            link.append(p)
            continue
        if p in critical or _meta(path).get("critical") == "1":
            return None
        swap.append(p)
    return {"swap": swap, "link": link}


def _quiet(fn, *a):
    """-> (rc, captured stdout) of a start_one / stop_one call (their per-program lines are folded into
    one group line like supervisor's update prints)."""
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        rc = fn(*a)
    return rc, buf.getvalue()


def _update_changed(s2s, g, plan, sections, group_of, manifest, cur):
    """Apply a changed group, supervisor's order: stop, replace, start (autostart honoured).  Every
    new servicedir is rendered before anything is stopped, so a config error leaves the group running
    untouched.  The manifest entry of each program is updated as soon as it is applied (a retry then
    redoes only what is left).  -> (rc, manifest_changed)."""
    swap, link = plan["swap"], plan["link"]
    staged, dirty = {}, False
    try:
        for p in swap:
            attrs = sections["program:" + p]
            try:
                staged[p] = s2s.render_servicedir(p, attrs, group_of, s2s.DYN_DIR, autostart=_autostart(attrs))
            except Exception as e:                  # e.g. unbalanced quotes in command=
                sys.stderr.write("supervisorctl: %s: cannot create service: %s\n" % (p, e))
                print("%s: ERROR (spawn error)" % g)
                return RC_FAILED, dirty
        if link:
            failed, linked = _link_groups(s2s, {g: link}, sections, group_of)
            if g in failed:
                print("%s: ERROR (%s)" % (g, failed[g]))
                return RC_FAILED, dirty
            for p in link:
                if not _autostart(sections["program:" + p]):
                    _write_state(p, "stopped")
                manifest["programs"][p] = cur[p]
            dirty = True
        # stop what is up (the existing stop: requested-stop marker, s6-svc -d -wD)
        stopped = []
        for p in swap:
            path = os.path.join(SCANDIR, p)
            if proc_state(p, path)[0] not in _RUNNING_LIKE:
                continue
            rc, _ = _quiet(stop_one, p, p, path)
            if rc != RC_OK:
                for q in stopped:                   # put back what we took down; config untouched
                    _quiet(start_one, q, q, os.path.join(SCANDIR, q))
                print("%s: ERROR (abnormal termination)" % g)
                return RC_FAILED, dirty
            stopped.append(p)
        print("%s: stopped" % g)
        # replace the files in place (atomic per file; supervise/ and the s6-supervise process stay)
        for p in swap:
            try:
                s2s.swap_servicedir(staged[p][1], os.path.join(SCANDIR, p))
            except OSError as e:
                sys.stderr.write("supervisorctl: %s: cannot replace the service files: %s\n" % (p, e))
                print("%s: ERROR (spawn error)" % g)
                return RC_FAILED, dirty
            manifest["programs"][p] = cur[p]
            dirty = True
        for p in swap:
            path = os.path.join(SCANDIR, p)
            if _autostart(sections["program:" + p]):
                rc, out = _quiet(start_one, _display_name(p, path), p, path)
                if rc != RC_OK:                     # supervisor's update does not fail either (BACKOFF)
                    sys.stderr.write(out)
            else:
                _write_state(p, "stopped")
        print("%s: updated process group" % g)
        return RC_OK, dirty
    finally:
        for scratch, _ in staged.values():
            shutil.rmtree(scratch, ignore_errors=True)


def cmd_update(args):
    """supervisor's update: NEW groups are built (same generate() code as the boot-time conversion),
    linked into the scan directory, `s6-svscanctl -a`, autostart honoured ("added process group").
    CHANGED groups are applied in place: stop the changed programs, replace their servicedir files with a
    fresh render of the new config, start them again ("stopped" / "updated process group").  Programs
    that cannot be changed live stay notice-only (stderr "X: changed|removed; restart the container to
    apply", rc 0 so that `reread && update && start X` flows continue): removed groups, and changed
    groups with a critical program or a member that left the group."""
    got, rc = _config_diff()
    if got is None:
        return rc
    s2s, manifest, sections, order, group_of, (added, changed, removed) = got
    wanted = set(args) - {"all"}
    if wanted:
        known = set(s2s.config_groups(manifest["programs"])) | set(added)
        for g in sorted(wanted - known):
            print("ERROR: no such group: %s" % g)
            rc = RC_FAILED
    pick = lambda names: [n for n in names if not wanted or n in wanted]   # noqa: E731
    for g in pick(removed):
        sys.stderr.write("%s: removed; %s\n" % (g, RESTART_NOTICE))
    cur = s2s.loaded_programs(sections, order, group_of)
    members = s2s.config_groups(cur)
    old_members = s2s.config_groups(manifest["programs"])
    save = False
    for g in pick(changed):
        plan = _plan_changed(s2s, g, manifest, cur, members, old_members, group_of)
        if plan is None:
            sys.stderr.write("%s: changed; %s\n" % (g, RESTART_NOTICE))
            continue
        crc, dirty = _update_changed(s2s, g, plan, sections, group_of, manifest, cur)
        rc, save = max(rc, crc), save or dirty
    groups = {g: sorted(members[g]) for g in pick(added)}
    failed, linked = _link_groups(s2s, groups, sections, group_of)
    for g in groups:
        if g in failed:
            print("%s: ERROR (%s)" % (g, failed[g]))
            rc = RC_FAILED
            continue
        for p in groups[g]:
            if not _autostart(sections["program:" + p]):
                _write_state(p, "stopped")      # shown as STOPPED until `supervisorctl start`
            manifest["programs"][p] = cur[p]
        print("%s: added process group" % g)
    if linked or save:
        try:
            s2s.save_loaded_manifest(manifest)
        except OSError as e:
            sys.stderr.write("supervisorctl: cannot update %s: %s\n" % (s2s.LOADED_MANIFEST, e))
    return rc


# ---------------------------------------------------------------- signal / pid

# supervisor's SIGNALLABLE_STATES (STOPPING does not exist here: a stop is synchronous)
SIGNALLABLE = ("RUNNING", "STARTING")
SIGNAL_HELP = (
    "signal <signal name> <name>\t\tSignal a process",
    "signal <signal name> <gname>:*\t\tSignal all processes in a group",
    "signal <signal name> <name> <name>\tSignal multiple processes or groups",
    "signal <signal name> all\t\tSignal all processes",
)


def _signal_number(value):
    """supervisor.datatypes.signal_number: a signal name (any case, "SIG" prefix optional) or a number
    -> int, or None when it is not a signal."""
    try:
        num = int(value)
    except (TypeError, ValueError):
        name = str(value).strip().upper()
        if not name.startswith("SIG"):
            name = "SIG" + name
        try:
            return signal.Signals[name].value
        except KeyError:
            return None
    return num if num in {s.value for s in signal.Signals} else None


def _live_pid(svc, path):
    """-> (state, pid): pid is the supervised process (0 when it is not up)."""
    state, _, st = proc_state(svc, path)
    return state, (st["pid"] if st is not None and st["up"] and st["pid"] > 0 else 0)


def signal_one(name, svc, path, sig):
    """supervisor's signalProcess for one process; prints supervisor's line.  -> exit code."""
    num = _signal_number(sig)
    if num is None:                                  # supervisor checks the signal before the state
        print("%s: ERROR (bad signal name)" % name)
        return RC_FAILED
    state, pid = _live_pid(svc, path)
    if state not in SIGNALLABLE or not pid:
        print("%s: ERROR (not running)" % name)
        return RC_NOT_RUNNING
    try:
        os.kill(pid, num)
    except ProcessLookupError:                       # exited just now on its own: supervisor reports success too
        pass
    except OSError as e:
        print("%s: ERROR (unknown problem sending sig %s (%d): %s)" % (name, sig, pid, e))
        return RC_FAILED
    print("%s: signalled" % name)
    return RC_OK


def cmd_signal(args):
    """supervisorctl signal <signal> <name|group:*|all> [...]  (see the module docstring)."""
    if len(args) < 2:
        print("Error: signal requires a signal name and a process name")
        for line in SIGNAL_HELP:
            print(line)
        return RC_FAILED
    sig, names = args[0], args[1:]
    svcs = _services()
    running = lambda s: proc_state(s[1], s[2])[0] in SIGNALLABLE        # noqa: E731
    rc = RC_OK
    if "all" in names:
        for name, svc, path in [s for s in svcs if running(s)]:
            rc = max(rc, signal_one(name, svc, path, sig))
        return rc
    for tok in names:
        hit = _match(tok, svcs)
        if not hit:
            print("%s: ERROR (%s)" % (tok, "no such group" if tok.endswith(":*") or tok.endswith(":")
                                  else "no such process"))
            rc = max(rc, RC_FAILED)
            continue
        if tok.endswith(":*") or tok.endswith(":"):       # a group only signals what is running
            hit = [s for s in hit if running(s)]
        for name, svc, path in hit:
            rc = max(rc, signal_one(name, svc, path, sig))
    return rc


def _supervisor_pid():
    """supervisor's `pid` with no argument = the supervisor process: here s6-svscan (PID 1 under s6-overlay)."""
    try:
        with open("/proc/1/comm") as f:
            if f.read().strip().startswith("s6"):
                return 1
    except OSError:
        pass
    found = []
    try:
        for d in os.listdir("/proc"):
            if d.isdigit():
                try:
                    with open("/proc/%s/comm" % d) as f:
                        if f.read().strip() == "s6-svscan":
                            found.append(int(d))
                except OSError:
                    continue
    except OSError:
        pass
    return min(found) if found else 1


def cmd_pid(args):
    """supervisorctl pid [name ...|all]: no argument = the supervisor, `all` = every program (0 for a down
    one), else each name: its pid ("0" + rc 3 when not running, "No such process X" + rc 1 when unknown)."""
    if not args:
        print(_supervisor_pid())
        return RC_OK
    svcs = _services()
    if "all" in args:
        for _, svc, path in svcs:
            print(_live_pid(svc, path)[1])
        return RC_OK
    rc = RC_OK
    for tok in args:
        hit = [s for s in svcs if tok in (s[0], s[1])]     # exact program, no wildcards (getProcessInfo)
        if not hit:
            print("No such process %s" % tok)
            rc = max(rc, RC_FAILED)
            continue
        pid = _live_pid(hit[0][1], hit[0][2])[1]
        print(pid)
        if pid == 0:
            rc = max(rc, RC_NOT_RUNNING)
    return rc


def cmd_unsupported(cmd):
    """reload / tail / maintail / avail / anything else: not implemented.  Say so on stderr (it used to be a silent
    success that hid the gap from the caller) but keep rc 0 so probes that only look at the exit code still work."""
    sys.stderr.write("supervisorctl: '%s' is not supported by the s6 shim; ignored (no-op, rc 0)\n" % cmd)
    return RC_OK


REAL_SUPERVISORCTL = ("/usr/local/bin/supervisorctl.real", "/usr/bin/supervisorctl.real")


def s6_running():
    """True when this container is supervised by s6 (see supervisord2s6 PID-1
    rule); containers that fell back to the real supervisord have no s6 tree."""
    return os.path.isdir("/run/s6") and os.path.isdir(SCANDIR)


def exec_real(argv):
    for real in REAL_SUPERVISORCTL:
        if os.path.exists(real):
            os.execv(real, [real] + list(argv))
    sys.stderr.write("supervisorctl: supervisorctl.real not found\n")
    return 127


def main(argv):
    if not s6_running():
        return exec_real(argv)
    if not argv or argv[0] == "status":
        return cmd_status(argv[1:])
    if argv[0] in ("start", "stop", "restart"):
        return cmd_ctl(argv[0], argv[1:])
    if argv[0] == "reread":
        return cmd_reread(argv[1:])
    if argv[0] == "update":
        return cmd_update(argv[1:])
    if argv[0] == "signal":
        return cmd_signal(argv[1:])
    if argv[0] == "pid":
        return cmd_pid(argv[1:])
    # reload, tail, maintail, avail and anything else: loud no-op (stderr notice, rc 0)
    return cmd_unsupported(argv[0])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
