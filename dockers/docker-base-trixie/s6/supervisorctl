#!/usr/bin/env python3
"""Drop-in supervisorctl shim backed by s6.

SONiC health tooling (system-health's service_checker, monit) runs
    docker exec <c> bash -c "supervisorctl status"
and parses each line as "<name> <STATUS> ...", treating a critical process as
healthy only when STATUS == RUNNING (names absent from the output are ignored).
Since s6 replaced supervisord, this shim answers `status` from the live s6
scandir so those checks keep working - avoiding false "process down" alarms,
their event/log spam, and the repeated docker-exec churn a failing exec causes.

Only `status` needs to be faithful; start/stop/restart are mapped to s6-svc
best-effort for the rare manual/monit action.
"""
import os
import re
import sys
import subprocess

SCANDIR = "/run/service"
# s6-overlay puts its tools in /command; fall back to PATH.
S6_SVSTAT = "/command/s6-svstat" if os.path.exists("/command/s6-svstat") else "s6-svstat"
S6_SVC = "/command/s6-svc" if os.path.exists("/command/s6-svc") else "s6-svc"

# s6-rc/s6 internal services that are not SONiC processes.
SKIP_PREFIXES = ("s6-", "s6rc-", ".s6")
SKIP_EXACT = {"s6rc-fdholder", "s6rc-oneshot-runner", "s6-linux-init-shutdownd"}


def _svstat(path):
    try:
        r = subprocess.run([S6_SVSTAT, path], capture_output=True, text=True, timeout=5)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    return r.stdout.strip()


def _fmt_uptime(seconds):
    try:
        s = int(seconds)
    except (TypeError, ValueError):
        return "0:00:00"
    return "%d:%02d:%02d" % (s // 3600, (s % 3600) // 60, s % 60)


def _display_name(dirname, path):
    # supervisord prints "group:program" for processes that belong to a
    # [group:X] section; the converter records that mapping in a
    # "supervisor-name" file alongside the service definition since the s6
    # service directory itself must still be named after the bare program
    # (dependencies.d/ edges reference it). Fall back to the bare dirname
    # for ungrouped programs or if the marker is missing.
    try:
        with open(os.path.join(path, "supervisor-name")) as f:
            name = f.read().strip()
            if name:
                return name
    except OSError:
        pass
    return dirname


def cmd_status(args):
    try:
        entries = sorted(os.listdir(SCANDIR))
    except FileNotFoundError:
        return 0
    wanted = list(args)
    matched = set()
    for dirname in entries:
        path = os.path.join(SCANDIR, dirname)
        if not os.path.isdir(path):
            continue
        if dirname in SKIP_EXACT or dirname.startswith(SKIP_PREFIXES):
            continue
        name = _display_name(dirname, path)
        # supervisorctl status <name> [<name> ...] filters to just those
        # processes; a bare "supervisorctl status" lists everything. Accept
        # either the bare program name or the group-qualified name so both
        # conventions work (readiness_probe.sh uses the former, a
        # "group:program" filter would use the latter).
        if wanted and name not in wanted and dirname not in wanted:
            continue
        matched.add(name)
        if dirname in wanted:
            matched.add(dirname)
        st = _svstat(path)
        if st is None:
            continue
        toks = st.split()
        if toks and toks[0] == "up":
            m = re.search(r"\(pid (\d+)\) (\d+) seconds", st)
            pid = m.group(1) if m else "0"
            secs = m.group(2) if m else "0"
            print("%-32s RUNNING   pid %s, uptime %s" % (name, pid, _fmt_uptime(secs)))
        else:
            # down/exited -> report a non-RUNNING state so checks can react
            print("%-32s EXITED    %s" % (name, st))
    rc = 0
    for name in wanted:
        if name not in matched:
            print("%s: ERROR (no such process)" % name)
            rc = 1
    return rc


def _resolve(name):
    """Resolve a bare or "group:program" name to its s6 service dir name."""
    path = os.path.join(SCANDIR, name)
    if os.path.isdir(path):
        return name
    try:
        for dirname in os.listdir(SCANDIR):
            dpath = os.path.join(SCANDIR, dirname)
            if os.path.isdir(dpath) and _display_name(dirname, dpath) == name:
                return dirname
    except FileNotFoundError:
        pass
    return name


def cmd_ctl(action, args):
    if not args:
        return 1
    flag = {"start": "-u", "stop": "-d", "restart": "-r"}[action]
    rc = 0
    for name in args:
        path = os.path.join(SCANDIR, _resolve(name))
        if not os.path.isdir(path):
            print("%s: ERROR (no such process)" % name)
            rc = 1
            continue
        try:
            subprocess.run([S6_SVC, flag, path], timeout=10)
            print("%s: %s" % (name, "started" if action == "start"
                              else "stopped" if action == "stop" else "restarted"))
        except Exception as e:
            print("%s: ERROR (%s)" % (name, e))
            rc = 1
    return rc


def main(argv):
    if not argv or argv[0] == "status":
        return cmd_status(argv[1:])
    if argv[0] in ("start", "stop", "restart"):
        return cmd_ctl(argv[0], argv[1:])
    # Unknown subcommands (e.g. reread/update/tail): no-op success so callers
    # that probe supervisorctl don't error out.
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
