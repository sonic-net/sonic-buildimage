{% set prefix = DEFAULT_CONTAINER_REGISTRY %}
{% from "dockers/dockerfile-macros.j2" import install_debian_packages, install_python_wheels, copy_files %}
{% if CONFIGURED_ARCH == "armhf" and (MULTIARCH_QEMU_ENVIRON == "y" or CROSS_BUILD_ENVIRON == "y") %}
ARG BASE=--platform=linux/arm/v7 {{ prefix }}debian:trixie
{% elif CONFIGURED_ARCH == "arm64" and (MULTIARCH_QEMU_ENVIRON == "y" or CROSS_BUILD_ENVIRON == "y") %}
ARG BASE=--platform=linux/arm64 {{ prefix }}debian:trixie
{% else %}
ARG BASE={{ prefix }}debian:trixie
{% endif %}

FROM $BASE AS base

# Make apt-get non-interactive
ENV DEBIAN_FRONTEND=noninteractive

# Configure data sources for apt/dpkg
COPY ["dpkg_01_drop", "/etc/dpkg/dpkg.cfg.d/01_drop"]
COPY ["sources.list.{{ CONFIGURED_ARCH }}", "/etc/apt/sources.list"]
COPY ["files/apt/apt.conf.d/", "/etc/apt/apt.conf.d/"]
# Install certificates by disabling the peer verification
RUN apt -o Acquire::https::Verify-Peer=false update && \
    apt -o Acquire::https::Verify-Peer=false install -y ca-certificates

# Update apt cache and
# pre-install fundamental packages
RUN apt update &&            \
    apt -y install           \
        curl                 \
        less                 \
        perl                 \
        procps               \
        python3              \
        python3-pip          \
        python3-setuptools   \
        python3-wheel        \
        python-is-python3    \
        vim-tiny             \
        rsyslog              \
        rsyslog-relp         \
# Install rsync for copying over only changes between layers
        rsync                \
# Install redis-tools
        redis-tools          \
# common dependencies
        libdaemon0           \
        libdbus-1-3          \
        libjansson4          \
# ip and ifconfig utility missing in docker for arm arch
        net-tools            \
# for processing/handling json files in bash environment
        jq                   \
# for sairedis zmq rpc channel
        libzmq5              \
        libwrap0            \
        libatomic1{% if OPTIMIZE_SUPD_S6 == 'y' %}           \
# for s6-overlay tarball extraction
        xz-utils{% endif %}

# Add a config file to allow pip to install packages outside of apt/the Debian repos
COPY ["pip.conf", "/etc/pip.conf"]

{% if docker_base_trixie_whls.strip() -%}
# Copy locally-built Python wheel dependencies
{{ copy_files("python-wheels/", docker_base_trixie_whls.split(' '), "/python-wheels/") }}

# Install locally-built Python wheel dependencies
{{ install_python_wheels(docker_base_trixie_whls.split(' ')) }}
{% endif %}

# For templating
RUN pip3 install jinjanator

# Add support for supervisord to handle startup dependencies
RUN pip3 install supervisord-dependent-startup==1.4.0

RUN mkdir -p /var/log/supervisor /etc/supervisor/conf.d
{%- if OPTIMIZE_SUPD_S6 == 'y' %}

# --- s6-overlay (OPTIMIZE_SUPD_S6=y): s6 replaces supervisord as the process
# supervisor. The supervisord2s6 shim converts each container's already-rendered
# supervisord.conf into an s6-rc service tree at startup; the supervisorctl shim
# answers `status` from s6 so system-health and monit keep working.
# The real supervisord/supervisorctl are kept as *.real (not overwritten).
{% set s6_version = "3.2.0.2" %}
{% set s6_noarch_sha256 = "6dbcde158a3e78b9bb141d7bcb5ccb421e563523babbe2c64470e76f4fd02dae" %}
{% if CONFIGURED_ARCH == "armhf" %}
{% set s6_arch = "armhf" %}
{% set s6_arch_sha256 = "c8b8532fe4ec432898960e9ec9c903926454ce73588d4c94ad0e023f0b34fe39" %}
{% elif CONFIGURED_ARCH == "arm64" %}
{% set s6_arch = "aarch64" %}
{% set s6_arch_sha256 = "8b22a2eaca4bf0b27a43d36e65c89d2701738f628d1abd0cea5569619f66f785" %}
{% else %}
{% set s6_arch = "x86_64" %}
{% set s6_arch_sha256 = "59289456ab1761e277bd456a95e737c06b03ede99158beb24f12b165a904f478" %}
{% endif %}
{% set s6_base_url = "https://github.com/just-containers/s6-overlay/releases/download/v" + s6_version %}
RUN curl -fsSL {{ s6_base_url }}/s6-overlay-noarch.tar.xz -o /tmp/s6-noarch.tar.xz && \
    curl -fsSL {{ s6_base_url }}/s6-overlay-{{ s6_arch }}.tar.xz -o /tmp/s6-arch.tar.xz && \
    echo "{{ s6_noarch_sha256 }}  /tmp/s6-noarch.tar.xz" | sha256sum -c - && \
    echo "{{ s6_arch_sha256 }}  /tmp/s6-arch.tar.xz" | sha256sum -c - && \
    tar -C / -Jxpf /tmp/s6-noarch.tar.xz && \
    tar -C / -Jxpf /tmp/s6-arch.tar.xz && \
    rm -f /tmp/s6-noarch.tar.xz /tmp/s6-arch.tar.xz
# Keep the real supervisor binaries as *.real, then install the shims in front.
RUN for t in supervisord supervisorctl; do \
        for d in /usr/local/bin /usr/bin; do \
            if [ -e $d/$t ] && [ ! -L $d/$t ]; then mv $d/$t $d/$t.real; fi; \
        done; \
        test -e /usr/local/bin/$t.real -o -e /usr/bin/$t.real; \
    done
COPY ["s6/supervisord2s6.py", "/usr/local/bin/supervisord2s6"]
COPY ["s6/supervisorctl", "/usr/local/bin/supervisorctl"]
RUN chmod 0755 /usr/local/bin/supervisord2s6 /usr/local/bin/supervisorctl && \
    ln -sf /usr/local/bin/supervisord2s6 /usr/local/bin/supervisord && \
    ln -sf /usr/local/bin/supervisord2s6 /usr/bin/supervisord && \
    ln -sf /usr/local/bin/supervisorctl  /usr/bin/supervisorctl
{%- endif %}

# Uninstall unused dependencies
RUN apt autoremove -y --purge

{% if docker_base_trixie_debs.strip() -%}
# Copy locally-built Debian package dependencies
{{ copy_files("debs/", docker_base_trixie_debs.split(' '), "/debs/") }}

# Refresh apt cache so install_debian_packages can resolve dependencies
RUN apt-get update

# Install built Debian packages and implicitly install their dependencies
{{ install_debian_packages(docker_base_trixie_debs.split(' ')) }}

RUN rm -rf /var/lib/apt/lists/*
{%- endif %}

COPY ["etc/rsyslog.conf", "/etc/rsyslog.conf"]
COPY ["etc/rsyslog.d/*", "/etc/rsyslog.d/"]
COPY ["root/.vimrc", "/root/.vimrc"]

RUN ln /usr/bin/vim.tiny /usr/bin/vim

COPY ["etc/supervisor/supervisord.conf", "/etc/supervisor/"]

FROM scratch

COPY --from=base / /
