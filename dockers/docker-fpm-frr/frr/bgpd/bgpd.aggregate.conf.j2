!
! template: bgpd/bgpd.aggregate.conf.j2
!
! Render BGP_AGGREGATE_ADDRESS from CONFIG_DB directly into the bootstrap
! bgpd.conf so the aggregate-address and the contributing/aggregate prefix-list
! entries are present in FRR *before* bgpd forms any session. This closes the
! transient leak window where bgpcfgd's AggregateAddressMgr replays the
! aggregate config AFTER the neighbor managers have already brought sessions up
! (contributing routes would otherwise escape to T2 until the manager runs).
!
! This template performs an early replay of BGP_AGGREGATE_ADDRESS during FRR
! bootstrap, before bgpcfgd replays CONFIG_DB through its managers. It must
! therefore render the same entries that AggregateAddressMgr is expected to
! activate later, using equivalent validation and BBR gating rules:
!   * prefix must parse as a v4/v6 network (else it would poison bgpd.conf parse)
!   * prefix must be strict (no host bits) -- parity with validate_prefix(strict=True)
!   * bbr-required entries require the same effective BBR state as BBRMgr
! Keep this BBR gating in sync if BBRMgr's runtime state resolution changes.
! Entries skipped here are still replayed by AggregateAddressMgr after bgpcfgd
! starts; depending on effective BBR state, they may be activated or recorded
! as inactive.
!
! Idempotency:
!   * bgpcfgd replays CONFIG_DB on startup. Peer managers render their policy,
!     peer-group, and neighbor templates, while AggregateAddressMgr generates
!     aggregate-address and prefix-list commands from BGP_AGGREGATE_ADDRESS.
!     These commands may be appended to the same ConfigMgr commit batch.
!   * For entries rendered here, AggregateAddressMgr later derives the same
!     aggregate/prefix-list state from CONFIG_DB and refreshes the intended FRR
!     state, avoiding dependence on whether peer replay or aggregate replay runs
!     first.
!   * This bootstrap config is loaded by bgpd first. After that, bgpcfgd replays
!     CONFIG_DB, peer managers render their policy templates, and
!     AggregateAddressMgr reconciles aggregate/prefix-list state. If a template
!     rendered by bgpcfgd later contains a hardcoded prefix-list seq that matches
!     a bootstrap-rendered entry, FRR treats it as an update and overwrites the
!     bootstrap entry at that seq.
!   * It is recommended that hardcoded prefix-list seq values do not use 5 or
!     any multiple of 5, because FRR's default prefix-list seq allocation uses
!     that range.
!
! BBR safety gate (STRICT -- keep in sync with BBRMgr):
!   bbr-required=true aggregates must only be rendered when bgpcfgd would also
!   treat BBR as active, otherwise suppressing the contributing routes to T2
!   risks a blackhole. BBRMgr first requires constants.yml to contain at least
!   one BBR peer-group mapping. Then it uses explicit BGP_BBR|all status from
!   CONFIG_DB when present; otherwise it falls back to bgp.bbr.enabled and
!   bgp.bbr.default_state from constants.yml. This template mirrors that logic
!   so bootstrap-rendered aggregates and AggregateAddressMgr replay converge on
!   the same active/inactive state.
!
{% set bbr_ns = namespace(has_bbr_peer_groups=false) %}
{% if constants is defined and constants.bgp is defined and constants.bgp.peers is defined %}
{% for peer_name, peer_cfg in constants.bgp.peers.items() %}
{% if peer_cfg.bbr is defined and peer_cfg.bbr %}
{% set bbr_ns.has_bbr_peer_groups = true %}
{% endif %}
{% endfor %}
{% endif %}
{% set explicit_bbr_status = (BGP_BBR is defined and 'all' in BGP_BBR and 'status' in BGP_BBR['all']) %}
{% set bbr_on_from_config_db = (explicit_bbr_status and BGP_BBR['all']['status'] == 'enabled') %}
{% set bbr_on_from_constants = false %}
{% if not explicit_bbr_status and constants is defined and constants.bgp is defined and constants.bgp.bbr is defined %}
{% if constants.bgp.bbr.enabled is defined and constants.bgp.bbr.enabled and constants.bgp.bbr.default_state is defined and constants.bgp.bbr.default_state == 'enabled' %}
{% set bbr_on_from_constants = true %}
{% endif %}
{% endif %}
{% set bbr_on = (bbr_ns.has_bbr_peer_groups and (bbr_on_from_config_db or bbr_on_from_constants)) %}
{% if BGP_AGGREGATE_ADDRESS is defined and (DEVICE_METADATA is defined) and ('localhost' in DEVICE_METADATA) and ('bgp_asn' in DEVICE_METADATA['localhost']) and (DEVICE_METADATA['localhost']['bgp_asn'].lower() not in ['none', 'null']) %}
{% set bgp_asn = DEVICE_METADATA['localhost']['bgp_asn'] %}
{# Precompute whether any entry qualifies so we never emit empty stanzas. #}
{% set ns = namespace(any=false) %}
{% for prefix, attr in BGP_AGGREGATE_ADDRESS.items() %}
{% if ((prefix | ipv4) or (prefix | ipv6)) and ((prefix.split('/')[0] | lower) == (prefix | ip_network | string | lower)) and (attr.get('bbr-required', 'false') != 'true' or bbr_on) %}
{% set ns.any = true %}
{% endif %}
{% endfor %}
{% if ns.any %}
!
! ---- aggregate / contributing prefix-lists (global scope) ----
{% for prefix, attr in BGP_AGGREGATE_ADDRESS.items() %}
{% if ((prefix | ipv4) or (prefix | ipv6)) and ((prefix.split('/')[0] | lower) == (prefix | ip_network | string | lower)) and (attr.get('bbr-required', 'false') != 'true' or bbr_on) %}
{% set is_v4 = prefix | ipv4 %}
{% set ipcmd = 'ip' if is_v4 else 'ipv6' %}
{% if attr.get('aggregate-address-prefix-list', '') %}
{{ ipcmd }} prefix-list {{ attr['aggregate-address-prefix-list'] }} permit {{ prefix }}
{% endif %}
{% if attr.get('contributing-address-prefix-list', '') %}
{{ ipcmd }} prefix-list {{ attr['contributing-address-prefix-list'] }} permit {{ prefix }} le {{ 32 if is_v4 else 128 }}
{% endif %}
{% endif %}
{% endfor %}
!
! ---- aggregate-address (router bgp scope) ----
router bgp {{ bgp_asn }}
{% for prefix, attr in BGP_AGGREGATE_ADDRESS.items() %}
{% if ((prefix | ipv4) or (prefix | ipv6)) and ((prefix.split('/')[0] | lower) == (prefix | ip_network | string | lower)) and (attr.get('bbr-required', 'false') != 'true' or bbr_on) %}
{% set is_v4 = prefix | ipv4 %}
 address-family {{ 'ipv4' if is_v4 else 'ipv6' }}
  aggregate-address {{ prefix }}{{ ' summary-only' if attr.get('summary-only', 'false') == 'true' else '' }}{{ ' as-set' if attr.get('as-set', 'false') == 'true' else '' }}
 exit-address-family
{% endif %}
{% endfor %}
exit
{% endif %}
{% endif %}
!
! end of template: bgpd/bgpd.aggregate.conf.j2
!
