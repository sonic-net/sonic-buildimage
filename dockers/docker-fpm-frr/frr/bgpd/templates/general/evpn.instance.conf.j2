!
! template: bgpd/templates/general/evpn.instance.conf.j2
!
  neighbor {{ neighbor_addr }} remote-as {{ bgp_session['asn'] }}
  neighbor {{ neighbor_addr }} description {{ bgp_session['name'] }}
  neighbor {{ neighbor_addr }} update-source Loopback0
  neighbor {{ neighbor_addr }} timers 3 9
!
  address-family l2vpn evpn
    neighbor {{ neighbor_addr }} activate
    advertise-all-vni
  exit-address-family
!
! end of template: bgpd/templates/general/evpn.instance.conf.j2
!
