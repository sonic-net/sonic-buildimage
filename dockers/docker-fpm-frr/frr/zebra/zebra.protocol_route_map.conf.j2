{# ============================================================
   Render the PROTOCOL_ROUTE_MAP CONFIG_DB table as zebra's
       ip|ipv6 protocol <PROTO> route-map <NAME>
   wrapped in a 'vrf <N> / ... / exit-vrf' block for non-default VRFs.
   Key format from CONFIG_DB: "<vrf>|<addr_family>|<protocol>".
   Included only by sonic-frr-mgmt-framework/templates/frr/frr.conf.j2;
   bgpcfgd does not render this table. Jinja may present the key as
   either a 'pipe|joined' string or a tuple, so we normalize both.
   Entries are grouped by VRF so each non-default VRF renders as a
   single 'vrf <N> / ... / exit-vrf' block regardless of how many
   filters it carries.
   ============================================================ #}
{# addr_family carries sonic-types:ip-family values ('IPv4'/'IPv6'); same
   mapping convention as bgpd.conf.db.pref_list.j2 and bgpd.conf.db.route_map.j2. #}
{% set ip_str = {'IPv4': 'ip', 'IPv6': 'ipv6'} %}
{% if PROTOCOL_ROUTE_MAP is defined and PROTOCOL_ROUTE_MAP|length > 0 %}

{# If a protocol is bound to a route-map that does not exist, zebra drops all
   routes of that protocol. frrcfgd therefore waits until the route-map has
   an entry in ROUTE_MAP before binding it. In frrcfgd mode, skip those
   bindings here too, so a reboot does the same thing as the running config.
   Other modes render every binding. #}
{% set prm_ns = namespace(configured=none) %}
{% if DEVICE_METADATA is defined and DEVICE_METADATA.localhost is defined and DEVICE_METADATA.localhost.frr_mgmt_framework_config == "true" %}
{%   set prm_ns.configured = [] %}
{%   for rm_key in (ROUTE_MAP if ROUTE_MAP is defined else {}) %}
{%     set _ = prm_ns.configured.append(rm_key.split('|')[0] if rm_key is string else rm_key[0]) %}
{%   endfor %}
{% endif %}
{# Pass 1: bucket valid rows into ns.by_vrf = {vrf: [(ip_kw, proto, rm), ...]} #}
{% set ns = namespace(by_vrf={}) %}
{% for prm_key, prm_val in PROTOCOL_ROUTE_MAP.items() %}
{%   if prm_key is string %}
{%     set parts = prm_key.split('|') %}
{%   elif prm_key is iterable %}
{%     set parts = prm_key %}
{%   else %}
{%     set parts = [] %}
{%   endif %}
{%   if parts|length == 3 and prm_val is mapping and 'route_map' in prm_val %}
{%     set prm_ip_kw = ip_str.get(parts[1]) %}
{%     if prm_ip_kw is not none and (prm_ns.configured is none or prm_val['route_map'] in prm_ns.configured) %}
{%       set _ = ns.by_vrf.setdefault(parts[0], []).append((prm_ip_kw, parts[2], prm_val['route_map'])) %}
{%     endif %}
{%   endif %}
{% endfor %}
{# Pass 2: emit one block per VRF. #}
{% for vrf, entries in ns.by_vrf.items() %}
{%   if vrf == 'default' %}
{%     for ip_kw, proto, rm in entries %}
{{ ip_kw }} protocol {{ proto }} route-map {{ rm }}
{%     endfor %}
!
{%   else %}
vrf {{ vrf }}
{%     for ip_kw, proto, rm in entries %}
 {{ ip_kw }} protocol {{ proto }} route-map {{ rm }}
{%     endfor %}
exit-vrf
!
{%   endif %}
{% endfor %}
{% endif %}
