#}
{% set py3 = API_VERSION == 3 and 'psud' not in python2_daemons %}
{% set command = "/usr/bin/psud-rs --platform-api " ~ (platform_api_psud | default("pyo3"))
   if use_rust_psud and py3
   else ("python3 " if py3 else "python2 ") + "/usr/local/bin/psud" %}
command={{ command }}
priority=8
autostart=false
autorestart=unexpected
stdout_logfile=NONE
stdout_syslog=true
stderr_logfile=NONE
stderr_syslog=true
startsecs=10
dependent_startup=true
dependent_startup_wait_for=rsyslogd:running {% if delay_non_critical_daemon %}delay:exited{% endif %}
{% endif %}

