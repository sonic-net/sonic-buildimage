{% if include_sensormond %}
[program:sensormond]
{#
    Python only.  sensormond was ported to Rust and then taken back out: no
    NVIDIA platform starts it -- `include_sensormond` is set by micas, nexthop
    and pensando and by nobody else -- and the opt-in default means those
    vendors get the Python daemon anyway.  The Rust binary was therefore
    unreachable on every platform in the tree while still shipping in every
    pmon image, so it is not built.
#}
{% set command = "/usr/local/bin/sensormond" %}
command={{ command }}
priority=10
autostart=false
autorestart=unexpected
stdout_logfile=NONE
stdout_syslog=true
stderr_logfile=NONE
stderr_syslog=true
startsecs=10
dependent_startup=true
dependent_startup_wait_for=rsyslogd:running {% if delay_non_critical_daemon %}delay:exited{% endif %}
{% endif %}

