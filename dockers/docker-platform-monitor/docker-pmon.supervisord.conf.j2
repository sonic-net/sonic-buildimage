{% if not skip_thermalctld %}
[program:thermalctld]
{#
    The Python daemon unless the platform asks for the Rust one by setting
    "use_rust_thermalctld": true in its pmon_daemon_control.json -- the same
    file skip_thermalctld comes from, so it needs no rebuild.

    Opt-in, not opt-out, because an absent key has to mean the implementation
    that platform has always run.  The Rust debs are added to this image
    unconditionally (rules/docker-platform-monitor.mk), so under an opt-out
    default every arm64 platform in the tree -- BlueField, the four BMC
    platforms, centec, marvell, micas, fs, pensando -- would silently start
    Rust daemons that have never run on that architecture, and nothing in pmon
    alarms when a daemon is wrong or missing (critical_processes is empty).

    The Rust one takes the same options as the Python one and writes the same
    STATE_DB rows; it reaches the platform through the generated facade in
    sonic-platform-common, which calls whichever sonic_platform the image
    installs, so a vendor opting in changes nothing else.  Python 2 is never
    the Rust path: a platform still on it is one the facade has not been
    exercised against.
#}
{% set use_rust = use_rust_thermalctld %}
{% set base_command = (
    "/usr/bin/thermalctld-rs"
    if use_rust and API_VERSION == 3 and 'thermalctld' not in python2_daemons
    else (
        "python3 /usr/local/bin/thermalctld"
        if API_VERSION == 3 and 'thermalctld' not in python2_daemons
        else "python2 /usr/local/bin/thermalctld"
    )
) %}
{% set options = "" -%}

{% if thermalctld is defined %}
    {% if thermalctld.thermal_monitor_initial_interval is defined and thermalctld.thermal_monitor_initial_interval is not none %}
        {%- set options = options + " --thermal-monitor-initial-interval " + thermalctld.thermal_monitor_initial_interval|string %}
    {% endif -%}

    {% if thermalctld.thermal_monitor_update_interval is defined and thermalctld.thermal_monitor_update_interval is not none %}
        {%- set options = options + " --thermal-monitor-update-interval " + thermalctld.thermal_monitor_update_interval|string %}
    {% endif -%}

    {% if thermalctld.thermal_monitor_update_elapsed_threshold is defined and thermalctld.thermal_monitor_update_elapsed_threshold is not none %}
        {%- set options = options + " --thermal-monitor-update-elapsed-threshold " + thermalctld.thermal_monitor_update_elapsed_threshold|string %}
    {% endif -%}

    {% if thermalctld.enable_liquid_cooling %}
    {%- set options = options + " --enable_liquid_cooling" %}
    {% endif -%}

    {% if thermalctld.liquid_cooling_update_interval %}
    {%- set options = options ~ " --liquid_cooling_update_interval " ~ thermalctld.liquid_cooling_update_interval %}
    {% endif -%}
{% endif -%}

{#
    Only the Rust binary takes this one: the Python thermalctld shares every
    option above but has no platform API to choose, and an unknown argument
    would stop it starting.
#}
{% if use_rust %}
{%- set options = options ~ " --platform-api " ~ (platform_api_thermalctld | default("pyo3")) %}
{% endif -%}

{%- set command = base_command ~ options %}
command={{ command }}
priority=10
autostart=false
autorestart=unexpected
stdout_logfile=NONE
stdout_syslog=true
stderr_logfile=NONE
stderr_syslog=true
startsecs=10
startretries=50
dependent_startup=true
dependent_startup_wait_for=rsyslogd:running {% if delay_non_critical_daemon %}delay:exited{% endif %}
{% endif %}

