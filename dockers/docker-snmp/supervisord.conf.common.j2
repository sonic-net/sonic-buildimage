{# SNMP supervisord programs - shared between docker-snmp and docker-sonic-vs #}
{# Set snmp_priority_base before including to control priority numbering. #}
{# In the monolithic docker-sonic-vs image the shared image startup program is #}
{# named `start.sh`, not `start`, and it runs the image-wide start.sh rather than #}
{# the SNMP one. Set snmp_include_start=true and snmp_start_wait_for to that #}
{# program there. The standalone docker-snmp image keeps the defaults: its #}
{# startup program is `start`, and that program already runs the SNMP start.sh. #}
{% set _pbase = snmp_priority_base | default(3) %}
{% set _use_start_snmp = snmp_include_start is defined and snmp_include_start %}
{% set _start_wait_for = snmp_start_wait_for | default("start:exited") %}
{% if _use_start_snmp %}
{# CONFIG_DB is populated after the image-wide start.sh exits, so wait for the #}
{# SNMP community in a separate program rather than inside start-snmp.sh. This #}
{# keeps waiting idempotent and re-runnable, and mirrors docker-dhcp-server's #}
{# dhcpservd-ready/kea-dhcp4 split. Like that one, the dependency below is on #}
{# :exited, so a timeout is reported loudly but does not wedge startup: the #}
{# render still runs and is fail-closed (no community rendered, snmpd answers #}
{# nothing, and the stock Debian snmpd.conf is replaced). #}
[program:wait-for-snmp-config]
command=/usr/bin/wait_for_snmp_config.sh
priority={{ _pbase - 2 }}
autostart=false
autorestart=false
startsecs=0
stdout_logfile=NONE
stdout_syslog=true
stderr_logfile=NONE
stderr_syslog=true
dependent_startup=true
dependent_startup_wait_for={{ _start_wait_for }}

[program:start-snmp]
command=/usr/bin/start-snmp.sh
priority={{ _pbase - 1 }}
autostart=false
autorestart=false
startsecs=0
stdout_logfile=NONE
stdout_syslog=true
stderr_logfile=NONE
stderr_syslog=true
dependent_startup=true
dependent_startup_wait_for=wait-for-snmp-config:exited
{% endif %}

[program:snmpd]
command=/usr/sbin/snmpd -f -LS0-2d -u Debian-snmp -g Debian-snmp -I -smux,mteTrigger,mteTriggerConf,ifTable,ifXTable,inetCidrRouteTable,ipCidrRouteTable,ip,disk_hw -p /run/snmpd.pid
priority={{ _pbase }}
autostart=false
autorestart=false
stdout_logfile=NONE
stdout_syslog=true
stderr_logfile=NONE
stderr_syslog=true
dependent_startup=true
{% if _use_start_snmp %}
dependent_startup_wait_for=start-snmp:exited
{% else %}
dependent_startup_wait_for=start:exited
{% endif %}

[program:snmp-subagent]
{# DEVICE_METADATA is absent when this fragment is rendered at image build time #}
{# (e.g. docker-sonic-vs renders supervisord.conf.j2 with `sonic-cfggen -a`, no #}
{# CONFIG_DB), so guard the lookup to avoid an UndefinedError there. At container #}
{# runtime DEVICE_METADATA is populated and the chassis-packet branch is honored. #}
{% if DEVICE_METADATA is defined and DEVICE_METADATA.localhost is defined and DEVICE_METADATA.localhost.switch_type is defined and DEVICE_METADATA.localhost.switch_type == 'chassis-packet' %}
command=/usr/bin/env python3 -m sonic_ax_impl --enable_dynamic_frequency
{% else %}
command=/usr/bin/env python3 -m sonic_ax_impl
{% endif %}
priority={{ _pbase + 1 }}
autostart=false
autorestart=false
stdout_logfile=NONE
stdout_syslog=true
stderr_logfile=NONE
stderr_syslog=true
dependent_startup=true
dependent_startup_wait_for=snmpd:running
