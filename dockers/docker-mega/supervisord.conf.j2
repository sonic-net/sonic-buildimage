# --- dhcp_relay: feature preamble ---





{# If our configuration has VLANs... #}
{% if VLAN_INTERFACE %}
{# Count how many VLANs require a DHCP relay agent... #}
{% set ipv4_num_relays = { 'count': 0 } %}
{% set ipv6_num_relays = { 'count': 0 } %}
{% if 'has_sonic_dhcpv4_relay' in DEVICE_METADATA['localhost'] and DEVICE_METADATA['localhost']['has_sonic_dhcpv4_relay'] == 'True' %}
{% set _dummy = ipv4_num_relays.update({'count': ipv4_num_relays.count + 1}) %}
{% endif %}
{% for vlan_name in VLAN_INTERFACE %}
{% if VLAN and vlan_name in VLAN and 'dhcp_servers' in VLAN[vlan_name] and VLAN[vlan_name]['dhcp_servers']|length > 0 %}
{% set _dummy = ipv4_num_relays.update({'count': ipv4_num_relays.count + 1}) %}
{% endif %}
{% if DHCP_RELAY and vlan_name in DHCP_RELAY and DHCP_RELAY[vlan_name]['dhcpv6_servers']|length > 0 %}
{% set _dummy = ipv6_num_relays.update({'count': ipv6_num_relays.count + 1}) %}
{% endif %}
{% endfor %}
{# If one or more of the VLANs require a DHCP relay agent... #}
{% if ipv4_num_relays.count > 0 or ipv6_num_relays.count > 0 %}

{# Create a program entry for each DHCP relay agent instance #}
{% set relay_for_ipv4 = { 'flag': False } %}
{% set relay_for_ipv6 = { 'flag': False } %}
{# Decide the dhcpv4 relay agent based on the feature config #}
{% if 'has_sonic_dhcpv4_relay' in DEVICE_METADATA['localhost'] and DEVICE_METADATA['localhost']['has_sonic_dhcpv4_relay'] == 'True' %}
{% else %}
{% set added_vlan = []%}
{% for (vlan_name, prefix) in VLAN_INTERFACE|pfx_filter %}
    {%- if prefix | ipv4 and vlan_name not in added_vlan %}
        {%- set _ = added_vlan.append(vlan_name) %}
    {%- endif %}
{% endfor %}

{% endif %}
{% endif %}
{% else %}
{% if 'has_sonic_dhcpv4_relay' in DEVICE_METADATA['localhost'] and DEVICE_METADATA['localhost']['has_sonic_dhcpv4_relay'] == 'True' %}
{% endif %}
{% endif %}
[program:dhcprelayd]
command=/usr/local/bin/dhcprelayd
priority=153
autostart=false
autorestart=false
stdout_logfile=NONE
stdout_syslog=true
stderr_logfile=NONE
stderr_syslog=true
dependent_startup=true
dependent_startup_wait_for=start:exited


[group:swss]
programs=orchagent,swssconfig,fabricmgrd,enable_counters,countersyncd

[group:bgp]
programs=mgmtd,zebra,zsocket,staticd,bgpd,fpmsyncd,sharpd

[group:teamd]
programs=teammgrd,teamsyncd,tlm_teamd

[group:lldp]
programs=lldpd,waitfor_lldp_ready,lldp-syncd,lldpmgrd

[group:gnmi]
programs=gnmi-native,dialout

[group:eventd]
programs=eventd,eventdb

[group:mgmt-framework]
programs=rest-server

[group:dhcp_relay]
programs=dhcprelayd
