[supervisord]
logfile_maxbytes=1MB
logfile_backups=2
nodaemon=true

[eventlistener:dependent-startup]
command=python3 /usr/local/bin/depstartup_guard.py
autostart=true
autorestart=unexpected
startretries=0
exitcodes=0,3
events=PROCESS_STATE
buffer_size=1024

[eventlistener:supervisor-proc-exit-listener]
command=/usr/bin/supervisor-proc-exit-listener-rs --container-name mega
events=PROCESS_STATE_EXITED,PROCESS_STATE_RUNNING,PROCESS_COMMUNICATION_STDOUT
autostart=true
autorestart=unexpected
buffer_size=1024

[program:rsyslogd]
command=/usr/sbin/rsyslogd -n -iNONE
priority=1
autostart=false
autorestart=unexpected
stdout_logfile=NONE
stdout_syslog=true
stderr_logfile=NONE
stderr_syslog=true
dependent_startup=true
startsecs=0

[program:start]
command=/bin/bash -c '/opt/sonic/core-services/teamd/start.sh || echo "mega: start.sh for teamd failed (rc=$?)" >&2; /opt/sonic/core-services/lldp/start.sh || echo "mega: start.sh for lldp failed (rc=$?)" >&2; /opt/sonic/core-services/gnmi/start.sh || echo "mega: start.sh for gnmi failed (rc=$?)" >&2; /opt/sonic/core-services/eventd/start.sh || echo "mega: start.sh for eventd failed (rc=$?)" >&2; /opt/sonic/core-services/mgmt-framework/start.sh || echo "mega: start.sh for mgmt-framework failed (rc=$?)" >&2; /opt/sonic/core-services/dhcp_relay/start.sh || echo "mega: start.sh for dhcp_relay failed (rc=$?)" >&2'
priority=50
autostart=true
autorestart=false
startsecs=0
stdout_logfile=NONE
stdout_syslog=true
stderr_logfile=NONE
stderr_syslog=true
dependent_startup=true
dependent_startup_wait_for=sharpd:exited


