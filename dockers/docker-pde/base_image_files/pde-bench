#!/bin/bash

CSV=/tmp/bench.csv

# Make sure only root can run our script
if [ "$(id -u)" != "0" ]; then
    echo "This script must be run as root" 1>&2
    exit 1
fi

# Start PDE if it's deactivated
if [ $(docker ps | grep -c pde) -eq 0 ]; then
    pde.sh start
fi

# Wait for PDE to finish initializing: docker_init.sh installs the platform
# API and then execs supervisord, so PID 1 is supervisord once it is done
for t in $(seq 1 60)
do
    if [ "$(docker exec pde cat /proc/1/comm 2>/dev/null)" = "supervisord" ]; then
        break
    fi
    sleep 1
done
if [ "$(docker exec pde cat /proc/1/comm 2>/dev/null)" != "supervisord" ]; then
    echo "docker-pde is not ready, exiting ..."
    exit 1
fi

# Launch the benchmark test suite
docker exec -it pde /usr/bin/bench.sh
echo "$(docker exec -it pde cat ${CSV})" > ${CSV}

echo ""
echo "CSV Report: ${CSV}"
echo "-----------------------------------------------------------------------"
echo "$(cat ${CSV})"
echo "-----------------------------------------------------------------------"
