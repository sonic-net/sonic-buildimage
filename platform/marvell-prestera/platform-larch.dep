
MPATH     := $($(LN3848G_PLATFORM)_SRC_PATH)
PLATFORM_COMMON_FILES_LIST := $(SONIC_COMMON_FILES_LIST) $(PLATFORM_PATH)/platform-larch.mk $(PLATFORM_PATH)/platform-larch.dep
PLATFORM_COMMON_FILES_LIST += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES := $(PLATFORM_COMMON_FILES_LIST)
DEP_FILES += $(shell git ls-files -- $(MPATH))

$(LN3848G_PLATFORM)_CACHE_MODE := GIT_CONTENT_SHA
$(LN3848G_PLATFORM)_DEP_FLAGS  := $(SONIC_COMMON_FLAGS_LIST)
$(LN3848G_PLATFORM)_DEP_FILES  := $(DEP_FILES)

MPATH     := $($(LARCH_STATIC)_SRC_PATH)
DEP_FILES := $(PLATFORM_COMMON_FILES_LIST)
DEP_FILES += $(shell git ls-files -- $(MPATH))
$(LARCH_STATIC)_CACHE_MODE := GIT_CONTENT_SHA
$(LARCH_STATIC)_DEP_FLAGS  := $(SONIC_COMMON_FLAGS_LIST)
$(LARCH_STATIC)_DEP_FILES  := $(DEP_FILES)
