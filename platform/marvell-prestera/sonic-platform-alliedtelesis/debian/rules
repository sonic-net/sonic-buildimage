#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1

include /usr/share/dpkg/pkg-info.mk
#--------------------------------------------------------
export INSTALL_MOD_DIR := extra

export KVERSION   ?= $(shell uname -r)
export KERNEL_SRC ?= /lib/modules/$(KVERSION)
KERNEL_BUILD := $(KERNEL_SRC)/build
PACKAGE_PRE_NAME := sonic-platform-alliedtelesis
INSTALL_MOD_DIR := kernel/extra/
MOD_SRC_DIR:= $(shell pwd)
UTILS_DIR := utils
MRVL_MODULE_DIR:= mrvl-modules
PRESTERA_MODULE_PREFIX := mrvl-prestera/drivers/generic/
PRESTERA_MODULE_SRC := cpssEnabler/linuxNoKernelModule/drivers/
SERVICE_DIR := service
UDEV_DIR := udev
MODPROBE_DIR := modprobe
COMMON_DIR := common

MODULE_DIRS :=
# Common
MODULE_DIRS += common
# SKU with kernel modules
MODULE_DIRS += x980-32cq

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_clean:
	(set -e; for mod in $(MODULE_DIRS); do \
		if [ -d "$(KERNEL_BUILD)" ] && [ -f "$(MOD_SRC_DIR)/$${mod}/modules/Makefile" ]; then \
			make -C $(KERNEL_BUILD) M=$(MOD_SRC_DIR)/$${mod}/modules clean; \
		fi; \
		cd $(MOD_SRC_DIR)/$${mod}; \
		rm -rf $(MRVL_MODULE_DIR)/; \
		rm -f *.whl; \
		cd $(MOD_SRC_DIR)/; \
	done)
	rm -rf *.egg-info/;
	dh_clean

override_dh_auto_configure:
	# No configure step needed — build/install handled by custom overrides below

override_dh_auto_build:
	set -e
	if [ ! -d "$(KERNEL_BUILD)" ]; then \
		echo "ERROR: Kernel build directory $(KERNEL_BUILD) not found. Cannot build kernel modules."; \
		exit 1; \
	fi
	(set -e; for mod in $(MODULE_DIRS); do \
		if [ $$mod = "common" ]; then \
			mkdir -p $(MOD_SRC_DIR)/$${mod}/$(MRVL_MODULE_DIR); \
			cp -r $(MOD_SRC_DIR)/../$(PRESTERA_MODULE_PREFIX)/* $(MOD_SRC_DIR)/$${mod}/$(MRVL_MODULE_DIR)/; \
			cd $(MOD_SRC_DIR)/$${mod}/$(MRVL_MODULE_DIR)/$(PRESTERA_MODULE_SRC); \
			make clean; \
			make modules -C $(KERNEL_SRC)/build M=`pwd` CONFIG_KM_MVPCI=y CONFIG_KM_MVINT=y CONFIG_KM_MVDMA2=y CONFIG_KM_MVETH=y || exit 1; \
		fi; \
	done)
	python3 sonic_platform_setup.py bdist_wheel -d $(MOD_SRC_DIR)/$(COMMON_DIR)
	echo "Finished making sonic_platform whl package"

override_dh_auto_test:
	# No tests to run

override_dh_usrlocal:
	# debian/sonic-platform-<>-<>/usr/local/bin/* are already done

override_dh_auto_install:
	(set -e; for mod in $(MODULE_DIRS); do \
		pkg=$$mod; \
		dh_installdirs -psonic-platform-alliedtelesis-$${pkg} /$(KERNEL_SRC)/$(INSTALL_MOD_DIR); \
		dh_installdirs -psonic-platform-alliedtelesis-$${pkg} /usr/local/bin; \
		dh_installdirs -p$(PACKAGE_PRE_NAME)-$${mod} /lib/systemd/system; \
		dh_installdirs -p$(PACKAGE_PRE_NAME)-$${mod} /etc/modprobe.d; \
		dh_installdirs -p$(PACKAGE_PRE_NAME)-$${mod} /etc/udev/rules.d; \
		if [ -d $(MOD_SRC_DIR)/$${mod}/$(UTILS_DIR) ]; then \
			cp $(MOD_SRC_DIR)/$${mod}/$(UTILS_DIR)/* debian/sonic-platform-alliedtelesis-$${pkg}/usr/local/bin/; \
		fi; \
		if [ -d $(MOD_SRC_DIR)/$${mod}/$(SERVICE_DIR) ]; then \
			cp $(MOD_SRC_DIR)/$${mod}/$(SERVICE_DIR)/*.service debian/$(PACKAGE_PRE_NAME)-$${pkg}/lib/systemd/system/; \
		fi; \
		if [ -d $(MOD_SRC_DIR)/$${mod}/$(UDEV_DIR) ]; then \
			cp $(MOD_SRC_DIR)/$${mod}/$(UDEV_DIR)/* debian/$(PACKAGE_PRE_NAME)-$${pkg}/etc/udev/rules.d/; \
		fi; \
		if [ -d $(MOD_SRC_DIR)/$${mod}/$(MODPROBE_DIR) ]; then \
			cp $(MOD_SRC_DIR)/$${mod}/$(MODPROBE_DIR)/* debian/$(PACKAGE_PRE_NAME)-$${pkg}/etc/modprobe.d/; \
		fi; \
		if [ $$mod = "common" ]; then \
			cp $(MOD_SRC_DIR)/$${mod}/$(MRVL_MODULE_DIR)/$(PRESTERA_MODULE_SRC)/mvcpss.ko debian/sonic-platform-alliedtelesis-$${pkg}/$(KERNEL_SRC)/$(INSTALL_MOD_DIR); \
			cp $(MOD_SRC_DIR)/$${mod}/$(MRVL_MODULE_DIR)/$(PRESTERA_MODULE_SRC)/mvSai.ko debian/sonic-platform-alliedtelesis-$${pkg}/$(KERNEL_SRC)/$(INSTALL_MOD_DIR); \
			cd $(MOD_SRC_DIR); \
		else \
			if [ -f $(MOD_SRC_DIR)/$${mod}/modules/Makefile ]; then \
				make modules -C $(KERNEL_SRC)/build M=$(MOD_SRC_DIR)/$${pkg}/modules || exit 1; \
				cp $(MOD_SRC_DIR)/$${mod}/modules/*.ko debian/$(PACKAGE_PRE_NAME)-$${pkg}/$(KERNEL_SRC)/$(INSTALL_MOD_DIR); \
			fi; \
		fi; \
	done)
	python3 sonic_platform_setup.py install \
		--root=$(MOD_SRC_DIR)/debian/$(PACKAGE_PRE_NAME)-common \
		--install-layout=deb
