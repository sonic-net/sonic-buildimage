[Unit]
Description=Platform ln4332z1-l Service
After=sysinit.target
Before=pmon.target

[Service]
# The script does its work and exits. Without these, systemd marks the unit
# dead as soon as it finishes and sysmonitor reports the whole system as not
# ready.
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/ln4332z1-l-init.sh
StandardOutput=tty

[Install]
WantedBy=multi-user.target
