#!/bin/sh
# postinst script for sonic-platform-ln3848g
#
# see: dh_installdeb(1)

chmod a+x /usr/local/bin/ln3848g-init.sh
depmod -a
systemctl restart kmod
systemctl enable ln3848g-init.service
systemctl start ln3848g-init.service
systemctl enable pddf-platform-init.service
systemctl start pddf-platform-init.service
exit 0
