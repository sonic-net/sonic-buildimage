#!/bin/sh
# postinst script for sonic-platform-ln3548xgf-6z-v5
#
# see: dh_installdeb(1)

chmod a+x /usr/local/bin/ln3548xgf-6z-v1-init.sh
chmod a+x /usr/local/bin/reset_button_handler.py
chmod a+x /usr/local/bin/locator-led
depmod -a
systemctl restart kmod
systemctl enable ln3548xgf-6z-v1-init.service
systemctl start ln3548xgf-6z-v1-init.service
systemctl enable --now reset_button.service
exit 0
