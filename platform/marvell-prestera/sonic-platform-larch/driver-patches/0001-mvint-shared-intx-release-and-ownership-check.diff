+/*
+ * Legacy INTx lines are shared with other devices (i801_smbus, mmc, ...).
+ * Find the Marvell PCI device (bound to mvpci) that raises this line, so
+ * the ISR can tell whether the interrupt is ours. Returns it with a reference.
+ */
+static struct pci_dev *find_intx_pdev(unsigned int irq)
+{
+	struct pci_dev *pdev = NULL;
+
+	if (msi_used)
+		return NULL;
+	while ((pdev = pci_get_device(PCI_VENDOR_ID_MARVELL, PCI_ANY_ID, pdev))) {
+		if (pdev->irq == irq && !pci_dev_msi_enabled(pdev) &&
+		    pdev->driver && !strcmp(pdev->driver->name, "mvpci"))
+			return pdev;
+	}
+	return NULL;
+}
