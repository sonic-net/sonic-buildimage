[Unit]
Description=Platform cn9131-ext-98cx Service
After=sysinit.target
Before=pmon.target

[Service]
# The script does its work and exits. Without these, systemd marks the unit
# dead as soon as it finishes and sysmonitor reports the whole system as not
# ready.
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/cn9131-ext-98cx-init.sh
StandardOutput=tty

[Install]
WantedBy=multi-user.target
