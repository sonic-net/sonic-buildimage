[Unit]
Description=Platform ln3848g Service
After=sysinit.target pddf-platform-init.service
Before=pmon.service

[Service]
# The script does its work and exits. Without these, systemd marks the unit
# dead as soon as it finishes and sysmonitor reports the whole system as not
# ready.
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/ln3848g-init.sh
StandardOutput=tty

[Install]
WantedBy=multi-user.target
