$(eval $(call add_extra_package,$(LN3848G_PLATFORM),$(CN9131-EXT-98CX_PLATFORM)))

CN9130-EPS6800_PLATFORM = sonic-platform-cn9130-eps6800_$(CN9130-EPS6800_PLATFORM_MODULE_VERSION)_$(CONFIGURED_ARCH).deb
$(CN9130-EPS6800_PLATFORM)_PLATFORM = arm64-larch_cn9130-eps6800-r0
$(eval $(call add_extra_package,$(LN3848G_PLATFORM),$(CN9130-EPS6800_PLATFORM)))

LN4332Z1-L_PLATFORM = sonic-platform-ln4332z1-l_$(LN4332Z1-L_PLATFORM_MODULE_VERSION)_$(CONFIGURED_ARCH).deb
$(LN4332Z1-L_PLATFORM)_PLATFORM = arm64-larch_ln4332z1-l
