CN9130-DM8218F_PLATFORM = sonic-platform-cn9130-dm8218f_$(CN9130-DM8218F_PLATFORM_MODULE_VERSION)_$(CONFIGURED_ARCH).deb
$(CN9130-DM8218F_PLATFORM)_PLATFORM = arm64-larch_cn9130-dm8218f
$(eval $(call add_extra_package,$(LN3848G_PLATFORM),$(CN9130-DM8218F_PLATFORM)))

