# Larch Networks platforms (Marvell Prestera, arm64)

export LN3848G_PLATFORM_MODULE_VERSION = 1.0
export LN3824G_PLATFORM_MODULE_VERSION = 1.0
export CANISMINOR_PLATFORM_MODULE_VERSION = 1.0
export CN9131-EXT-98CX_PLATFORM_MODULE_VERSION = 1.0
export CN9130-EPS6800_PLATFORM_MODULE_VERSION = 1.0
export LN4332Z1-L_PLATFORM_MODULE_VERSION = 1.0
export LN4332Z-V1_PLATFORM_MODULE_VERSION = 1.0
export LN4348Y-8Z-V1_PLATFORM_MODULE_VERSION = 1.0
export CN9130-DM8218F_PLATFORM_MODULE_VERSION = 1.0
export LN3612Y2ZT_PLATFORM_MODULE_VERSION = 1.0
export LN3604G_PLATFORM_MODULE_VERSION = 1.0
export LN3804GF-4XGF_PLATFORM_MODULE_VERSION = 1.0
export LN3804GF-8XGF_PLATFORM_MODULE_VERSION = 1.0
export LN3516XGF-4Z_PLATFORM_MODULE_VERSION = 1.0
