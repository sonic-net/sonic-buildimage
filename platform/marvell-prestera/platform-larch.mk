ifeq ($(CONFIGURED_ARCH),arm64)
LN3848G_PLATFORM = sonic-platform-ln3848g_$(LN3848G_PLATFORM_MODULE_VERSION)_$(CONFIGURED_ARCH).deb
$(LN3848G_PLATFORM)_DEPENDS += $(LINUX_HEADERS) $(LINUX_HEADERS_COMMON) $(PDDF_PLATFORM_MODULE)
$(LN3848G_PLATFORM)_SRC_PATH = $(PLATFORM_PATH)/sonic-platform-larch
$(LN3848G_PLATFORM)_PLATFORM = arm64-larch_ln3848g
SONIC_DPKG_DEBS += $(LN3848G_PLATFORM)

LN3824G_PLATFORM = sonic-platform-ln3824g_$(LN3824G_PLATFORM_MODULE_VERSION)_$(CONFIGURED_ARCH).deb
$(LN3824G_PLATFORM)_PLATFORM = arm64-larch_ln3824g
$(eval $(call add_extra_package,$(LN3848G_PLATFORM),$(LN3824G_PLATFORM)))

CANISMINOR_PLATFORM = sonic-platform-canisminor_$(CANISMINOR_PLATFORM_MODULE_VERSION)_$(CONFIGURED_ARCH).deb
$(CANISMINOR_PLATFORM)_PLATFORM = arm64-larch_canisminor
$(eval $(call add_extra_package,$(LN3848G_PLATFORM),$(CANISMINOR_PLATFORM)))

CN9131-EXT-98CX_PLATFORM = sonic-platform-cn9131-ext-98cx_$(CN9131-EXT-98CX_PLATFORM_MODULE_VERSION)_$(CONFIGURED_ARCH).deb
