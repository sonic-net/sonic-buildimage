    /* From Uboot env fit_conf_name=#conf_cn9131 */
    configurations {
        default = "conf_ac5x";
        conf_ac5x {
            description = "Boot Linux kernel with FDT blob + ramdisk for RD_AC5x";
            kernel = "kernel_ac5x";
            ramdisk = "ramdisk_ac5x";
            fdt = "fdt_ac5x";
            hash@1 {
                algo = "sha1";
            };
        };
        conf_7215_a1 {
