/dts-v1/;
  
/ {
    description = "U-Boot fitImage for SONIC Marvell Arm64";
    #address-cells = <1>;
  
    images {
        kernel_ac5x {
            description = "Linux Kernel for AC5x";
            data = /incbin/("/boot/vmlinuz-6.12.41+deb13-sonic-arm64");
            type = "kernel";
            arch = "arm64";
            os = "linux";
            compression = "none";
            load = <0x2 0x2080000>;
            entry = <0x2 0x2080000>;
            hash@1 {
                algo = "sha1";
            };
        };
        kernel_cn9131 {
            description = "Linux Kernel - cn9131";
            data = /incbin/("/boot/vmlinuz-6.12.41+deb13-sonic-arm64");
            type = "kernel";
            arch = "arm64";
            os = "linux";
            compression = "none";
            load = <0x1000000>;
            entry = <0x1000000>;
            hash@1 {
                algo = "sha1";
            };
        };
        kernel_7215_a1 {
            description = "Linux Kernel - 7215_a1/Nokia";
            data = /incbin/("/boot/vmlinuz-6.12.41+deb13-sonic-arm64");
            type = "kernel";
            arch = "arm64";
            os = "linux";
            compression = "none";
            load = <0x12000000>;
            entry = <0x12000000>;
            hash@1 {
                algo = "sha1";
            };
        };

        ramdisk_ac5x {
            description = "ramdisk for AC5x";
            data = /incbin/("/boot/initrd.img-6.12.41+deb13-sonic-arm64");
            type = "ramdisk";
            arch = "arm64";
            os = "linux";
            compression = "none";
            load = <0x2 0x6000000>;
            entry = <0x2 0x6000000>;
            hash@1 {
                algo = "sha1";
            };
        };
        ramdisk_cn9131 {
            description = "ramdisk - cn9131";
            data = /incbin/("/boot/initrd.img-6.12.41+deb13-sonic-arm64");
            type = "ramdisk";
            arch = "arm64";
            os = "linux";
            compression = "none";
            load = <0x6000000>;
            entry = <0x6000000>;
            hash@1 {
                algo = "sha1";
            };
        };
        ramdisk_7215_a1 {
            description = "ramdisk - 7215_a1/Nokia";
            data = /incbin/("/boot/initrd.img-6.12.41+deb13-sonic-arm64");
            type = "ramdisk";
            arch = "arm64";
            os = "linux";
            compression = "none";
            load = <0x18000000>;
            entry = <0x18000000>;
            hash@1 {
                algo = "sha1";
            };
        };

        /* Take care to sync sync with platform_arm64.conf */
        fdt_ac5x {
            description = "Flattened Device Tree blob for AC5x";
            data = /incbin/("/usr/lib/linux-image-6.12.41+deb13-sonic-arm64/marvell/ac5-98dx35xx-rd.dtb");
            type = "flat_dt";
            arch = "arm64";
            compression = "none";
            load = <0x2 0x1000000>;
            hash@1 {
                algo = "sha1";
            };
        };
        fdt_7215_a1 {
            description = "Flattened Device Tree blob for 7215_IXS_A1";
            data = /incbin/("/usr/lib/linux-image-6.12.41+deb13-sonic-arm64/marvell/7215-ixs-a1.dtb");
            type = "flat_dt";
            arch = "arm64";
            compression = "none";
            load = <0x11000000>;
            hash@1 {
                algo = "sha1";
            };
        };
        fdt_cn9131 {
            description = "Flattened Device Tree blob for cn9131";
            data = /incbin/("/usr/lib/linux-image-6.12.41+deb13-sonic-arm64/marvell/cn9131-db-comexpress.dtb");
            type = "flat_dt";
            arch = "arm64";
            compression = "none";
            load = <0x0a00000>;
            entry = <0x0a00000>;
            hash@1 {
                algo = "sha1";
            };
        };

        /* Larch Networks boards, see platform_arm64.conf */
        kernel_larch_ac5x {
            description = "Linux Kernel for AC5x";
            data = /incbin/("/boot/vmlinuz-6.12.41+deb13-sonic-arm64");
            type = "kernel";
            arch = "arm64";
            os = "linux";
            compression = "none";
            load = <0x2 0x2000000>;
            entry = <0x2 0x2000000>; 
            hash@1 {
                algo = "sha1";
            };
        };
        kernel_larch_octeon {
            description = "Linux Kernel for Octeon proccesors";
            data = /incbin/("/boot/vmlinuz-6.12.41+deb13-sonic-arm64");
            type = "kernel";
            arch = "arm64";
            os = "linux";
            compression = "none";
            load = <0x5500000>;
            entry = <0x5500000>;
            hash@1 {
                algo = "sha1";
            };
        };
