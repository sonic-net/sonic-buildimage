DPATH       := $($(DOCKER_SYNCD_CENTEC_RPC)_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) $(PLATFORM_PATH)/docker-syncd-centec-rpc.mk $(PLATFORM_PATH)/docker-syncd-centec-rpc.dep
DEP_FILES   += dockers/dockerfile-macros.j2
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(DPATH))

$(DOCKER_SYNCD_CENTEC_RPC)_CACHE_MODE := GIT_CONTENT_SHA
$(DOCKER_SYNCD_CENTEC_RPC)_DEP_FLAGS  := $(SONIC_COMMON_FLAGS_LIST) $(INSTALL_DEBUG_TOOLS) $(ENABLE_SYNCD_RPC)
$(DOCKER_SYNCD_CENTEC_RPC)_DEP_FILES  := $(DEP_FILES)
