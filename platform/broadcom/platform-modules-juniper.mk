# Juniper Platform modules
#
# Phase 1 covers the QFX5241 only.

JUNIPER_PLATFORM_MODULE_VERSION = 1.0
JUNIPER_QFX5241_PLATFORM_MODULE_VERSION = 1.0

export JUNIPER_PLATFORM_MODULE_VERSION
export JUNIPER_QFX5241_PLATFORM_MODULE_VERSION

JUNIPER_COMMON_MODULE = sonic-platform-juniper-common_$(JUNIPER_PLATFORM_MODULE_VERSION)_amd64.deb
$(JUNIPER_COMMON_MODULE)_SRC_PATH = $(PLATFORM_PATH)/sonic-platform-modules-juniper
$(JUNIPER_COMMON_MODULE)_DEPENDS += $(LINUX_HEADERS) $(LINUX_HEADERS_COMMON)
$(JUNIPER_COMMON_MODULE)_PLATFORM = x86_64-juniper_common
SONIC_DPKG_DEBS += $(JUNIPER_COMMON_MODULE)

JUNIPER_QFX5241_PLATFORM_MODULE = sonic-platform-juniper-qfx5241_$(JUNIPER_QFX5241_PLATFORM_MODULE_VERSION)_amd64.deb
$(JUNIPER_QFX5241_PLATFORM_MODULE)_PLATFORM = x86_64-juniper_qfx5241-r0
$(eval $(call add_extra_package,$(JUNIPER_COMMON_MODULE),$(JUNIPER_QFX5241_PLATFORM_MODULE)))
