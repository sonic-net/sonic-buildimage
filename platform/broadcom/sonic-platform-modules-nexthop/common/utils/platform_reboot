#!/bin/bash
#
# Platform reboot script for Nexthop platforms,
# usually called by the SONiC reboot script.

VMCORE_FILE="/proc/vmcore"
REBOOT_CAUSE_FILE="/host/reboot-cause/reboot-cause.txt"
# Panic message from the FPGA watchdog MSI kernel handler.
WATCHDOG_PANIC_SIGNATURE="[watchdog_msi_handler] watchdog expired."
# Panic message from the CPU watchdog pretimeout panic governor (systemd
# RuntimeWatchdogPreGovernor=panic; kernel pretimeout_panic governor calls
# panic("watchdog pretimeout event")).
CPU_WATCHDOG_PRETIMEOUT_SIGNATURE="Kernel panic - not syncing: watchdog pretimeout event"

in_capture_kernel() {
    [ -e "$VMCORE_FILE" ] && [ -s "$VMCORE_FILE" ]
}

log_console() {
    echo "$@" | tee /dev/console 2>/dev/null || echo "$@"
}

# No-op if we are not in the "capture kernel"; the normal reboot path defers the
# power cycle to systemd shutdown (nh_powercycle).
if ! in_capture_kernel; then
    echo "Nexthop platform_reboot: skipping and deferring to systemd shutdown for power cycle ..."
    exit 0
fi

# Extract the crashed kernel's dmesg fresh from the current vmcore. Do NOT reuse a
# pre-existing /tmp/dmesg (the SONiC reboot script writes one, but it can be stale
# from an earlier capture-kernel run) or the panic-type detection below misfires.
PANIC_DMESG="/tmp/nh_platform_reboot_dmesg"
rm -f "$PANIC_DMESG"
makedumpfile --dump-dmesg "$VMCORE_FILE" "$PANIC_DMESG" 2>/dev/null

# Clear the generic "Kernel Panic" cause written by the SONiC reboot script and
# power cycle via the watchdog counter so the DPM records the FPGA watchdog
# signature as the reboot cause.
if grep -qF "$WATCHDOG_PANIC_SIGNATURE" "$PANIC_DMESG" 2>/dev/null; then
    log_console "Nexthop platform_reboot: watchdog-induced panic detected, power cycling via the FPGA watchdog ..."
    echo "Unknown" > "$REBOOT_CAUSE_FILE"
    sync
    nh_powercycle --via-watchdog || /sbin/reboot
    exit 0
fi

# A CPU watchdog pretimeout panic (systemd RuntimeWatchdogPreGovernor=panic) is a
# CPU-level hang that kdump has already captured. Recover with a normal reboot and
# do NOT power cycle
# We are exec'd by the SONiC reboot script, so we must reboot here; sysrq 'b' is
# the hard-reset fallback if /sbin/reboot does not take effect.
if grep -qF "$CPU_WATCHDOG_PRETIMEOUT_SIGNATURE" "$PANIC_DMESG" 2>/dev/null; then
    log_console "Nexthop platform_reboot: CPU watchdog pretimeout panic detected, rebooting without FPGA power cycle ..."
    /sbin/reboot
    echo b > /proc/sysrq-trigger
    exit 0
fi

# Any other kernel panic: we are in the kdump capture kernel, a different kernel
# from the normal one, so systemd shutdown will not run - power cycle here.
# nh_powercycle is reachable because kdump-tools config adds /usr/local/bin to PATH.
nh_powercycle || /sbin/reboot
