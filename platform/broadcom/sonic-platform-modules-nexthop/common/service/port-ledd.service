[Unit]
Description=Port Led Service
Requires=pddf-platform-init.service
After=swss.service pddf-platform-init.service
# PartOf follows swss stop/restart without pulling swss in, so port-ledd starts never consume swss's StartLimitBurst budget
PartOf=swss.service

[Service]
ExecStart=/usr/local/bin/port_ledd.py
Restart=on-failure
RestartSec=10s
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
WantedBy=swss.service
