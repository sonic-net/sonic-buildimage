# docker image for docker-ptf-grandtrans

DOCKER_PTF_GRANDTRANS = docker-ptf-grandtrans.gz
$(DOCKER_PTF_GRANDTRANS)_PATH = $(DOCKERS_PATH)/docker-ptf
$(DOCKER_PTF_GRANDTRANS)_DEPENDS += $(LIBTHRIFT) $(PYTHON_THRIFT) $(PTF) $(PYTHON_SAITHRIFT)
$(DOCKER_PTF_GRANDTRANS)_LOAD_DOCKERS += $(DOCKER_BASE_BUSTER)
SONIC_DOCKER_IMAGES += $(DOCKER_PTF_GRANDTRANS)
