
SPATH       := $($(GRANDTRANS_SAI)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST)  platform/grandtrans/sai.mk platform/grandtrans/sai.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
SMDEP_PATHS := $(SPATH)
$(foreach path, $(SMDEP_PATHS), $(eval $(path) :=$(filter-out $(SMDEP_PATHS),$(addprefix $(path)/, $(shell cd $(path) &&  git ls-files | grep -Ev " " )))))

$(GRANDTRANS_SAI)_CACHE_MODE  := GIT_CONTENT_SHA
$(GRANDTRANS_SAI)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(GRANDTRANS_SAI)_DEP_FILES   := $(DEP_FILES)
$(GRANDTRANS_SAI)_SMDEP_FILES := $(foreach path, $(SMDEP_PATHS), $($(path)))
$(GRANDTRANS_SAI)_SMDEP_PATHS := $(SMDEP_PATHS)

