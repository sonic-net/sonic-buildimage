DPATH       := $($(DOCKER_SONIC_P4)_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) platform/p4/docker-sonic-p4.mk platform/p4/docker-sonic-p4.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(DPATH))

$(DOCKER_SONIC_P4)_CACHE_MODE := GIT_CONTENT_SHA
$(DOCKER_SONIC_P4)_DEP_FLAGS  := $(SONIC_COMMON_FLAGS_LIST)
$(DOCKER_SONIC_P4)_DEP_FILES  := $(DEP_FILES)
