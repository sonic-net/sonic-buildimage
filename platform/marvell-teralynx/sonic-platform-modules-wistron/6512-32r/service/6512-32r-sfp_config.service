[Unit]
Description=Wistron 6512-32R SFP Config apply service
After=pmon.service platform-modules-6512-32r.service
DefaultDependencies=no

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/sfp_config_apply.py
Restart=always
RestartSec=5
KillSignal=SIGKILL
SuccessExitStatus=SIGKILL
#StandardOutput=tty

[Install]
WantedBy=multi-user.target
