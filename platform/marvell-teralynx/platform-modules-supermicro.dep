SPATH_SMCI := $($(SMCI_SSE_T7132S_PLATFORM_MODULE)_SRC_PATH)
DEP_FILES := $(SONIC_COMMON_FILES_LIST) $(PLATFORM_PATH)/platform-modules-supermicro.mk $(PLATFORM_PATH)/platform-modules-supermicro.dep
DEP_FILES += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES += $(shell git ls-files -- $(SPATH_SMCI))

$(SMCI_SSE_T7132S_PLATFORM_MODULE)_CACHE_MODE := GIT_CONTENT_SHA
$(SMCI_SSE_T7132S_PLATFORM_MODULE)_DEP_FLAGS := $(SONIC_COMMON_FLAGS_LIST)
$(SMCI_SSE_T7132S_PLATFORM_MODULE)_DEP_FILES := $(DEP_FILES)
