# Centec SAI
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) $(PLATFORM_PATH)/sai.mk $(PLATFORM_PATH)/sai.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)

$(CENTEC_SAI)_CACHE_MODE     := GIT_CONTENT_SHA
$(CENTEC_SAI)_DEP_FLAGS      := $(SONIC_COMMON_FLAGS_LIST)
$(CENTEC_SAI)_DEP_FILES      := $(DEP_FILES)

$(CENTEC_SAI_DEV)_CACHE_MODE := GIT_CONTENT_SHA
$(CENTEC_SAI_DEV)_DEP_FLAGS  := $(SONIC_COMMON_FLAGS_LIST)
$(CENTEC_SAI_DEV)_DEP_FILES  := $(DEP_FILES)
