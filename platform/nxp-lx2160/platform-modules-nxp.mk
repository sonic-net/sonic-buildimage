# NXP LX2160ARDB platform package (udev naming of the DPAA2 interfaces)

NXP_LX2160ARDB_PLATFORM_MODULE_VERSION = 1.0
export NXP_LX2160ARDB_PLATFORM_MODULE_VERSION

NXP_LX2160ARDB_PLATFORM_MODULE = sonic-platform-nxp-lx2160ardb_$(NXP_LX2160ARDB_PLATFORM_MODULE_VERSION)_$(CONFIGURED_ARCH).deb
$(NXP_LX2160ARDB_PLATFORM_MODULE)_SRC_PATH = $(PLATFORM_PATH)/sonic-platform-nxp
$(NXP_LX2160ARDB_PLATFORM_MODULE)_DEPENDS =
$(NXP_LX2160ARDB_PLATFORM_MODULE)_PLATFORM = arm64-nxp_lx2160ardb-r0
SONIC_DPKG_DEBS += $(NXP_LX2160ARDB_PLATFORM_MODULE)
