{% set prefix = DEFAULT_CONTAINER_REGISTRY %}
ARG BASE={{ prefix }}p4lang/behavioral-model:latest
## ARG BASE=docker-config-engine-bullseye-{{DOCKER_USERNAME}}:{{DOCKER_USERTAG}}

FROM $BASE AS base

## Make apt-get non-interactive
ENV DEBIAN_FRONTEND=noninteractive

## Update apt source list to ubuntu Azure mirror
RUN sed -i 's|http://.*.ubuntu.com|http://azure.archive.ubuntu.com|g' /etc/apt/sources.list

RUN apt-get update

RUN apt-get install -f -y net-tools rsyslog
RUN apt-get install -y --only-upgrade curl libcurl4t64 libcurl3t64-gnutls
RUN /usr/local/sbin/pip3 install --break-system-packages --no-cache-dir \
    setuptools \
    supervisor \
    supervisord-dependent-startup \
    googleapis-common-protos \
    protobuf \
    thrift \
    && pip3 check \
    && pip3 uninstall -y pip \
    && rm -rf /root/.cache/uv
RUN rm -rf /var/lib/apt/lists/*

COPY ["start.sh", "/usr/bin/"]

## COPY ["supervisord.conf", "/etc/supervisor/conf.d/"]
## COPY ["critical_processes", "/etc/supervisor/"]

FROM base AS p4-bindings

RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler
COPY ["regenerate_p4_bindings.py", "/tmp/"]
RUN PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python python3 /tmp/regenerate_p4_bindings.py

FROM base AS runtime
COPY --from=p4-bindings /p4-bindings/ /
RUN python3 -c "from p4.v1 import p4runtime_pb2; from p4.config.v1 import p4info_pb2"

FROM scratch

ENV PATH=/root/p4-python-venv/bin:$PATH

# RUN --mount=type=bind,from=base,target=/changes-to-image rsync -axAX --no-D --exclude=/sys --exclude=/proc --exclude=/dev --exclude=resolv.conf /changes-to-image/ /
COPY --from=runtime / /

## ENTRYPOINT ["/usr/bin/supervisord"]
ENTRYPOINT ["/usr/bin/start.sh"]
