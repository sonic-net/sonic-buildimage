PLATFORM_SRC_PATH ?= $(if $(wildcard $(PLATFORM_PATH)/src/rules.mk),$(PLATFORM_PATH)/src,$(PLATFORM_PATH)/embedded)

include $(PLATFORM_SRC_PATH)/rules.dep
include $(PLATFORM_PATH)/docker-platform-monitor.dep
include $(PLATFORM_PATH)/docker-syncd.dep
include $(PLATFORM_PATH)/docker-syncd-cisco.dep
include $(PLATFORM_PATH)/docker-syncd-cisco-rpc.dep
include $(PLATFORM_PATH)/docker-gbsyncd-cisco.dep
