DEP_FILES := $(SONIC_COMMON_FILES_LIST) $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES += $(PLATFORM_SRC_PATH)/python-wheels.mk
DEP_FILES += $(PLATFORM_SRC_PATH)/python-wheels.dep $(PLATFORM_SRC_PATH)/setup.py
DEP_FILES += $(DEBS_PATH)/$(CISCO_8000_PLATFORM_MODULE)

$(CISCO_EMBEDDED_PLATFORM_WHEEL)_CACHE_MODE := GIT_CONTENT_SHA
$(CISCO_EMBEDDED_PLATFORM_WHEEL)_DEP_FLAGS := $(SONIC_COMMON_FLAGS_LIST)
$(CISCO_EMBEDDED_PLATFORM_WHEEL)_DEP_FLAGS += $(CISCO_EMBEDDED_PLATFORM_MODULE_DEB)
$(CISCO_EMBEDDED_PLATFORM_WHEEL)_DEP_FILES := $(DEP_FILES)
