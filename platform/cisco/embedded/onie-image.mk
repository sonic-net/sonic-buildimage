SONIC_ONIE_IMAGE = sonic-$(CISCO_PLATFORM_ID).bin
$(SONIC_ONIE_IMAGE)_MACHINE = $(CISCO_PLATFORM_ID)
$(SONIC_ONIE_IMAGE)_IMAGE_TYPE = onie
$(SONIC_ONIE_IMAGE)_INSTALLS += \
    $(CISCO_SECURITY) \
    $(CISCO_WB_BSP_ACPI_PID_DEBS) \
    $(CISCO_WB_BSP2) \
    $(CISCO_WB_FPD) \
    $(SYSTEMD_SONIC_GENERATOR) \
    $(PYTHON3-SIX) \
    $(PYTHON3-PYUDEV) \
    $(YAML)
$(SONIC_ONIE_IMAGE)_LAZY_INSTALLS += \
    $(CISCO_WB_BSP) \
    $(CISCO_WB_BSP_PID_DEBS) \
    $(CISCO_WB_BSP_PYLIB) \
    $(CISCO_8000_PLATFORM_MODULE) \
    $(CISCO_8000_KMOD) \
    $(CISCO_8000_S1_Q200) \
    $(SDK_SAI) \
    $(MTD-UTILS) \
    $(NVME-CLI)
$(SONIC_ONIE_IMAGE)_DOCKERS += $(SONIC_INSTALL_DOCKER_IMAGES)
SONIC_INSTALLERS += $(SONIC_ONIE_IMAGE)
