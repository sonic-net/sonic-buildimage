#
# Script to execute any syncd pre shutdown routine.
#

#If dshell_clietn is running, stop the client service otherwise
#this blocks the dshell server shutdown, blocking syncd shutdown
#Making it best effort, non-blocking to not delay the shutdown precess
touch /tmp/.request_pre_shutdown
supervisorctl stop dshell_client > /dev/null &
