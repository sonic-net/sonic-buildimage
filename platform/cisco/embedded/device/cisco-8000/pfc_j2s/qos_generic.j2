{% elif ('type' in DEVICE_METADATA['localhost'] and DEVICE_METADATA['localhost']['type'] == 'SpineRouter') %}
{%- macro generate_bp_port_list(PORT, PORT_BP) %}
    {%- for port in PORT %}
        {%- if port.startswith('Ethernet-BP') %}
            {%- if PORT_BP.append(port) %}{%- endif %}
        {%- endif %}
    {%- endfor %}
{%- endmacro %}
{% endif %}

{%- macro generate_global_dscp_to_tc_map() %}
{# Default global dscp to tc map not needed #}
{%- endmacro %}

{%- macro generate_qos_bypass_port_list(PORT_QOS_BYPASS) %}
    {% for port in PORT %}
       {% if 'lanes' in PORT[port] %}
          {% if PORT[port]['lanes'] | int >= 0xfff0 %}
             {% set _ = PORT_QOS_BYPASS.append(port) %}
          {% endif %}
       {% endif %}
    {% endfor %}
{%- endmacro %}

