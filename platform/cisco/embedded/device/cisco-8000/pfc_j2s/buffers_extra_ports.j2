{%- macro generate_bp_port_list(PORT, PORT_BP) %}
    {%- for port in PORT %}
        {%- if port.startswith('Ethernet-BP') %}
            {%- if PORT_BP.append(port) %}{%- endif %}
        {%- endif %}
    {%- endfor %}
{%- endmacro %}
