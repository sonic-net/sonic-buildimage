[Unit]
Description=Cisco platform shutdown service
Before=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
Environment="LOG=/var/log/platform-shutdown.log"
RemainAfterExit=yes
ExecStart=/opt/cisco/bin/npu_shutdown.sh

[Install]
WantedBy=shutdown.target
