import os
import subprocess
import syslog

DEVPATH = "/usr/share/sonic/device/cisco-8000"
PLATFORM_SHUTDOWN_SERVICE = 'platform-shutdown.service'

def run_systemctl(*args):
    try:
        return subprocess.run(
            ['systemctl', *args],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        ).returncode
    except OSError as error:
        syslog.syslog(syslog.LOG_ERR, "Cannot execute systemctl: {}".format(error))
        return 127

def main():
    # Enable watchdog using watcdogutil to avoid hang in reboot path
    syslog.syslog(syslog.LOG_INFO, "reboot: Enable watchdog")
    os.system('watchdogutil arm -s 240')

    # Enable platform shutdown service
    ret = run_systemctl('is-enabled', PLATFORM_SHUTDOWN_SERVICE)
    if ret != 0:
        syslog.syslog(syslog.LOG_INFO, "Enable platform shutdown service")
        run_systemctl('enable', os.path.join(DEVPATH, PLATFORM_SHUTDOWN_SERVICE))

if __name__ == '__main__':
    main()
