load("@rules_python//python:defs.bzl", "py_binary", "py_test")

# Build through the same setup.py as Make so package discovery and metadata
# (including the jsonschema pin) stay with the PDDF distribution.
filegroup(
    name = "package_sources",
    srcs = glob(["sonic_platform_pddf_base/*.py"]),
)

py_binary(
    name = "build_wheel",
    srcs = ["build_wheel.py"],
    python_version = "3.13",
    deps = [
        "@config_engine_pip//setuptools",
        "@config_engine_pip//wheel",
    ],
)

genrule(
    name = "sonic_platform_pddf_common_wheel",
    srcs = [
        "setup.py",
        ":package_sources",
    ],
    outs = ["sonic_platform_pddf_common-1.0-py3-none-any.whl"],
    cmd = "$(execpath :build_wheel) $@ $(execpath setup.py) $(locations :package_sources)",
    tools = [":build_wheel"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "wheel_contract_test",
    srcs = ["wheel_contract_test.py"],
    args = [
        "$(rootpath :sonic_platform_pddf_common_wheel)",
        "$(rootpath setup.py)",
    ],
    data = [
        "setup.py",
        ":sonic_platform_pddf_common_wheel",
    ] + glob([
        "sonic_platform_*/*.py",
        "tests/*.py",
    ]),
    legacy_create_init = False,
    python_version = "3.13",
    deps = [
        "@config_engine_pip//setuptools",
        "@config_engine_pip//wheel",
    ],
)
