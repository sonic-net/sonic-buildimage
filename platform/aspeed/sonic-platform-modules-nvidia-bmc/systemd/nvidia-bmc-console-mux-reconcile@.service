# One reconcile pass for console line %i: puts the CPLD console mux back to the
# switch CPU if something moved it. Triggered by
# nvidia-bmc-console-mux-reconcile@.path; see there for why.
#
# Requisite=, not BindsTo=: a trigger arriving while the proxy is down must fail,
# not start the proxy (BindsTo implies Requires, which would).
[Unit]
Description=Reconcile the CPLD console mux for console line %i
Requisite=console-monitor-proxy@%i.service
After=console-monitor-proxy@%i.service

[Service]
Type=oneshot
ExecStart=/usr/bin/nvidia-bmc-console-mux.sh reconcile %i
