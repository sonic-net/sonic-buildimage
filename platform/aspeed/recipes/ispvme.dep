SPATH       := $($(ISPVME)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) $(PLATFORM_PATH)/recipes/ispvme.mk $(PLATFORM_PATH)/recipes/ispvme.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(SPATH))

$(ISPVME)_CACHE_MODE  := GIT_CONTENT_SHA
$(ISPVME)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST) $(PLATFORM_PATH) $(ISPVME_ARCHIVE_URL) $(ISPVME_ARCHIVE_SHA256)
$(ISPVME)_DEP_FILES   := $(DEP_FILES)
