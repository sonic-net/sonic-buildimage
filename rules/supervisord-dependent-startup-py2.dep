ifeq ($(ENABLE_PY2_MODULES), y)
    SPATH       := $($(SUPERVISORD_DEPENDENT_STARTUP_PY2)_SRC_PATH)
    DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/supervisord-dependent-startup-py2.mk rules/supervisord-dependent-startup-py2.dep
    DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
    SMDEP_FILES := $(addprefix $(SPATH)/,$(shell cd $(SPATH) && git ls-files))

    $(SUPERVISORD_DEPENDENT_STARTUP_PY2)_CACHE_MODE  := GIT_CONTENT_SHA
    $(SUPERVISORD_DEPENDENT_STARTUP_PY2)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
    $(SUPERVISORD_DEPENDENT_STARTUP_PY2)_DEP_FILES   := $(DEP_FILES)
    $(SUPERVISORD_DEPENDENT_STARTUP_PY2)_SMDEP_FILES := $(SMDEP_FILES)
    $(SUPERVISORD_DEPENDENT_STARTUP_PY2)_SMDEP_PATHS := $(SPATH)
endif
