SPATH       := $($(ALARMD)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/alarmd.mk rules/alarmd.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(SPATH))

$(ALARMD)_CACHE_MODE  := GIT_CONTENT_SHA
$(ALARMD)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(ALARMD)_DEP_FILES   := $(DEP_FILES)
