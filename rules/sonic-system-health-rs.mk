# SONiC system health daemon (healthd) and CLI backend (healthcheck)

SONIC_SYSTEM_HEALTH_RS_VERSION = 1.0.0
SONIC_SYSTEM_HEALTH_RS_NAME = sonic-system-health

SONIC_SYSTEM_HEALTH_RS = $(SONIC_SYSTEM_HEALTH_RS_NAME)_$(SONIC_SYSTEM_HEALTH_RS_VERSION)_$(CONFIGURED_ARCH).deb
$(SONIC_SYSTEM_HEALTH_RS)_SRC_PATH = $(SRC_PATH)/sonic-system-health-rs
$(SONIC_SYSTEM_HEALTH_RS)_VERSION = $(SONIC_SYSTEM_HEALTH_RS_VERSION)
$(SONIC_SYSTEM_HEALTH_RS)_NAME = $(SONIC_SYSTEM_HEALTH_RS_NAME)
$(SONIC_SYSTEM_HEALTH_RS)_DEPENDS = $(LIBSWSSCOMMON_DEV)
$(SONIC_SYSTEM_HEALTH_RS)_RDEPENDS = $(LIBSWSSCOMMON)

SONIC_DPKG_DEBS += $(SONIC_SYSTEM_HEALTH_RS)

SONIC_SYSTEM_HEALTH_RS_DBG = $(SONIC_SYSTEM_HEALTH_RS_NAME)-dbgsym_$(SONIC_SYSTEM_HEALTH_RS_VERSION)_$(CONFIGURED_ARCH).deb
$(eval $(call add_derived_package,$(SONIC_SYSTEM_HEALTH_RS),$(SONIC_SYSTEM_HEALTH_RS_DBG)))
