CFGGEN_SPATH := $($(SONIC_CFGGEN_LITE_RS)_SRC_PATH)
CFGGEN_DEP_FILES := $(SONIC_COMMON_FILES_LIST) rules/sonic-cfggen-lite-rs.mk rules/sonic-cfggen-lite-rs.dep
CFGGEN_DEP_FILES += $(SONIC_COMMON_BASE_FILES_LIST)
CFGGEN_DEP_FILES += $(shell git ls-files $(CFGGEN_SPATH))

CFGGEN_SWSS_SPATH := $($(LIBSWSSCOMMON)_SRC_PATH)
CFGGEN_SWSS_FILES := $(addprefix $(CFGGEN_SWSS_SPATH)/,$(shell cd $(CFGGEN_SWSS_SPATH) && git ls-files))

$(SONIC_CFGGEN_LITE_RS)_CACHE_MODE  := GIT_CONTENT_SHA
$(SONIC_CFGGEN_LITE_RS)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(SONIC_CFGGEN_LITE_RS)_DEP_FILES   := $(CFGGEN_DEP_FILES) $(CFGGEN_SWSS_FILES)
