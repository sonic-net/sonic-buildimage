
PAM_SPATH       := $($(LIBPAM_RADIUS)_SRC_PATH)
PAM_DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/radius.mk rules/radius.dep
PAM_DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
PAM_DEP_FILES   += $(shell git ls-files $(PAM_SPATH))

$(LIBPAM_RADIUS)_CACHE_MODE  := GIT_CONTENT_SHA
$(LIBPAM_RADIUS)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(LIBPAM_RADIUS)_DEP_FILES   := $(PAM_DEP_FILES)

NSS_SPATH       := $($(LIBNSS_RADIUS)_SRC_PATH)
NSS_DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/radius.mk rules/radius.dep
NSS_DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
NSS_DEP_FILES   += $(shell git ls-files $(NSS_SPATH))

$(LIBNSS_RADIUS)_CACHE_MODE  := GIT_CONTENT_SHA
$(LIBNSS_RADIUS)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(LIBNSS_RADIUS)_DEP_FILES   := $(NSS_DEP_FILES)
