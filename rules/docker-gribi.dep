DPATH       := $($(DOCKER_GRIBI)_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/docker-gribi.mk rules/docker-gribi.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell GIT_WORK_TREE=. git ls-files $(DPATH))

$(DOCKER_GRIBI)_CACHE_MODE  := GIT_CONTENT_SHA
$(DOCKER_GRIBI)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(DOCKER_GRIBI)_DEP_FILES   := $(DEP_FILES)

$(eval $(call add_dbg_docker,$(DOCKER_GRIBI),$(DOCKER_GRIBI_DBG)))
