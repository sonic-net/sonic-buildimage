SPATH       := $($(SONIC_HOST_SERVICES_RS)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/sonic-host-services-rs.mk rules/sonic-host-services-rs.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(SPATH).patch)

SMDEP_PATHS := $(SPATH) $(SRC_PATH)/sonic-swss-common
$(foreach path, $(SMDEP_PATHS), $(eval $(path) :=$(filter-out $(SMDEP_PATHS),$(addprefix $(path)/, $(shell cd $(path) && git ls-files)))))

$(SONIC_HOST_SERVICES_RS)_CACHE_MODE  := GIT_CONTENT_SHA
$(SONIC_HOST_SERVICES_RS)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(SONIC_HOST_SERVICES_RS)_DEP_FILES   := $(DEP_FILES)
$(SONIC_HOST_SERVICES_RS)_SMDEP_FILES := $(foreach path, $(SMDEP_PATHS), $($(path)))
$(SONIC_HOST_SERVICES_RS)_SMDEP_PATHS := $(SMDEP_PATHS)
