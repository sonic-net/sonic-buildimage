SPATH       := $($(NDPPD)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/ndppd.mk rules/ndppd.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(SPATH))

$(NDPPD)_CACHE_MODE  := GIT_CONTENT_SHA
$(NDPPD)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(NDPPD)_DEP_FILES   := $(DEP_FILES)
