DPATH       := $($(DOCKER_HFT)_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/docker-hft.mk rules/docker-hft.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(DPATH))

$(DOCKER_HFT)_CACHE_MODE  := GIT_CONTENT_SHA
$(DOCKER_HFT)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(DOCKER_HFT)_DEP_FILES   := $(DEP_FILES)

$(eval $(call add_dbg_docker,$(DOCKER_HFT),$(DOCKER_HFT_DBG)))
