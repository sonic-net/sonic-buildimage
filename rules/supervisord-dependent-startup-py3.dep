SPATH       := $($(SUPERVISORD_DEPENDENT_STARTUP_PY3)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/supervisord-dependent-startup-py3.mk rules/supervisord-dependent-startup-py3.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
SMDEP_FILES := $(addprefix $(SPATH)/,$(shell cd $(SPATH) && git ls-files))

$(SUPERVISORD_DEPENDENT_STARTUP_PY3)_CACHE_MODE  := GIT_CONTENT_SHA
$(SUPERVISORD_DEPENDENT_STARTUP_PY3)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(SUPERVISORD_DEPENDENT_STARTUP_PY3)_DEP_FILES   := $(DEP_FILES)
$(SUPERVISORD_DEPENDENT_STARTUP_PY3)_SMDEP_FILES := $(SMDEP_FILES)
$(SUPERVISORD_DEPENDENT_STARTUP_PY3)_SMDEP_PATHS := $(SPATH)
