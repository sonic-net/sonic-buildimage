ENABLE_MUX = y
AUTORESTART_MUX = y
DELAY_MUX = n

INCLUDE_LLDP = y
ENABLE_LLDP = y
AUTORESTART_LLDP = y
DELAY_LLDP = y

INCLUDE_TEAMD = y
ENABLE_TEAMD = y
AUTORESTART_TEAMD = y
DELAY_TEAMD = n

INCLUDE_MGMT_FRAMEWORK = y
ENABLE_MGMT_FRAMEWORK = y
AUTORESTART_MGMT_FRAMEWORK = y
DELAY_MGMT_FRAMEWORK = y

INCLUDE_RESTAPI = y
ENABLE_RESTAPI = y
AUTORESTART_RESTAPI = y
DELAY_RESTAPI = n

INCLUDE_DHCP_RELAY = y
ENABLE_DHCP_RELAY = y
AUTORESTART_DHCP_RELAY = y
DELAY_DHCP_RELAY = n

INCLUDE_SFLOW = y
ENABLE_SFLOW = y
AUTORESTART_SFLOW = y
DELAY_SFLOW = y

INCLUDE_ROUTER_ADVERTISER = y
ENABLE_ROUTER_ADVERTISER = y
AUTORESTART_ROUTER_ADVERTISER = y
DELAY_ROUTER_ADVERTISER = n

INCLUDE_SYSTEM_BMP = y
ENABLE_SYSTEM_BMP = y
