# ---------------------------------------------------------------------------
# Optional containers NOT active in this profile.
# Listed explicitly so the full feature set is visible in one place for review.
# ---------------------------------------------------------------------------

# STP: DC fabrics use L3 leaf-spine and avoid spanning tree; excluded.
INCLUDE_STP = n
ENABLE_STP = n
AUTORESTART_STP = n
DELAY_STP = n

# SNMP: superseded by gNMI/telemetry for DC fleet automation; excluded.
INCLUDE_SNMP = n
ENABLE_SNMP = n
AUTORESTART_SNMP = n
DELAY_SNMP = n

# NAT: DC ToRs do not NAT; excluded.
INCLUDE_NAT = n
ENABLE_NAT = n
AUTORESTART_NAT = n
DELAY_NAT = n

# DHCP_SERVER: DC relies on centralized DHCP infrastructure; excluded.
INCLUDE_DHCP_SERVER = n
ENABLE_DHCP_SERVER = n
AUTORESTART_DHCP_SERVER = n
DELAY_DHCP_SERVER = n

# MACSEC: access-layer link security, not typical in DC fabric; excluded.
INCLUDE_MACSEC = n
ENABLE_MACSEC = n
AUTORESTART_MACSEC = n
DELAY_MACSEC = n

# P4RT (P4Runtime): not used in this DC profile; excluded.
INCLUDE_P4RT = n
ENABLE_P4RT = n
AUTORESTART_P4RT = n
DELAY_P4RT = n
