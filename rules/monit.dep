
SPATH       := $($(MONIT)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/monit.mk rules/monit.dep   
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(SPATH))

$(MONIT)_CACHE_MODE  := GIT_CONTENT_SHA 
$(MONIT)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST) PREFER_DEBIAN_REPO=$(PREFER_DEBIAN_REPO) \
                        MONIT_DSC_SHA256=$(MONIT_DSC_SHA256) MONIT_ORIG_SHA256=$(MONIT_ORIG_SHA256) \
                        MONIT_DEBIAN_SHA256=$(MONIT_DEBIAN_SHA256)
$(MONIT)_DEP_FILES   := $(DEP_FILES)

