DPATH       := $($(DOCKER_MEGA)_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/docker-mega.mk rules/docker-mega.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(DPATH))

$(DOCKER_MEGA)_CACHE_MODE  := GIT_CONTENT_SHA
$(DOCKER_MEGA)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(DOCKER_MEGA)_DEP_FILES   := $(DEP_FILES)
