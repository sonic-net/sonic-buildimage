
DPATH       := $($(DOCKER_PTP)_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/docker-ptp.mk rules/docker-ptp.dep   
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(DPATH))

$(DOCKER_PTP)_CACHE_MODE  := GIT_CONTENT_SHA 
$(DOCKER_PTP)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST) $(ENABLE_ASAN)
$(DOCKER_PTP)_DEP_FILES   := $(DEP_FILES)

$(eval $(call add_dbg_docker,$(DOCKER_PTP),$(DOCKER_PTP_DBG)))
