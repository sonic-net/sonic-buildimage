
# Common dependency files
DEP_FILES := rules/sonic-redfish.mk rules/sonic-redfish.dep
DEP_FLAGS := $(SONIC_COMMON_FLAGS_LIST)

# bmcweb
BMCWEB_SPATH := $($(BMCWEB)_SRC_PATH)

$(BMCWEB)_CACHE_MODE  := GIT_CONTENT_SHA
$(BMCWEB)_DEP_FLAGS   := $(DEP_FLAGS)
$(BMCWEB)_DEP_FILES   := $(DEP_FILES)
$(BMCWEB)_SMDEP_FILES := $(addprefix $(BMCWEB_SPATH)/,$(shell cd $(BMCWEB_SPATH) && git ls-files))
$(BMCWEB)_SMDEP_PATHS := $(BMCWEB_SPATH)

# sonic-dbus-bridge
SONIC_DBUS_BRIDGE_SPATH := $($(SONIC_DBUS_BRIDGE)_SRC_PATH)

$(SONIC_DBUS_BRIDGE)_CACHE_MODE  := GIT_CONTENT_SHA
$(SONIC_DBUS_BRIDGE)_DEP_FLAGS   := $(DEP_FLAGS)
$(SONIC_DBUS_BRIDGE)_DEP_FILES   := $(DEP_FILES)
$(SONIC_DBUS_BRIDGE)_SMDEP_FILES := $(addprefix $(SONIC_DBUS_BRIDGE_SPATH)/,$(shell cd $(SONIC_DBUS_BRIDGE_SPATH) && git ls-files))
$(SONIC_DBUS_BRIDGE)_SMDEP_PATHS := $(SONIC_DBUS_BRIDGE_SPATH)
