SONIC_CFGGEN_LITE_RS_VERSION = 1.0.0
SONIC_CFGGEN_LITE_RS_NAME = sonic-cfggen-lite-rs

SONIC_CFGGEN_LITE_RS = $(SONIC_CFGGEN_LITE_RS_NAME)_$(SONIC_CFGGEN_LITE_RS_VERSION)_$(CONFIGURED_ARCH).deb
$(SONIC_CFGGEN_LITE_RS)_SRC_PATH = $(SRC_PATH)/sonic-cfggen-lite-rs
$(SONIC_CFGGEN_LITE_RS)_VERSION = $(SONIC_CFGGEN_LITE_RS_VERSION)
$(SONIC_CFGGEN_LITE_RS)_NAME = $(SONIC_CFGGEN_LITE_RS_NAME)
$(SONIC_CFGGEN_LITE_RS)_DEPENDS = $(LIBSWSSCOMMON_DEV)
$(SONIC_CFGGEN_LITE_RS)_RDEPENDS = $(LIBSWSSCOMMON)
$(SONIC_CFGGEN_LITE_RS)_BUILD_ENV = CARGO_TARGET_DIR=$(abspath $(TARGET_PATH)/cargo/sonic-cfggen-lite-rs/$(BLDENV)-$(CONFIGURED_ARCH))

SONIC_DPKG_DEBS += $(SONIC_CFGGEN_LITE_RS)

SONIC_CFGGEN_LITE_RS_DBG = $(SONIC_CFGGEN_LITE_RS_NAME)-dbgsym_$(SONIC_CFGGEN_LITE_RS_VERSION)_$(CONFIGURED_ARCH).deb
$(eval $(call add_derived_package,$(SONIC_CFGGEN_LITE_RS),$(SONIC_CFGGEN_LITE_RS_DBG)))
