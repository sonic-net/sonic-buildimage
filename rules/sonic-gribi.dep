SPATH       := $($(SONIC_GRIBI)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/sonic-gribi.mk rules/sonic-gribi.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell GIT_WORK_TREE=. git ls-files $(SPATH))

$(SONIC_GRIBI)_CACHE_MODE  := GIT_CONTENT_SHA
$(SONIC_GRIBI)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(SONIC_GRIBI)_DEP_FILES   := $(DEP_FILES)
