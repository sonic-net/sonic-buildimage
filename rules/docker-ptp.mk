# docker image for ptp

DOCKER_PTP_STEM = docker-ptp
DOCKER_PTP = $(DOCKER_PTP_STEM).gz
DOCKER_PTP_DBG = $(DOCKER_PTP_STEM)-$(DBG_IMAGE_MARK).gz

$(DOCKER_PTP)_PATH = $(DOCKERS_PATH)/$(DOCKER_PTP_STEM)

$(DOCKER_PTP)_LOAD_DOCKERS += $(DOCKER_SWSS_LAYER_BOOKWORM)
$(DOCKER_PTP)_DBG_DEPENDS = $($(DOCKER_SWSS_LAYER_BOOKWORM)_DBG_DEPENDS)
$(DOCKER_PTP)_DBG_IMAGE_PACKAGES = $($(DOCKER_SWSS_LAYER_BOOKWORM)_DBG_IMAGE_PACKAGES)

$(DOCKER_PTP)_VERSION = 1.0.0
$(DOCKER_PTP)_PACKAGE_NAME = ptp
$(DOCKER_PTP)_CONTAINER_NAME = ptp

$(DOCKER_PTP)_SERVICE_REQUIRES = config-setup
$(DOCKER_PTP)_SERVICE_AFTER = database syncd
$(DOCKER_PTP)_CONTAINER_PRIVILEGED = true
$(DOCKER_PTP)_CONTAINER_VOLUMES += /etc/sonic:/etc/sonic:ro

SONIC_BOOKWORM_DOCKERS += $(DOCKER_PTP)
SONIC_BOOKWORM_DBG_DOCKERS += $(DOCKER_PTP_DBG)

ifeq ($(INCLUDE_KUBERNETES),y)
$(DOCKER_PTP)_DEFAULT_FEATURE_OWNER = kube
endif

$(DOCKER_PTP)_DEFAULT_FEATURE_STATE_ENABLED = y

ifeq ($(INCLUDE_PTP),y)
SONIC_DOCKER_IMAGES += $(DOCKER_PTP)
SONIC_DOCKER_DBG_IMAGES += $(DOCKER_PTP_DBG)
ifeq ($(INSTALL_DEBUG_TOOLS),y)
SONIC_PACKAGES_LOCAL += $(DOCKER_PTP_DBG)
else
SONIC_PACKAGES_LOCAL += $(DOCKER_PTP)
endif
endif

$(DOCKER_PTP)_RUN_OPT += --privileged -v /etc/sonic:/etc/sonic:ro
