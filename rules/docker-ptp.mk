# docker image for ptp

DOCKER_PTP_STEM = docker-ptp
DOCKER_PTP = $(DOCKER_PTP_STEM).gz
DOCKER_PTP_DBG = $(DOCKER_PTP_STEM)-$(DBG_IMAGE_MARK).gz

$(DOCKER_PTP)_PATH = $(DOCKERS_PATH)/$(DOCKER_PTP_STEM)

$(DOCKER_PTP)_LOAD_DOCKERS += $(DOCKER_SWSS_LAYER_BOOKWORM)
$(DOCKER_PTP)_VERSION = 1.0.0
$(DOCKER_PTP)_PACKAGE_NAME = ptp
$(DOCKER_PTP)_CONTAINER_NAME = ptp

SONIC_DOCKER_IMAGES += $(DOCKER_PTP)
SONIC_BOOKWORM_DOCKERS += $(DOCKER_PTP)
SONIC_INSTALL_DOCKER_IMAGES += $(DOCKER_PTP)

$(DOCKER_MACSEC)_DEFAULT_FEATURE_STATE_ENABLED = y
