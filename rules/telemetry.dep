#DPKG FRK
SPATH       := $($(SONIC_TELEMETRY)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/telemetry.mk rules/telemetry.dep   
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
SMDEP_FILES := $(addprefix $(SPATH)/,$(shell cd $(SPATH) && git ls-files))


$(SONIC_TELEMETRY)_CACHE_MODE  := GIT_CONTENT_SHA 
$(SONIC_TELEMETRY)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST) ENABLE_TRANSLIB_WRITE=$(ENABLE_TRANSLIB_WRITE) ENABLE_NATIVE_WRITE=$(ENABLE_NATIVE_WRITE)
$(SONIC_TELEMETRY)_DEP_FILES   := $(DEP_FILES)
$(SONIC_TELEMETRY)_SMDEP_FILES := $(SMDEP_FILES)
$(SONIC_TELEMETRY)_SMDEP_PATHS := $(SPATH)

# Hash sibling Go sources as workspace inputs; .smdep paths are module-relative.
$(SONIC_TELEMETRY)_DEP_FILES += $(patsubst $(CURDIR)/%,%,$(addprefix $(SRC_PATH)/sonic-swss-common/,$(shell cd $(SRC_PATH)/sonic-swss-common && git ls-files go.mod goext/redisconn)))
$(SONIC_TELEMETRY)_SMDEP_PATHS += $(SRC_PATH)/sonic-swss-common
