     python3                 \
     python3-pip             \
@@ -385,6 +384,16 @@ sudo LANG=C DEBIAN_FRONTEND=noninteractive chroot $FILESYSTEM_ROOT apt-get -y in
     zstd                    \
     nvme-cli
 
+## Install self-built makedumpfile (with ARM64 VA Bits 52 fix)
+echo '[INFO] Install self-built makedumpfile'
+sudo cp $debs_path/makedumpfile_*.deb $FILESYSTEM_ROOT
+basename_makedumpfile=$(basename $debs_path/makedumpfile_*.deb)
+sudo LANG=C DEBIAN_FRONTEND=noninteractive chroot $FILESYSTEM_ROOT \
+    apt-get -y install --allow-downgrades ./$basename_makedumpfile
+sudo LANG=C chroot $FILESYSTEM_ROOT rm -f /$basename_makedumpfile
+## Keep apt from replacing it with Debian's makedumpfile, which lacks the fix
+sudo LANG=C chroot $FILESYSTEM_ROOT apt-mark hold makedumpfile
+
 sudo cp files/initramfs-tools/pzstd $FILESYSTEM_ROOT/etc/initramfs-tools/hooks/pzstd
 sudo chmod +x $FILESYSTEM_ROOT/etc/initramfs-tools/hooks/pzstd
 
