    use_legacy_rules_rust_platforms = True,
)
watchdog_crates.from_cargo(
    name = "bmp_watchdog_crates",
    cargo_lock = "//dockers/docker-bmp-watchdog/watchdog:Cargo.lock",
    cargo_toml = "//dockers/docker-bmp-watchdog/watchdog:Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
    use_legacy_rules_rust_platforms = True,
)
use_repo(watchdog_crates, "bmp_watchdog_crates", "gnmi_watchdog_crates")
include("//src/sonic-frr:deps.MODULE.bazel")

# Cache Go module ZIPs by reviewed archive digests.
bazel_dep(name = "gazelle", version = "0.54.0.sonic.1", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_go", version = "0.65.0.sonic.1", repo_name = "io_bazel_rules_go")
