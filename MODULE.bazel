        "@lm_sensors//:MODULE.bazel": "lm-sensors",
        "@otelcol_contrib//:MODULE.bazel": "otelcol-contrib",
        "@isc_dhcp//:MODULE.bazel": "isc-dhcp",
        "@sonic_dhcpmon//:MODULE.bazel": "sonic-dhcpmon",
        "@sonic_dhcp_relay//:MODULE.bazel": "sonic-dhcp-relay",
