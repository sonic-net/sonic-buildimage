bazel_dep(name = "aspect_bazel_lib", version = "2.19.3")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "gawk", version = "5.3.2.sonic.1")
bazel_dep(name = "googletest", version = "1.16.0")
