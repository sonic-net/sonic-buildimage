{
    "XCVR":
    {
        "xcvr_present":
        {
           "i2c":
           {
               "valmap-SFP28": {"1":false, "0":true }
           }
        }
    },

    "PSU":
    {
        "psu_present":
        {
            "bmc":
            {
                "valmap": { "4":true, "0":false }
            }
        },

        "psu_power_good":
        {
            "bmc":
            {
                "valmap": { "2": true, "0":false }
            }
        },

        "psu_fan_dir":
        {
            "i2c":
            {
                "valmap": { "F2B":"INTAKE", "B2F":"EXHAUST" }
            }
        },

        "PSU_FAN_MAX_SPEED":"18000"
    },

    "FAN":
    {
        "direction":
        {
            "bmc":
            {
                "valmap": {"1":"EXHAUST", "0":"INTAKE"}
            }
        },

        "present":
        {
            "bmc":
            {
                "valmap": {"1":false, "0":true}
            }
        },

        "fan_master_led_color":
        {
            "colmap": {"green":"green", "red":"amber"}
        },

        "duty_cycle_to_pwm": {"input_offset": 0, "multiplier": 1, "pre_divide_offset": 0, "divisor": 1, "output_offset": 0, "divide_before_multiply": false, "force_float": false},

        "pwm_to_duty_cycle": {"input_offset": 0, "multiplier": 1, "pre_divide_offset": 0, "divisor": 1, "output_offset": 0, "divide_before_multiply": false, "force_float": false}
    }

}
