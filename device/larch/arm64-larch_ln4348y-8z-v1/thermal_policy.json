{
    "thermal_control_algorithm": {
        "run_at_boot_up": "true",
        "fan_speed_when_suspend": "100"
    },
    "info_types": [
        {
            "type": "fan_info"
        },
        {
            "type": "thermal_info"
        },
        {
            "type": "chassis_info"
        }
    ],
    "policies": [
        {
            "name": "any fan absent",
            "conditions": [
                {
                    "type": "fan.any.absence"
                }
            ],
            "actions": [
                {
                    "type": "fan.all.set_speed",
                    "speed": "100"
                }
            ]
        },
        {
            "name": "any fan faulty",
            "conditions": [
                {
                    "type": "fan.any.fault"
                }
            ],
            "actions": [
                {
                    "type": "fan.all.set_speed",
                    "speed": "100"
                }
            ]
        },
        {
            "name": "temperature over high threshold",
            "conditions": [
                {
                    "type": "thermal.over.high_threshold"
                }
            ],
            "actions": [
                {
                    "type": "fan.all.set_speed",
                    "speed": "100"
                }
            ]
        },
        {
            "name": "fans and temperatures all good",
            "conditions": [
                {
                    "type": "fan.all.presence"
                },
                {
                    "type": "fan.all.good"
                },
                {
                    "type": "thermal.all.good"
                }
            ],
            "actions": [
                {
                    "type": "fan.all.set_speed",
                    "speed": "60"
                }
            ]
        }
    ]
}
