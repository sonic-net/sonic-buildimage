            }
        },
        "direction":
        {
            "bmc":
            {
                "valmap": { "0":"exhaust", "1":"intake" }
            }
        },
        
        "pwm_to_duty_cycle": {"input_offset": 0, "multiplier": 100, "pre_divide_offset": 0, "divisor": 18000, "output_offset": 0, "divide_before_multiply": true, "force_float": false}

