# Aspeed BMC USB Network Gadget Interface Renaming Rule
# Renames USB NCM gadget interface from usb0 to bmc0 for consistent naming

# Match USB NCM gadget interface with BMC MAC address and rename to bmc0
SUBSYSTEM=="net", ACTION=="add", DRIVERS=="?*", ATTR{address}=="02:00:00:00:00:01", NAME="bmc0"

# Pull in ifup@bmc0.service (allow-hotplug) so the static IP from
# /etc/network/interfaces is (re)applied whenever bmc0 appears, independent of
# the networking/interfaces-config service ordering. The literal instance name
# "bmc0" is used (not $name) because the NAME= rename only takes effect at the
# end of the add event, so $name still holds the pre-rename kernel name here.
# This must match "move" as well as "add": the rename above makes the kernel
# emit a move event, udev re-runs the rules for it, and an add-only ENV
# assignment is dropped before the bmc0 device unit that ifup@bmc0.service
# binds to exists. Net devices are tagged "systemd" by the builtin
# 99-systemd.rules, so SYSTEMD_WANTS is honored.
SUBSYSTEM=="net", ACTION=="add|move", ATTR{address}=="02:00:00:00:00:01", ENV{SYSTEMD_WANTS}+="ifup@bmc0.service"
