# NVIDIA AST2700 BMC: name the switch CPU console line.
#
# Unlike other BMC platforms, this board has no dedicated BMC->host UART.
# ttyS1 is not wired to the host at any uart_sel value. The host console is
# reached over the BMC's own console UART (uart12 / ttyS12) once the CPLD mux
# `uart_sel` is set to 3; the tty node itself is always present, so a static
# symlink is valid -- it is the far end that the mux switches.
#
# Consequence: while the console feature is enabled the BMC gives up its own
# serial console. serial-getty@ttyS12 is stopped by the proxy drop-in, and BMC
# kernel messages (console=ttyS12 in the bootargs) interleave into the session.
SUBSYSTEM=="tty", KERNEL=="ttyS12", SYMLINK+="ttySwitchCpu0", GROUP="dialout", MODE="0660"
