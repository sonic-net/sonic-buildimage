{
    
    "XCVR":
    {
        "xcvr_present":
        {
           "i2c":
           {
               "valmap-QSFP28": {"1":true, "0":false}
           }
        }
    },
    "PSU":
    {
        "psu_present": 
        {
            "i2c":
            {
                "valmap": { "1":true, "0":false }
            }
        },

        "psu_power_good": 
        {
            "i2c":
            {
                "valmap": { "1": true, "0":false }
            }
        },

        "psu_fan_dir":
        {
            "i2c":
            {
                "valmap": { "F2B":"EXHAUST", "B2F":"INTAKE" }
            }
        },

        "PSU_FAN_MAX_SPEED":"18000"
    },

    "FAN":
    {
        "direction":
        {
            "i2c":
            {
                "valmap": {"1":"INTAKE", "0":"EXHAUST"}
            }
        },

        "present":
        {
            "i2c":
            {
                "valmap": {"1":true, "0":false}
            }
        },
        
        "duty_cycle_to_pwm": {"input_offset": -10, "multiplier": 1, "pre_divide_offset": 0, "divisor": 6, "output_offset": 0, "divide_before_multiply": false, "force_float": false},
        "pwm_to_duty_cycle": {"input_offset": 0, "multiplier": 6, "pre_divide_offset": 0, "divisor": 1, "output_offset": 10, "divide_before_multiply": false, "force_float": false}
    }

}
