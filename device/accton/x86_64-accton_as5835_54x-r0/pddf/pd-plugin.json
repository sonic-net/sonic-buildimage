{
    "FAN": {
        "present": {
            "i2c": {
                "valmap": {
                    "1": true,
                    "0": false
                }
            }
        },
        "fault": {
            "i2c": {
                "valmap": {
                    "1": true,
                    "0": false
                }
            }
        },
        "direction": {
            "i2c": {
                "valmap": {
                    "0": "exhaust",
                    "1": "intake"
                }
            }
        },
        "pwm_to_duty_cycle": {
            "input_offset": 0,
            "multiplier": 1,
            "pre_divide_offset": 0,
            "divisor": 1,
            "output_offset": 0,
            "divide_before_multiply": false,
            "force_float": false
        },
        "duty_cycle_to_pwm": {
            "input_offset": 0,
            "multiplier": 1,
            "pre_divide_offset": 0,
            "divisor": 1,
            "output_offset": 0,
            "divide_before_multiply": false,
            "force_float": false
        }
    },
    "PSU": {
        "psu_present": {
            "i2c": {
                "valmap": {
                    "1": true,
                    "0": false
                }
            }
        },
        "psu_power_good": {
            "i2c": {
                "valmap": {
                    "1": true,
                    "0": false
                }
            }
        },
        "psu_fan_dir": {
            "i2c": {
                "valmap": {
                    "F2B": "exhaust",
                    "B2F": "intake"
                }
            }
        },
        "PSU_FAN_MAX_SPEED": "26688"
    }
}
