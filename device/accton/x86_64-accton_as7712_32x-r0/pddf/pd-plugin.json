{
    "PSU":
    {
        "psu_present": 
        {
            "i2c":
            {
                "valmap": { "1":true, "0":false }
            }
        },

        "psu_power_good": 
        {
            "i2c":
            {
                "valmap": { "1": true, "0":false }
            }
        },

        "psu_fan_dir":
        {
            "i2c":
            {
                "valmap": { "F2B":"EXHAUST", "B2F":"INTAKE" }
            }
        },

        "PSU_FAN_MAX_SPEED":"18000"
    },

    "FAN":
    {
        "direction":
        {
            "i2c":
            {
                "valmap": {"1":"EXHAUST", "0":"INTAKE"}
            }
        },

        "present":
        {
            "i2c":
            {
                "valmap": {"1":true, "0":false}
            }
        },
        
        "duty_cycle_to_pwm": {"input_offset": 0, "multiplier": 100, "pre_divide_offset": 0, "divisor": 625, "output_offset": -1, "divide_before_multiply": false, "force_float": true},

        "pwm_to_duty_cycle": {"input_offset": 1, "multiplier": 625, "pre_divide_offset": 0, "divisor": 100, "output_offset": 0, "divide_before_multiply": false, "force_float": true}
    }

}
