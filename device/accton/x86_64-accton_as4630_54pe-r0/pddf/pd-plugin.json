{
    "XCVR":
    {
        "xcvr_present":
        {
           "i2c":
           {
               "valmap-SFP28": {"1":true, "0":false },
               "valmap-QSFP28": {"1":true, "0":false}
           }
        }
    },

    "PSU":
    {
        "psu_present": 
        {
            "i2c":
            {
                "valmap": { "1":true, "0":false }
            }
        },

        "psu_power_good": 
        {
            "i2c":
            {
                "valmap": { "1": true, "0":false }
            }
        },

        "psu_fan_dir":
        {
            "i2c":
            {
                "valmap": { "F2B":"exhaust", "B2F":"intake" }
            }
        },

        "PSU_FAN_MAX_SPEED":"26688"
    },

    "FAN":
    {
        "direction":
        {
            "i2c":
            {
                "valmap": {"1":"exhaust", "0":"intake"}
            }
        },

        "present":
        {
            "i2c":
            {
                "valmap": {"1":true, "0":false}
            }
        },
        
        "duty_cycle_to_pwm": {"input_offset": 0, "multiplier": 100, "pre_divide_offset": 0, "divisor": 625, "output_offset": 0, "divide_before_multiply": false, "force_float": true},

        "pwm_to_duty_cycle": {"input_offset": 0, "multiplier": 625, "pre_divide_offset": 0, "divisor": 100, "output_offset": 0, "divide_before_multiply": false, "force_float": true}
    }

}
