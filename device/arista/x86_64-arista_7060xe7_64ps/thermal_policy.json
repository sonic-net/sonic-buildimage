{
    "thermal_control_algorithm": {
        "run_at_boot_up": "true",
        "fan_speed_when_suspend": "100"
    },
    "info_types": [
        {
            "type": "control_info"
        },
        {
            "type": "fan_info"
        },
        {
            "type": "thermal_info"
        }
    ],
    "policies": [
        {
            "name": "any thermal critical",
            "conditions": [
                {
                    "type": "thermal.any.critical"
                }
            ],
            "actions": [
                {
                    "type": "fan.all.set_speed",
                    "speed": "100"
                }
            ]
        },
        {
            "name": "any thermal overheat",
            "conditions": [
                {
                    "type": "thermal.any.overheat"
                }
            ],
            "actions": [
                {
                    "type": "fan.all.set_speed",
                    "speed": "100"
                }
            ]
        },
        {
            "name": "any fan fault",
            "conditions": [
                {
                    "type": "fan.any.fault"
                }
            ],
            "actions": [
                {
                    "type": "fan.all.set_speed",
                    "speed": "100"
                }
            ]
        },
        {
            "name": "normal operations",
            "conditions": [
                {
                    "type": "normal"
                }
            ],
            "actions": [
                {
                    "type": "thermal_control.control",
                    "version": 1,
                    "profiles": {
                        "default": {
                            "thermals": {
                                "Cpu": {
                                    "kp": 0.1,
                                    "ki": 0,
                                    "kd": 0,
                                    "zone": "asic_zone"
                                },
                                "Primary Inlet Sensor": {
                                    "kp": 0,
                                    "ki": 0,
                                    "kd": 0,
                                    "zone": "system_zone"
                                },
                                "TH6 on-die.*": {
                                    "kp": 0.19,
                                    "ki": 0,
                                    "kd": 16.744,
                                    "zone": "asic_zone"
                                },
                                "(Banff Board.+|Board Front Bottom|Power Board \\d|POS[013]V.+)": {
                                    "kp": 0.3,
                                    "ki": 0,
                                    "kd": 16.875,
                                    "zone": "system_zone"
                                },
                                "Ethernet.*": {
                                    "kp": 0.36,
                                    "ki": 0,
                                    "kd": 12.15,
                                    "zone": "system_zone"
                                },
                                "Power supply \\d+ inlet sensor": {
                                    "kp": 0.068,
                                    "ki": 0,
                                    "kd": 26.0355,
                                    "zone": "psu_zone"
                                },
                                "Power supply \\d+ secondary hotspot sensor": {
                                    "kp": 0.054,
                                    "ki": 0,
                                    "kd": 11.64375,
                                    "zone": "psu_zone"
                                },
                                "Power supply \\d+ primary hotspot sensor": {
                                    "kp": 0.051,
                                    "ki": 0,
                                    "kd": 10.51875,
                                    "zone": "psu_zone"
                                }
                            },
                            "fans": {
                                "fan[1-4]": { "zone": "asic_zone" },
                                "fan[5-8]": { "zone": "system_zone" },
                                "psu\\d+/\\d+": { "zone": "psu_zone" }
                            },
                            "zones": {
                                "asic_zone": {
                                    "logic": "classicpid"
                                },
                                "system_zone": {
                                    "logic": "classicpid"
                                },
                                "psu_zone": {
                                    "logic": "classicpid"
                                }
                            }
                        }
                    }
                }
            ]
        }
    ]
}
