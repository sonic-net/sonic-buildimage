soc_family.BCM8885X=BCM8885X

system_ref_core_clock_khz=1200000

# Inlined BCM8885X shared SoC properties. The Broadcom SAI parser does not
# support the previous external import directive on this platform.
BroadSync_enable_clk=1
custom_feature_kbp_multithread_en.BCM8885X=0
custom_feature_mesh_topology_sync_mode=1
custom_feature_multithread_en.BCM8885X=1
custom_feature_programmability_standard_image_name.BCM8885X=standard_1
custom_feature_ptp_cosq_port.BCM8885X=204
custom_feature_ser_event_generate=1
custom_feature_ts_pll_internal_clock_reference.BCM8885X=0
dma_desc_aggregator_enable_specific_INIT.BCM8885X=1
dport_map_direct.BCM8885X=1
eventor_sbus_dma_channels.BCM8885X=1,0,1,1
fabric_connectivity_based_on_integrity=0
fabric_connect_mode=FE
macro_flow_hash_shuffle_random_seed=34345645
maximal_port_bandwidth.BCM8885X=600000
pcie_host_intf_timeout_purge_enable=0
phy_1588_dpll_frequency_lock.BCM8885X=1
phy_rx_polarity_flip.0=0
phy_rx_polarity_flip.1=0
phy_tx_polarity_flip.0=0
phy_tx_polarity_flip.1=0
### PKTIO requires the NGKNET kernel module, which is not integrated on this
### platform (legacy linux_bcm_knet is used instead). Disable PKTIO so the SDK
### falls back to the legacy KNET packet path; otherwise dnx_pktio_init fails
### with "Feature unavailable" and INIT_DNX aborts switch creation.
pktio_driver_type=0
port_priorities.BCM8885X=8
programmability_image_name.BCM8885X=standard_1
programmability_ucode_relative_path.BCM8885X=pemla/ucode/standard_1/jer2pemla/u_code_db2pem.txt
qos_map_multi_get_mode=1
sai_async_fdb_nbr_enable=0x1
sai_common_hash_crc=0x1
sai_dis_ctr_incr_on_port_ln_dn=0
sai_macro_flow_based_hash=1
sai_mmu_qgroups_default=1
sai_optimized_mmu=0x1
sat_enable.BCM8885X=1
system_headers_mode.BCM8885X=1
tm_port_header_type_in_0.BCM8885X=INJECTED
tm_port_header_type_in_1.BCM8885X=ETH
tm_port_header_type_in_200.BCM8885X=INJECTED
tm_port_header_type_in_201.BCM8885X=INJECTED
