#!/bin/bash
#
# usage:
# arp_update:
# Send ipv6 multicast pings to all "UP" L3 interfaces including vlan interfaces to
# refresh link-local addresses from neighbors.
# Send gratuitous ARP/NDP requests to VLAN member neighbors to refresh
# the ipv4/ipv6 neighbors state.

ARP_UPDATE_VARS_FILE="/usr/share/sonic/templates/arp_update_vars.j2"

# Overload `logger` command to include arp_update tag
logger () {
    command logger -t "arp_update" "$@"
}

# Function to run a command with retries on failure
run_with_retry_cmd() {
    local desc="$1"; shift
    local max_tries=1
    local interval=3
    local i=1

    while [ $i -le $max_tries ]; do
        "$@"
        local rc=$?
        if [ $rc -eq 0 ]; then
            return 0
        fi
        if [ $i -lt $max_tries ]; then
            logger -p warning "command '${desc}' failed on attempt ${i} (rc=${rc}); retrying (next attempt $((i + 1)) of ${max_tries})"
            sleep $interval
        fi
        i=$((i + 1))
    done

    logger -p warning "command failed after ${max_tries} retries: ${desc}"
    return 1
}

run_arping_with_retry() {
    local ifname="$1"
    local ip="$2"
    run_with_retry_cmd "arping on ${ifname} to ${ip}" \
        arping -q -w 0 -c 1 -i "$ifname" "$ip" >/dev/null 2>&1
}

run_ndisc6_with_retry() {
    local ifname="$1"
    local ip="$2"
    run_with_retry_cmd "ndisc6 on ${ifname} to ${ip}" \
        ndisc6 -q -w 0 -1 "$ip" "$ifname" >/dev/null 2>&1
}

run_ipv6_multicast_ping() {
    local wait_time="$1"
    local ifname="$2"
    run_with_retry_cmd "IPv6 multicast ping on ${ifname}" \
        timeout "$wait_time" ping6 -I "$ifname" -n -q -i 0 -c 1 -W 0 ff02::1 >/dev/null 2>&1
}

is_missing_neighbor_cleanup_candidate() {
    local neighbor_ip="$1" intf="$2"
    [[ "$intf" == Vlan* && "$neighbor_ip" != 169.254.* &&
        ! "$neighbor_ip" =~ ^[fF][eE][89aAbB][[:xdigit:]]: ]]
}

recheck_missing_neighbors() {
    local neighbors="$1"
    local neighbor_ip intf appl_db_mac kernel_neighbor ip_family failed=0

    while IFS=, read -r neighbor_ip intf; do
        [[ -z "$neighbor_ip" ]] && continue
        is_missing_neighbor_cleanup_candidate "$neighbor_ip" "$intf" || continue
        if ! appl_db_mac="$(sonic-db-cli -s APPL_DB hget "NEIGH_TABLE:${intf}:${neighbor_ip}" neigh)"; then
            logger -p error "Failed to read APPL_DB neighbor ${neighbor_ip} on ${intf} during recheck"
            failed=1
            continue
        fi
        [[ -n "$appl_db_mac" ]] && continue

        if [[ "$neighbor_ip" == *":"* ]]; then
            ip_family=-6
        else
            ip_family=-4
        fi
        if ! kernel_neighbor="$(ip "$ip_family" neigh show to "$neighbor_ip" dev "$intf")"; then
            logger -p error "Failed to read kernel neighbor ${neighbor_ip} on ${intf} during recheck"
            failed=1
            continue
        fi
        if [[ -n "$kernel_neighbor" && ! "$kernel_neighbor" =~ [[:space:]](PERMANENT|NOARP)([[:space:]]|$) ]]; then
            logger -p warning "Neighbor ${neighbor_ip} on ${intf} present in kernel but still missing from APPL_DB after recheck; flushing without probing"
            if ! ip "$ip_family" neigh flush to "$neighbor_ip" dev "$intf"; then
                logger -p error "Failed to flush kernel neighbor ${neighbor_ip} on ${intf} during recheck"
                failed=1
            fi
        fi
    done <<< "$neighbors"

    return "$failed"
}

load_kernel_vlan_neighbors() {
    local subtype="$1"
    local kernel_neighbors4 kernel_neighbors6
    KERNEIGH4=""
    KERNEIGH6=""
    if ! kernel_neighbors4="$(ip -4 neigh show)"; then
        logger -p error "Failed to read IPv4 kernel neighbor snapshot"
        return 1
    fi
    if ! kernel_neighbors6="$(ip -6 neigh show)"; then
        logger -p error "Failed to read IPv6 kernel neighbor snapshot"
        return 1
    fi
    if ! KERNEIGH4="$(awk -v subtype="$subtype" '/Vlan/ && (subtype == "dualtor" || !/FAILED|INCOMPLETE/) {print $1 "," $3}' <<< "$kernel_neighbors4")" ||
        ! KERNEIGH6="$(awk -v subtype="$subtype" '!/fe80/ && /Vlan/ && (subtype == "dualtor" || !/FAILED|INCOMPLETE/) {print $1 "," $3}' <<< "$kernel_neighbors6")"; then
        KERNEIGH4=""
        KERNEIGH6=""
        logger -p error "Failed to filter kernel neighbor snapshots"
        return 1
    fi
}

ping_db_neighbor() {
    local neighbor_ip="$1" intf="$2"
    if [[ $neighbor_ip == *"."* ]]; then
        logger "mismatch arp entry, pinging ${neighbor_ip} on ${intf}"
        run_with_retry_cmd "db/kernel mismatch ping to ${neighbor_ip} on ${intf}" \
            timeout 0.2 ping -I "$intf" -n -q -i 0 -c 1 -W 1 "$neighbor_ip" >/dev/null 2>&1
    elif [[ $neighbor_ip == *":"* ]]; then
        logger "mismatch v6 nbr entry, pinging ${neighbor_ip} on ${intf}"
        run_with_retry_cmd "db/kernel mismatch ping6 to ${neighbor_ip} on ${intf}" \
            timeout 0.2 ping6 -I "$intf" -n -q -i 0 -c 1 -W 1 "$neighbor_ip" >/dev/null 2>&1
    fi
}

# Print "ip,intf" for VLAN DB neighbors missing from the KERNEIGH4/KERNEIGH6 snapshot.
collect_db_neighbors_missing_from_kernel() {
    local db_neighbors="$1"
    local neigh intf neighbor_ip

    for neigh in $db_neighbors; do
        intf="$( cut -d ':' -f 2 <<< "$neigh" )"
        neighbor_ip="$( cut -d ':' -f 3- <<< "$neigh" )"
        [[ $intf == *"Vlan"* ]] || continue
        if [[ $neighbor_ip == *"."* && ! $KERNEIGH4 =~ "${neighbor_ip},${intf}" ]] ||
            [[ $neighbor_ip == *":"* && ! $KERNEIGH6 =~ "${neighbor_ip},${intf}" ]]; then
            printf '%s,%s\n' "$neighbor_ip" "$intf"
        fi
    done
}

# Ping APPL_DB neighbors only if they are still in APPL_DB and still absent from the kernel.
recheck_db_neighbors_missing_from_kernel() {
    local neighbors="$1" subtype="$2"
    local neighbor_ip intf appl_db_mac kernel_neighbor ip_family failed=0

    while IFS=, read -r neighbor_ip intf; do
        [[ -z "$neighbor_ip" ]] && continue
        if ! appl_db_mac="$(sonic-db-cli -s APPL_DB hget "NEIGH_TABLE:${intf}:${neighbor_ip}" neigh)"; then
            logger -p error "Failed to read APPL_DB neighbor ${neighbor_ip} on ${intf} during kernel recheck"
            failed=1
            continue
        fi
        [[ -z "$appl_db_mac" ]] && continue

        if [[ "$neighbor_ip" == *":"* ]]; then
            ip_family=-6
        else
            ip_family=-4
        fi
        if ! kernel_neighbor="$(ip "$ip_family" neigh show to "$neighbor_ip" dev "$intf")"; then
            logger -p error "Failed to read kernel neighbor ${neighbor_ip} on ${intf} during kernel recheck"
            failed=1
            continue
        fi
        if [[ -n "$kernel_neighbor" ]] &&
            [[ "$subtype" == "dualtor" || ! "$kernel_neighbor" =~ [[:space:]](FAILED|INCOMPLETE)([[:space:]]|$) ]]; then
            continue
        fi
        ping_db_neighbor "$neighbor_ip" "$intf"
    done <<< "$neighbors"

    return "$failed"
}

flush_unsynced_neighbors() {
    local vlan="$1"
    local neighbors="$2"
    local neighbor_ip dev ifname _
    local flushed=1

    while read -r neighbor_ip dev ifname _; do
        if [[ -z "$neighbor_ip" || "$dev" != "dev" || -z "$ifname" ]]; then
            continue
        fi
        if [[ -z "$(sonic-db-cli -s APPL_DB hget "NEIGH_TABLE:${vlan}:${neighbor_ip}" neigh)" ]]; then
            flushed=0
            ip neigh flush "$neighbor_ip"
        fi
    done <<< "$neighbors"

    return "$flushed"
}

replace_failed_neighbors() {
    local neighbors="$1"
    local neighbor_ip dev ifname _

    while read -r neighbor_ip dev ifname _; do
        if [[ -z "$neighbor_ip" || "$dev" != "dev" || -z "$ifname" ]]; then
            continue
        fi
        ip neigh replace "$neighbor_ip" dev "$ifname" nud incomplete
    done <<< "$neighbors"
}

while /bin/true; do
  # find L3 interfaces which are UP, send ipv6 multicast pings
  ARP_UPDATE_VARS=$(sonic-cfggen -d -t ${ARP_UPDATE_VARS_FILE})
  if [ $? -ne 0 ]; then
      logger -p error "arp_update_vars cannot be generated"
      sleep 300
      continue
  fi

  SWITCH_TYPE=$(echo $ARP_UPDATE_VARS | jq -r '.switch_type')
  TYPE=$(echo $ARP_UPDATE_VARS | jq -r '.type')
  if [[ "$SWITCH_TYPE" == "chassis-packet" ]] || [[ "$TYPE" == "BackEndToRRouter" ]]; then
      # Get array of Nexthops and ifnames. Nexthops and ifnames are mapped one to one
      STATIC_ROUTE_NEXTHOPS=($(echo $ARP_UPDATE_VARS | jq -r '.static_route_nexthops'))
      STATIC_ROUTE_IFNAMES=($(echo $ARP_UPDATE_VARS | jq -r '.static_route_ifnames'))

      if [[ -z "$STATIC_ROUTE_NEXTHOPS" ]] || [[ -z "$STATIC_ROUTE_IFNAMES" ]]; then
          if [[ "$SWITCH_TYPE" == "chassis-packet" ]]; then
              # exit gracefully if running on supervisor/rp
              logger "exiting as no static route in packet based chassis"
              exit 0
          fi
          # continue if running on BT0
      else
          for i in ${!STATIC_ROUTE_NEXTHOPS[@]}; do
              nexthop="${STATIC_ROUTE_NEXTHOPS[i]}"
              if [[ $nexthop == *"."* ]]; then
                  neigh_state=$(ip -4 neigh show | grep -w $nexthop | tr -s ' ')
                  ping_prefix=ping
              elif [[ $nexthop == *":"* ]] ; then
                  neigh_state=$(ip -6 neigh show | grep -w $nexthop | tr -s ' ')
                  ping_prefix=ping6
              fi
              # Check if there is an INCOMPLETE, FAILED, or STALE entry and try to resolve it again.
              # STALE entries may be present if there is no traffic on a path. A far-end down event may not
              # clear the STALE entry. Refresh the STALE entry to clear the table.
              if [[ -z "${neigh_state}" ]] || [[ -n $(echo ${neigh_state} | grep 'INCOMPLETE\|FAILED\|STALE') ]]; then
                  interface="${STATIC_ROUTE_IFNAMES[i]}"
                  if [[ -z "$interface" ]]; then
                      # should never be here, handling just in case
                      logger -p warning "missing interface entry for static route $nexthop"
                      continue
                  fi
                  intf_up=$(ip link show "$interface" | grep "state UP")
                  if [[ -n "$intf_up" ]]; then
                      run_with_retry_cmd "static route ping to $nexthop on $interface" \
                          timeout 0.2 $ping_prefix -I "$interface" -n -q -i 0 -c 1 -W 1 "$nexthop" >/dev/null 2>&1
                  fi
              fi
          done

          if [[ "$SWITCH_TYPE" == "chassis-packet" ]]; then
            sleep 150
            # skip the rest of the script if running on a packet chassis
            continue
          fi
      fi
  fi

  # find L3 interfaces which are UP, send ipv6 multicast pings
  INTERFACE=$(echo $ARP_UPDATE_VARS | jq -r '.interface')
  PC_INTERFACE=$(echo $ARP_UPDATE_VARS | jq -r '.pc_interface')
  VLAN_SUB_INTERFACE=$(echo $ARP_UPDATE_VARS | jq -r '.vlan_sub_interface')

  ALL_INTERFACE="$INTERFACE $PC_INTERFACE $VLAN_SUB_INTERFACE"
  for intf in $ALL_INTERFACE; do
      intf_up=$(ip link show "$intf" | grep "state UP")
      if [[ -n "$intf_up" ]]; then
          run_ipv6_multicast_ping 0.2 "$intf"
      fi
  done

  # find neighbor entries with aged MAC and flush/relearn them
  STALE_NEIGHS=$(ip neigh show | grep -v "fe80" | grep "STALE" | awk '{print $1 "," $5}' | tr '[:lower:]' '[:upper:]')
  for neigh in $STALE_NEIGHS; do
        ip="$( cut -d ',' -f 1 <<< "$neigh" )"
        mac="$( cut -d ',' -f 2 <<< "$neigh" )"
        if [[ -z $(sonic-db-cli -s ASIC_DB keys "ASIC_STATE:SAI_OBJECT_TYPE_FDB_ENTRY*${mac}*") ]]; then
            run_with_retry_cmd "stale neighbor ping to $ip" \
                timeout 0.2 ping -c1 -w1 "$ip" >/dev/null 2>&1
        fi
  done

  # Flush neighbor entries with MAC mismatch between kernel and APPL_DB
  SUBTYPE=$(sonic-db-cli -s CONFIG_DB hget 'DEVICE_METADATA|localhost' 'subtype' | tr '[:upper:]' '[:lower:]')
  KERNEL_NEIGH=$(ip neigh show | grep -v "fe80" | grep -v "FAILED\|INCOMPLETE" | cut -d ' ' -f 1,3,5 --output-delimiter=',' | tr -d ' ')
  MISSING_APPL_DB_NEIGH=""
  for neigh in $KERNEL_NEIGH; do
        ip="$( cut -d ',' -f 1 <<< "$neigh" )"
        intf="$( cut -d ',' -f 2 <<< "$neigh" )"
        kernel_mac="$( cut -d ',' -f 3 <<< "$neigh" )"
        if [[ "$SUBTYPE" == "dualtor" && "$ip" == 169.254.* ]]; then
            continue
        fi
        if ! appl_db_mac="$(sonic-db-cli -s APPL_DB hget "NEIGH_TABLE:${intf}:${ip}" neigh)"; then
            logger -p error "Failed to read APPL_DB neighbor ${ip} on ${intf} during MAC check"
            continue
        fi
        if [[ $kernel_mac != $appl_db_mac ]]; then
            logger -p warning "MAC mismatch for ${ip} on ${intf} - kernel: ${kernel_mac}, APPL_DB: ${appl_db_mac}"
            # Neighbor is missing in APPL_DB, which could indicate it is in the process of being deleted.
            # Only defer neighbors that still exist in the live kernel.
            if [[ -z "$appl_db_mac" ]]; then
                is_missing_neighbor_cleanup_candidate "$ip" "$intf" || continue
                if [[ "$ip" == *":"* ]]; then
                    ip_family=-6
                else
                    ip_family=-4
                fi
                if ! kernel_neighbor="$(ip "$ip_family" neigh show to "$ip" dev "$intf")"; then
                    logger -p error "Failed to read kernel neighbor ${ip} on ${intf} during MAC check"
                    continue
                fi
                [[ -z "$kernel_neighbor" || "$kernel_neighbor" =~ [[:space:]](PERMANENT|NOARP)([[:space:]]|$) ]] && continue
                MISSING_APPL_DB_NEIGH+="${ip},${intf}"$'\n'
                continue
            fi
            ip neigh flush "$ip"
            if [[ $ip == *":"* ]]; then
                ping_prefix=ping6
            else
                ping_prefix=ping
            fi
            run_with_retry_cmd "mac mismatch ping to $ip on $intf" \
                timeout 0.2 $ping_prefix -I "$intf" -n -q -i 0 -c 1 -W 1 "$ip" >/dev/null 2>&1
        fi
  done

  VLAN=$(echo $ARP_UPDATE_VARS | jq -r '.vlan')
  for vlan in $VLAN; do
      # generate a list of arping commands:
      #   arping -q -w 0 -c 1 -i <VLAN interface> <IP 1>;
      #   arping -q -w 0 -c 1 -i <VLAN interface> <IP 2>;
      #   ...
      while read -r ip ifname; do
          [ -z "$ip" ] && continue
          run_arping_with_retry "$ifname" "$ip"
      done < <(ip -4 neigh show | grep "$vlan" | awk '{print $1, $3}')

      # send ipv6 multicast pings to Vlan interfaces to get/refresh link-local addrs
      run_ipv6_multicast_ping 1 "$vlan"

      # generate a list of ndisc6 commands (exclude link-local addrs since it is done above):
      #   ndisc6 -q -w 0 -1 <IP 1> <VLAN interface>;
      #   ndisc6 -q -w 0 -1 <IP 2> <VLAN interface>;
      #   ...
      while read -r ip ifname; do
          [ -z "$ip" ] && continue
          run_ndisc6_with_retry "$ifname" "$ip"
      done < <(ip -6 neigh show | grep -v fe80 | grep "$vlan" | awk '{print $1, $3}')

      if [[ $SUBTYPE == "dualtor" ]]; then
        # capture all current failed/incomplete IPv6 neighbors in the kernel to avoid situations where new neighbors are learned
        # in the middle of the below sequence of commands
        unresolved_kernel_neighbors=$(ip -6 neigh show | grep -v fe80 | grep $vlan | grep -E 'FAILED|INCOMPLETE')
        failed_kernel_neighbors=$(echo "$unresolved_kernel_neighbors" | grep FAILED | cut -d ' ' -f 1)

        # it's possible for kernel neighbors to fall out of sync with the hardware
        # this can result in failed neighbors entries that don't have corresponding zero MAC neighbor entries
        # and therefore don't have tunnel routes installed in the hardware
        # flush these neighbors from the kernel to force relearning and resync them to the hardware:
        # 1. for every FAILED or INCOMPLETE neighbor in the kernel, check if there is a corresponding zero MAC neighbor in APPL_DB
        # 2. if no zero MAC neighbor entry exists, flush the kernel neighbor entry
        #     - generates the command 'ip neigh flush <neighbor IPv6>' for all such neighbors
        if flush_unsynced_neighbors "$vlan" "$unresolved_kernel_neighbors"; then
            sleep 2
        fi

        # generates the following command for each FAILED or INCOMPLETE IPv6 neighbor
        # timeout 0.2 ping <neighbor IPv6> -n -q -i 0 -c 1 -W 1 -I <VLAN name> >/dev/null
        if [[ ! -z "$unresolved_kernel_neighbors" ]]; then
            while read -r ip ifname; do
                run_with_retry_cmd "failed ipv6 neighbor ping to $ip on $ifname" \
                    timeout 0.2 ping -n -q -i 0 -c 1 -W 1 -I "$ifname" "$ip" >/dev/null 2>&1
            done < <(echo "$unresolved_kernel_neighbors" | awk '{print $1, $3}')
            # allow some time for any transient INCOMPLETE neighbors to transition to FAILED
            sleep 5
        fi

        # manually set any remaining FAILED entries to permanently INCOMPLETE
        # once these entries are INCOMPLETE, any subsequent neighbor advertisement messages are able to resolve the entry
        # ignore INCOMPLETE neighbors since if they are transiently incomplete (i.e. new kernel neighbors that we are attempting to resolve for the first time),
        # setting them to permanently incomplete here means the kernel will never generate a netlink message for that neighbor
        # generates the following command for each FAILED IPv6 neighbor
        # ip neigh replace <neighbor IPv6> dev <VLAN name> nud incomplete
        failed_kernel_neighbors=$(ip -6 neigh show | grep -v fe80 | grep $vlan | grep -E 'FAILED')
        if [[ ! -z "$failed_kernel_neighbors" ]]; then
            replace_failed_neighbors "$failed_kernel_neighbors"
        fi
      fi
  done


  # Record APPL_DB neighbors missing from the kernel; ping them after the wait only if still missing.
  DB_NEIGH_MISSING_FROM_KERNEL=""
  if load_kernel_vlan_neighbors "$SUBTYPE"; then
      if DBNEIGH="$(sonic-db-cli -s APPL_DB keys 'NEIGH_TABLE*')"; then
          DB_NEIGH_MISSING_FROM_KERNEL=$(collect_db_neighbors_missing_from_kernel "$DBNEIGH")
      else
          logger -p error "Failed to read APPL_DB neighbor keys during initial kernel check"
      fi
  fi

  # sleep here before handling the mismatch as it is not required during startup
  sleep 120
  # Flush confirmed kernel-only neighbors without proactively recreating them.
  if [[ -n "$MISSING_APPL_DB_NEIGH" ]]; then
      recheck_missing_neighbors "$MISSING_APPL_DB_NEIGH"
  fi
  if [[ -n "$DB_NEIGH_MISSING_FROM_KERNEL" ]]; then
      recheck_db_neighbors_missing_from_kernel "$DB_NEIGH_MISSING_FROM_KERNEL" "$SUBTYPE"
  fi

  # refresh neighbor entries from CONFIG_DB in case of mismatch with kernel
  if DBNEIGH="$(sonic-db-cli -s CONFIG_DB keys 'NEIGH*')"; then
      if load_kernel_vlan_neighbors "$SUBTYPE"; then
          while IFS=, read -r ip intf; do
              [[ -n "$ip" ]] && ping_db_neighbor "$ip" "$intf"
          done <<< "$(collect_db_neighbors_missing_from_kernel "${DBNEIGH//|/:}")"
      fi
  else
      logger -p error "Failed to read CONFIG_DB neighbor keys during kernel refresh"
  fi

done
