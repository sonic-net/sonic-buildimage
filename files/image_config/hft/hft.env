# Settings of the hft container (High Frequency Telemetry counter sync daemon).
#
# This file is read by /usr/bin/countersyncd.sh in the hft container each time
# countersyncd starts. Restart the hft service (hft@<asic> on multi-ASIC) or
# run "docker exec hft supervisorctl restart countersyncd" to apply changes.
#
# Syntax: one KEY=VALUE per line, lines starting with '#' are comments. Values
# are used literally (no shell expansion, no inline comments). Only
# COUNTERSYNCD_* and HFT_* keys are accepted.
#
# COUNTERSYNCD_<NAME>=<value> is passed to countersyncd as --<name>=<value>,
# with <name> in lower case and '_' replaced by '-'. "true" sets a flag and
# "false" (or an empty value) leaves the option out. Any option listed by
# "docker exec hft countersyncd --help" can be set this way.
#
# The environment of the container (docker run -e, Kubernetes env/envFrom)
# overrides this file, and countersyncd arguments given to the container
# (docker run <image> ARG..., Kubernetes args) override both.
#
# Examples:
#
# Export to the OpenTelemetry collector of the otel container (default)
#COUNTERSYNCD_ENABLE_OTEL=true
#COUNTERSYNCD_OTEL_ENDPOINT=http://localhost:4317
#
# Also write the counters to COUNTERS_DB every 3 seconds
#COUNTERSYNCD_ENABLE_COUNTER_DB=true
#COUNTERSYNCD_COUNTER_DB_FREQUENCY=3
#
#COUNTERSYNCD_LOG_LEVEL=info
#
# Extra raw countersyncd arguments
#HFT_COUNTERSYNCD_ARGS=
