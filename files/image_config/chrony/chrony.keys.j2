{# We can connect only to the servers we trust. Determine those servers.
ConfigDB values are stripped of whitespace/control characters below so a
value that bypasses YANG validation (e.g. a direct Redis write) cannot
inject a second chrony.keys directive or extra arguments onto a line. -#}
{% set trusted_arr = [] -%}
{% for server in NTP_SERVER if NTP_SERVER[server].trusted == 'yes' and
                               NTP_SERVER[server].resolve_as -%}
    {% set _ = trusted_arr.append(NTP_SERVER[server].resolve_as | replace(' ', '') | replace('\t', '') | replace('\v', '') | replace('\f', '') | replace('\n', '') | replace('\r', '')) -%}
{% endfor -%}

{# Define authentication keys inventory -#}
{% set trusted_str = ' ' ~ trusted_arr|join(',') -%}
{% for keyid in NTP_KEY if NTP_KEY[keyid].type and NTP_KEY[keyid].value %}
{# The decoded key value can contain arbitrary bytes (base64 does not
constrain its payload), so it must be stripped here regardless of any
constraint placed on the encoded string. -#}
{% set keyval = (NTP_KEY[keyid].value | b64decode) | replace(' ', '') | replace('\t', '') | replace('\v', '') | replace('\f', '') | replace('\n', '') | replace('\r', '') %}
{{ keyid }} {{ NTP_KEY[keyid].type | upper }} {{ keyval }}{{trusted_str}}
{% endfor -%}
