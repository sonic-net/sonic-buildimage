# Initialize constants
INIT_CFG_JSON=/etc/sonic/init_cfg.json
CONFIG_DB_JSON=/etc/sonic/config_db.json
CONFIG_DB_PATH=/etc/sonic/
CONFIG_DB_PREFIX=config_db
CONFIG_DB_SUFFIX=.json
CONFIG_CLI=/usr/local/bin/config
DB_MIGRATOR=/usr/local/bin/db_migrator.py
MINGRAPH_FILE=/etc/sonic/minigraph.xml
GOLDEN_CONFIG_DB_JSON=/etc/sonic/golden_config_db.json
GOLDEN_CONFIG_NATIVE_ENABLED_FILE=/etc/sonic/golden_config_native_enabled
GOLDEN_NATIVE_TRANSITION_FILE=/etc/sonic/pending_golden_native_transition
GOLDEN_NATIVE_SEALED_DIR=/host/golden-native
GOLDEN_NATIVE_SEALED_CONFIG=${GOLDEN_NATIVE_SEALED_DIR}/golden_config_db.json
GOLDEN_NATIVE_SEALED_SHA256=${GOLDEN_NATIVE_SEALED_CONFIG}.sha256
GOLDEN_NATIVE_PREVIOUS_GOLD_ABSENT=${GOLDEN_CONFIG_DB_JSON}.pre_golden_native.absent
TMP_ZTP_CONFIG_DB_JSON=/tmp/ztp_config_db.json
FACTORY_DEFAULT_HOOKS=/etc/config-setup/factory-default-hooks.d
CONFIG_PRE_MIGRATION_HOOKS=/etc/config-setup/config-migration-pre-hooks.d
CONFIG_POST_MIGRATION_HOOKS=/etc/config-setup/config-migration-post-hooks.d
CONFIG_SETUP_VAR_DIR=/var/lib/config-setup
CONFIG_SETUP_PRE_MIGRATION_FLAG=${CONFIG_SETUP_VAR_DIR}/pending_pre_migration
CONFIG_SETUP_POST_MIGRATION_FLAG=${CONFIG_SETUP_VAR_DIR}/pending_post_migration
CONFIG_SETUP_INITIALIZATION_FLAG=${CONFIG_SETUP_VAR_DIR}/pending_initialization
CONFIG_SETUP_CONF=/etc/config-setup/config-setup.conf
PENDING_CONFIG_INITIALIZATION=/etc/sonic/pending_config_initialization
PENDING_CONFIG_MIGRATION=/etc/sonic/pending_config_migration
SONIC_DEVICE_PATH=/usr/share/sonic/device
OLD_CONFIG_PATH=/etc/sonic/old_config

TACACS_JSON_BACKUP=tacacs.json

# Command usage and help
usage()
{
    cat << EOF
 Usage:  config-setup < backup | boot | factory >

         backup  - Take a backup copy of SONiC configuration.
         boot    - Initialize/migrate SONiC configuration during system boot.
         factory - Create factory default SONiC configuration and save it to
                   to ${CONFIG_DB_JSON}.
EOF
}

# Factory command usage and help
usage_factory()
{
    cat << EOF
 Usage:  config-setup factory < keep-basic >

         Create factory default configuration and save it to
         to ${CONFIG_DB_JSON}.

         keep-basic  - Preserves basic configurations only.
EOF
}

recover_golden_native_transactions()
{
    "${CONFIG_CLI}" recover_golden_native_transactions --boot
    local status=$?

    if [ "${status}" -eq 3 ]; then
        echo "Golden-native recovery completed with an evidence-cleanup warning." >&2
        return 0
    fi
    return "${status}"
}

run_golden_native_commit()
{
    "$@"
    local status=$?

    if [ "${status}" -eq 3 ]; then
        echo "Golden-native configuration committed, but transaction-evidence cleanup failed; stale evidence will be retried by recovery." >&2
        return 0
    fi
    return "${status}"
}

sync_parent_directory()
{
    sync -d "$(dirname "$1")"
}

remove_file_durably()
{
    local path="$1"

    rm -f -- "${path}" || return $?
    sync_parent_directory "${path}"
}

replace_file_atomically()
{
    local source="$1"
    local destination="$2"
    local temporary="${destination}.golden-native-transition"

    if [ ! -f "${source}" ] || [ -L "${source}" ]; then
        echo "Golden-native transition source is not a regular file: ${source}" >&2
        return 1
    fi
    if [ -e "${temporary}" ] || [ -L "${temporary}" ]; then
        rm -f -- "${temporary}" || return $?
    fi

    cp -a -- "${source}" "${temporary}" || {
        rm -f -- "${temporary}"
        return 1
    }
    sync -f "${temporary}" || {
        rm -f -- "${temporary}"
        return 1
    }
    mv -f -- "${temporary}" "${destination}" || {
        rm -f -- "${temporary}"
        return 1
    }
    sync -f "${destination}" || return $?
    sync_parent_directory "${destination}" || return $?
    cmp -s -- "${source}" "${destination}"
}

write_golden_native_marker()
{
    local temporary="${GOLDEN_CONFIG_NATIVE_ENABLED_FILE}.golden-native-transition"

    if [ -e "${temporary}" ] || [ -L "${temporary}" ]; then
        rm -f -- "${temporary}" || return $?
    fi
    : > "${temporary}" || return $?
    chmod 0600 "${temporary}" || {
        rm -f -- "${temporary}"
        return 1
    }
    sync -f "${temporary}" || {
        rm -f -- "${temporary}"
        return 1
    }
    mv -f -- "${temporary}" "${GOLDEN_CONFIG_NATIVE_ENABLED_FILE}" || {
        rm -f -- "${temporary}"
        return 1
    }
    sync -f "${GOLDEN_CONFIG_NATIVE_ENABLED_FILE}" || return $?
    sync_parent_directory "${GOLDEN_CONFIG_NATIVE_ENABLED_FILE}"
}

read_golden_native_transition()
{
    local line_count
    local transition

    if [ ! -e "${GOLDEN_NATIVE_TRANSITION_FILE}" ]; then
        return 1
    fi
    if [ -L "${GOLDEN_NATIVE_TRANSITION_FILE}" ] || \
       [ ! -f "${GOLDEN_NATIVE_TRANSITION_FILE}" ]; then
        echo "Golden-native transition intent is not a regular file: ${GOLDEN_NATIVE_TRANSITION_FILE}" >&2
        return 2
    fi

    line_count=$(wc -l < "${GOLDEN_NATIVE_TRANSITION_FILE}") || return 2
    if [ "${line_count}" -ne 1 ]; then
        echo "Golden-native transition intent must contain exactly one line." >&2
        return 2
    fi
    transition=$(cat "${GOLDEN_NATIVE_TRANSITION_FILE}") || return 2
    case "${transition}" in
        enable|restore)
            printf '%s\n' "${transition}"
            ;;
        *)
            echo "Unknown golden-native transition intent: ${transition}" >&2
            return 2
            ;;
    esac
}

verify_golden_native_sealed_input()
{
    local recorded_hash
    local actual_hash

    for path in \
        "${GOLDEN_CONFIG_DB_JSON}" \
        "${GOLDEN_NATIVE_SEALED_CONFIG}" \
        "${GOLDEN_NATIVE_SEALED_SHA256}"; do
        if [ ! -f "${path}" ] || [ -L "${path}" ]; then
            echo "Golden-native enable recovery requires regular file ${path}." >&2
            return 1
        fi
    done

    recorded_hash=$(cat "${GOLDEN_NATIVE_SEALED_SHA256}") || return $?
    if [[ ! "${recorded_hash}" =~ ^[0-9a-fA-F]{64}$ ]]; then
        echo "Golden-native sealed SHA-256 is invalid." >&2
        return 1
    fi
    actual_hash=$(sha256sum -- "${GOLDEN_NATIVE_SEALED_CONFIG}") || return $?
    actual_hash=${actual_hash%% *}
    if [ "${actual_hash,,}" != "${recorded_hash,,}" ]; then
        echo "Golden-native sealed configuration SHA-256 mismatch." >&2
        return 1
    fi
    if ! cmp -s -- "${GOLDEN_CONFIG_DB_JSON}" "${GOLDEN_NATIVE_SEALED_CONFIG}"; then
        echo "Active and sealed golden-native configurations differ." >&2
        return 1
    fi
}

validate_golden_native_restore_inputs()
{
    local asic_num=0
    local backup
    local absence
    local expected_backup
    local discovered_backup
    local nullglob_was_set=false
    local expected_found
    local -a expected_backups=("${CONFIG_DB_JSON}.pre_golden_native")
    local -a discovered_backups=()

    while [[ $asic_num -lt ${NUM_ASIC:-1} && ${NUM_ASIC:-1} -gt 1 ]]; do
        expected_backups+=(
            "${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}${asic_num}${CONFIG_DB_SUFFIX}.pre_golden_native"
        )
        ((asic_num = asic_num + 1))
    done

    shopt -q nullglob && nullglob_was_set=true
    shopt -s nullglob
    discovered_backups=(
        "${CONFIG_DB_PATH}"${CONFIG_DB_PREFIX}*"${CONFIG_DB_SUFFIX}.pre_golden_native"
    )
    "${nullglob_was_set}" || shopt -u nullglob

    if [ "${#discovered_backups[@]}" -ne "${#expected_backups[@]}" ]; then
        echo "Golden-native recovery found an unexpected CONFIG_DB backup scope." >&2
        return 1
    fi

    for discovered_backup in "${discovered_backups[@]}"; do
        expected_found=false
        for expected_backup in "${expected_backups[@]}"; do
            if [ "${discovered_backup}" = "${expected_backup}" ]; then
                expected_found=true
                break
            fi
        done
        if ! "${expected_found}"; then
            echo "Golden-native recovery found unexpected CONFIG_DB backup ${discovered_backup}." >&2
            return 1
        fi
    done

    asic_num=0
    for backup in "${expected_backups[@]}"; do
        if [ ! -s "${backup}" ] || [ -L "${backup}" ]; then
            echo "Golden-native recovery requires non-empty regular backup ${backup}." >&2
            return 1
        fi
        validate_json_object_file \
            "${backup}" \
            "$(
                if [ "${asic_num}" -eq 0 ]; then
                    printf 'host CONFIG_DB'
                else
                    printf 'asic%s CONFIG_DB' "$((asic_num - 1))"
                fi
            )" || return $?
        ((asic_num = asic_num + 1))
    done

    backup="${MINGRAPH_FILE}.pre_golden_native"
    if [ ! -s "${backup}" ] || [ -L "${backup}" ]; then
        echo "Golden-native recovery requires non-empty regular backup ${backup}." >&2
        return 1
    fi

    backup="${GOLDEN_CONFIG_DB_JSON}.pre_golden_native"
    absence="${GOLDEN_NATIVE_PREVIOUS_GOLD_ABSENT}"
    if [ -e "${backup}" ] && [ -e "${absence}" ]; then
        echo "Golden-native recovery found conflicting previous-gold state." >&2
        return 1
    fi
    if [ -e "${backup}" ]; then
        if [ ! -s "${backup}" ] || [ -L "${backup}" ]; then
            echo "Golden-native recovery requires regular previous-gold backup ${backup}." >&2
            return 1
        fi
        validate_json_object_file "${backup}" "previous golden config" || return $?
        return 0
    fi
    if [ ! -f "${absence}" ] || [ -L "${absence}" ] || \
       [ "$(cat "${absence}")" != "absent" ] || \
       [ "$(wc -l < "${absence}")" -ne 1 ]; then
        echo "Golden-native recovery requires a valid previous-gold absence marker." >&2
        return 1
    fi
}

validate_json_object_file()
{
    local path="$1"
    local description="$2"

    python3 - "${path}" "${description}" <<'PY'
import json
import sys

path, description = sys.argv[1:]


def object_without_duplicates(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate key {!r}".format(key))
        result[key] = value
    return result


try:
    with open(path, encoding="utf-8") as stream:
        value = json.load(stream, object_pairs_hook=object_without_duplicates)
except (OSError, UnicodeError, ValueError) as error:
    print(
        "Golden-native recovery found invalid {} '{}': {}".format(
            description, path, error
        ),
        file=sys.stderr,
    )
    sys.exit(1)

if not isinstance(value, dict):
    print(
        "Golden-native recovery requires {} '{}' to contain a JSON object.".format(
            description, path
        ),
        file=sys.stderr,
    )
    sys.exit(1)
if not value:
    print(
        "Golden-native recovery requires {} '{}' to be non-empty.".format(
            description, path
        ),
        file=sys.stderr,
    )
    sys.exit(1)
PY
}

reload_restored_legacy_config()
{
    local asic_num=0
    local config_file_csv="${CONFIG_DB_JSON}"

    while [[ $asic_num -lt ${NUM_ASIC:-1} && ${NUM_ASIC:-1} -gt 1 ]]; do
        config_file_csv+=",${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}${asic_num}${CONFIG_DB_SUFFIX}"
        ((asic_num = asic_num + 1))
    done

    "${CONFIG_CLI}" reload -y -n -f "${config_file_csv}"
}

verify_live_config_db_scope()
{
    local source="$1"
    local scope="$2"
    local initialized
    local live_dump
    local -a db_cli=(sonic-db-cli)
    local -a cfggen=(sonic-cfggen)

    if [ "${scope}" != "localhost" ]; then
        db_cli+=(-n "${scope}")
        cfggen+=(-n "${scope}")
    fi

    initialized=$("${db_cli[@]}" CONFIG_DB GET CONFIG_DB_INITIALIZED) || {
        echo "Golden-native recovery could not read live CONFIG_DB initialization state for ${scope}." >&2
        return 1
    }
    if [ "${initialized}" != "1" ]; then
        echo "Golden-native recovery found uninitialized live CONFIG_DB state for ${scope}." >&2
        return 1
    fi

    live_dump=$(mktemp "${TMPDIR:-/tmp}/golden-native-live-config.XXXXXX") || return $?
    chmod 0600 "${live_dump}" || {
        rm -f -- "${live_dump}"
        return 1
    }
    if ! "${cfggen[@]}" -d --print-data > "${live_dump}"; then
        rm -f -- "${live_dump}"
        echo "Golden-native recovery could not read live CONFIG_DB state for ${scope}." >&2
        return 1
    fi

    python3 - "${source}" "${live_dump}" "${scope}" <<'PY'
import json
import sys

source_path, live_path, scope = sys.argv[1:]


def object_without_duplicates(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate key {!r}".format(key))
        result[key] = value
    return result


def load_object(path, description):
    with open(path, encoding="utf-8") as stream:
        value = json.load(stream, object_pairs_hook=object_without_duplicates)
    if not isinstance(value, dict):
        raise ValueError("{} must contain a JSON object".format(description))
    return value


def first_mismatch(expected, actual, path=""):
    for key, expected_value in expected.items():
        child_path = "{}.{}".format(path, key) if path else key
        if key not in actual:
            return "{} is missing".format(child_path)
        actual_value = actual[key]
        if isinstance(expected_value, dict):
            if not isinstance(actual_value, dict):
                return "{} is not an object".format(child_path)
            mismatch = first_mismatch(expected_value, actual_value, child_path)
            if mismatch:
                return mismatch
        elif actual_value != expected_value:
            return "{} does not match".format(child_path)
    return None


try:
    expected = load_object(source_path, "restored CONFIG_DB")
    actual = load_object(live_path, "live CONFIG_DB")
    mismatch = first_mismatch(expected, actual)
except (OSError, UnicodeError, ValueError) as error:
    print(
        "Golden-native recovery could not verify live CONFIG_DB for {}: {}".format(
            scope, error
        ),
        file=sys.stderr,
    )
    sys.exit(1)

if mismatch:
    print(
        "Golden-native recovery live CONFIG_DB mismatch for {}: {}".format(
            scope, mismatch
        ),
        file=sys.stderr,
    )
    sys.exit(1)
PY
    local status=$?
    rm -f -- "${live_dump}"
    return "${status}"
}

verify_restored_legacy_config()
{
    local asic_num=0

    verify_live_config_db_scope "${CONFIG_DB_JSON}" localhost || return $?
    while [[ $asic_num -lt ${NUM_ASIC:-1} && ${NUM_ASIC:-1} -gt 1 ]]; do
        verify_live_config_db_scope \
            "${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}${asic_num}${CONFIG_DB_SUFFIX}" \
            "asic${asic_num}" || return $?
        ((asic_num = asic_num + 1))
    done
}

golden_native_persisted_config_complete()
{
    if [[ ${NUM_ASIC:-1} -gt 1 ]]; then
        multi_asic_config_db_complete
    else
        [ -s "${CONFIG_DB_JSON}" ]
    fi
}

recover_golden_native_enable_transition()
{
    validate_golden_native_restore_inputs || return $?
    verify_golden_native_sealed_input || return $?
    validate_golden_config_native || return $?
    reload_golden_config_native || return $?
    golden_native_persisted_config_complete || {
        echo "Golden-native enable recovery did not persist a complete CONFIG_DB generation." >&2
        return 1
    }
    write_golden_native_marker || return $?
    remove_file_durably "${MINGRAPH_FILE}" || return $?
    [ -f "${GOLDEN_CONFIG_NATIVE_ENABLED_FILE}" ] || return 1
    [ ! -e "${MINGRAPH_FILE}" ] || return 1
    remove_file_durably "${GOLDEN_NATIVE_TRANSITION_FILE}" || return $?
    echo "Completed interrupted golden-native enable transition."
}

cleanup_golden_native_restore_inputs()
{
    local asic_num=0
    local backup

    rm -f -- "${CONFIG_DB_JSON}.pre_golden_native" \
        "${MINGRAPH_FILE}.pre_golden_native" \
        "${GOLDEN_CONFIG_DB_JSON}.pre_golden_native" \
        "${GOLDEN_NATIVE_PREVIOUS_GOLD_ABSENT}" || return $?
    while [[ $asic_num -lt ${NUM_ASIC:-1} && ${NUM_ASIC:-1} -gt 1 ]]; do
        backup="${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}${asic_num}${CONFIG_DB_SUFFIX}.pre_golden_native"
        rm -f -- "${backup}" || return $?
        ((asic_num = asic_num + 1))
    done
    rm -rf -- "${GOLDEN_NATIVE_SEALED_DIR}" || return $?
    sync_parent_directory "${CONFIG_DB_JSON}"
}

recover_golden_native_restore_transition()
{
    local asic_num=0
    local source
    local destination
    local -a sources=("${CONFIG_DB_JSON}.pre_golden_native")
    local -a destinations=("${CONFIG_DB_JSON}")

    while [[ $asic_num -lt ${NUM_ASIC:-1} && ${NUM_ASIC:-1} -gt 1 ]]; do
        sources+=(
            "${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}${asic_num}${CONFIG_DB_SUFFIX}.pre_golden_native"
        )
        destinations+=(
            "${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}${asic_num}${CONFIG_DB_SUFFIX}"
        )
        ((asic_num = asic_num + 1))
    done

    sources+=("${MINGRAPH_FILE}.pre_golden_native")
    destinations+=("${MINGRAPH_FILE}")

    validate_golden_native_restore_inputs || return $?

    for index in "${!sources[@]}"; do
        replace_file_atomically \
            "${sources[$index]}" \
            "${destinations[$index]}" || return $?
    done

    for index in "${!sources[@]}"; do
        cmp -s -- "${sources[$index]}" "${destinations[$index]}" || return 1
    done

    remove_file_durably "${GOLDEN_CONFIG_NATIVE_ENABLED_FILE}" || return $?
    if [ -e "${GOLDEN_CONFIG_DB_JSON}.pre_golden_native" ]; then
        replace_file_atomically \
            "${GOLDEN_CONFIG_DB_JSON}.pre_golden_native" \
            "${GOLDEN_CONFIG_DB_JSON}" || return $?
    else
        remove_file_durably "${GOLDEN_CONFIG_DB_JSON}" || return $?
    fi

    [ ! -e "${GOLDEN_CONFIG_NATIVE_ENABLED_FILE}" ] || return 1
    if [ -e "${GOLDEN_CONFIG_DB_JSON}.pre_golden_native" ]; then
        cmp -s -- \
            "${GOLDEN_CONFIG_DB_JSON}.pre_golden_native" \
            "${GOLDEN_CONFIG_DB_JSON}" || return 1
    elif [ -e "${GOLDEN_CONFIG_DB_JSON}" ]; then
        return 1
    fi

    reload_restored_legacy_config || return $?
    verify_restored_legacy_config || return $?

    remove_file_durably "${GOLDEN_NATIVE_TRANSITION_FILE}" || return $?
    cleanup_golden_native_restore_inputs || \
        echo "Golden-native restore completed, but recovery-input cleanup failed." >&2
    echo "Completed interrupted golden-native restore transition."
}

recover_golden_native_transition()
{
    local transition
    local status

    transition=$(read_golden_native_transition)
    status=$?
    if [ "${status}" -eq 1 ]; then
        return 0
    fi
    if [ "${status}" -ne 0 ]; then
        return "${status}"
    fi

    case "${transition}" in
        enable)
            recover_golden_native_enable_transition
            ;;
        restore)
            recover_golden_native_restore_transition
            ;;
    esac
}

# run given script
run_hook() {
    local script="$1"
    local script_param="$2"
    local exit_status=0

    if [ -f $script ]; then
        # Check hook for syntactical correctness before executing it
        /bin/bash -n $script $script_param
        exit_status=$?
        if [ "$exit_status" -eq 0 ]; then
            . $script $script_param
        fi
        exit_status=$?
    fi

    if [ -n "$exit_status" ] && [ "$exit_status" -ne 0 ]; then
        echo "$script returned non-zero exit status $exit_status"
    fi

    return $exit_status
}

# run scripts in given directory
run_hookdir() {
    local dir="$1"
    local progress_file="$2"
    local script_param="$3"
    local exit_status=0

    if [ -d "$dir" ]; then
        if [ -n $progress_file ]; then
            [ ! -d  $(dirname $progress_file) ] && mkdir -p $(dirname $progress_file)
            [ ! -e $progress_file  ] &&  run-parts --list $dir > $progress_file
            SCRIPT_LIST=$(cat $progress_file)
        else
            SCRIPT_LIST=$(run-parts --list $dir)
        fi

        for script in $SCRIPT_LIST; do
            run_hook $script $script_param
            exit_status=$((exit_status|$?))
            script_name=$(basename $script)
            sed -i "/$script_name/d" $progress_file
        done
        [ -n $progress_file ] && [ "$(cat ${progress_file})" = "" ] && rm -f ${progress_file}
    fi

    return $exit_status
}

# Load minigraph.xml file on disk
load_minigraph()
{
    echo "Reloading minigraph..."
    if [ -f ${GOLDEN_CONFIG_DB_JSON} ]; then
        config load_minigraph -y -n --override_config --golden_config_path ${GOLDEN_CONFIG_DB_JSON} || return $?
    else
        config load_minigraph -y -n || return $?
    fi
}

# Reload minigraph.xml file on disk
reload_minigraph()
{
    echo "Reloading minigraph..."
    load_minigraph
    config save -y
}

golden_config_native_enabled()
{
    [ -f ${GOLDEN_CONFIG_NATIVE_ENABLED_FILE} ]
}

validate_golden_config_native()
{
    if [ ! -r ${GOLDEN_CONFIG_DB_JSON} ]; then
        echo "Golden-native configuration is enabled but ${GOLDEN_CONFIG_DB_JSON} is not readable."
        return 1
    fi

    "${CONFIG_CLI}" load_golden_config --check-only ${GOLDEN_CONFIG_DB_JSON}
}

migrate_golden_config_native()
{
    if [ ! -r ${GOLDEN_CONFIG_DB_JSON} ]; then
        echo "Golden-native configuration is enabled but ${GOLDEN_CONFIG_DB_JSON} is not readable."
        return 1
    fi

    run_golden_native_commit \
        "${CONFIG_CLI}" load_golden_config -y --migrate-only --persist \
        "$@" ${GOLDEN_CONFIG_DB_JSON}
}

reload_golden_config_native()
{
    echo "Reloading complete golden config without minigraph..."
    run_golden_native_commit \
        "${CONFIG_CLI}" load_golden_config -y --persist -f \
        ${GOLDEN_CONFIG_DB_JSON}
}

# Apply tacacs config
apply_tacacs()
{
    if [ -r /etc/sonic/old_config/${TACACS_JSON_BACKUP} ]; then
        sonic-cfggen -j /etc/sonic/old_config/${TACACS_JSON_BACKUP} --write-to-db || return $?
        echo "Applied tacacs json to restore tacacs credentials"
        config save -y || return $?

        # Change tacacs config file name, so tacacs config will not be revert when device reboot.
        mv /etc/sonic/old_config/${TACACS_JSON_BACKUP} /etc/sonic/old_config/${TACACS_JSON_BACKUP}_backup || return $?
    else
        echo "Missing tacacs json to restore tacacs credentials"
    fi
}

# Reload existing config db file on disk
# Usage: reload_configdb <config_file>
reload_configdb()
{
    CONFIG_FILE=${1}

    echo "Reloading existing config db..."
    config reload ${CONFIG_FILE} -y -n
}

# Restore SONiC configuration from a backup copy
copy_config_files_and_directories()
{
    for file_dir in $@; do
        if [ -f ${OLD_CONFIG_PATH}/${file_dir} ] || [ -d ${OLD_CONFIG_PATH}/${file_dir} ]; then
            echo "Copying SONiC configuration ${file_dir} ..."
            cp -ar ${OLD_CONFIG_PATH}/${file_dir} /etc/sonic/ || return $?
        else
            echo "Missing SONiC configuration ${file_dir} ..."
        fi
    done
}

# Check if SONiC switch has booted after a warm reboot request.
# Prefers STATE_DB when available (reflects true warm boot state and
# gets cleared after warm boot completes). Falls back to /proc/cmdline
# only during the "boot" command when database services may not be up yet.
check_system_warm_boot()
{
    WARM_BOOT="false"

    # Try STATE_DB first — authoritative source that reflects current
    # warm boot state and is cleared after warm boot completes.
    SYSTEM_WARM_START=$(sonic-db-cli STATE_DB hget "WARM_RESTART_ENABLE_TABLE|system" enable)
    DB_RC=$?

    if [ $DB_RC -eq 0 ]; then
        # DB is reachable — use its answer exclusively
        if [[ x"$SYSTEM_WARM_START" == x"true" ]]; then
            WARM_BOOT="true"
        fi
        return
    fi

    # DB not available — fall back to /proc/cmdline only during boot,
    # when database services may not have started yet.
    # Outside of boot context, /proc/cmdline may contain a stale
    # SONIC_BOOT_TYPE=warm from a previous warm reboot.
    if [ "$CMD" = "boot" ]; then
        case "$(cat /proc/cmdline)" in
        *SONIC_BOOT_TYPE=warm*)
            WARM_BOOT="true"
            ;;
        esac
    fi
}

# Check if Zero Touch Provisioning is available and is administratively enabled
ztp_is_enabled()
{
    rv=1
    if [ -e /usr/bin/ztp ]; then
        status=$(ztp status -c)
        [ "$status" != "0:DISABLED" ] && [ "$status" != "" ] && rv=0
    fi
    return $rv
}

set_config_db_initialized()
{
    local value="$1"
    local asic_num=0

    sonic-db-cli CONFIG_DB SET "CONFIG_DB_INITIALIZED" "$value" || return $?

    if [[ ${NUM_ASIC:-1} -le 1 ]]; then
        return 0
    fi

    while [[ $asic_num -lt $NUM_ASIC ]]; do
        sonic-db-cli -n "asic$asic_num" CONFIG_DB SET "CONFIG_DB_INITIALIZED" "$value" || return $?
        ((asic_num = asic_num + 1))
    done
}

# Generate requested SONiC configuration and save it as destination file
# Usage: generate_config < factory | ztp > <destination_file>
#
#        factory - Create factory default configuration
#        ztp - Create Zero Touch Provisioning Configuration
#              used for provisioning data discovery.
#
generate_config()
{
    # Collect all information needed to generate configuration
    PLATFORM=${PLATFORM:-`sonic-cfggen -H -v DEVICE_METADATA.localhost.platform`}
    PRESET=(`head -n 1 /usr/share/sonic/device/$PLATFORM/default_sku`)
    HW_KEY=${PRESET[0]}
    DEFAULT_PRESET=${PRESET[1]}

    # Parse arguments passed
    CONFIG_TYPE=$1
    DEST_FILE=$2

    if [ "$1" = "ztp" ]; then
        /usr/lib/ztp/ztp-profile.sh create ${DEST_FILE}
    elif [ "$1" = "factory" ]; then
        FACTORY_TYPE=$3
        rv=1

        if [ "$FACTORY_TYPE" = "keep-basic" ]; then
            TMP_FILE="/tmp/tmp_keep_basic.$$.json"
            # Verify the DEST_FILE exists and KEEP_BASIC_TABLES was defined in CONFIG_SETUP_CONF
            if [ ! -f ${DEST_FILE} ] || [ -z "${KEEP_BASIC_TABLES}" ]; then
                # Create empty valid json file
                echo {} > ${TMP_FILE}
            else
                # Create filtered json file with keep-basic tables only
                jq 'with_entries(select([.key] | inside($tables)))' --argjson tables "$KEEP_BASIC_TABLES" ${DEST_FILE} > ${TMP_FILE}
            fi
            # Create factory default
            sonic-cfggen -H -k ${HW_KEY} --preset ${DEFAULT_PRESET}  > ${DEST_FILE}
            rv=$?
            if [ $rv -ne 0 ]; then
                rm -f ${TMP_FILE}
                return $rv
            fi
            # Merge factory default config with filtered json
            jq --indent 4 -s '.[0] * .[1]' ${DEST_FILE} ${TMP_FILE} > tmp.$$.json && mv tmp.$$.json ${DEST_FILE}
            rm -f ${TMP_FILE}
        fi

        # Execute config initialization hooks
        run_hookdir ${FACTORY_DEFAULT_HOOKS} ${CONFIG_SETUP_INITIALIZATION_FLAG} ${FACTORY_TYPE}

        # Use preset defined in default_sku
        if [ ! -e ${DEST_FILE} ]; then
            sonic-cfggen -H -k ${HW_KEY} --preset ${DEFAULT_PRESET} > ${DEST_FILE}
            rv=$?
            if [ $rv -ne 0 ]; then
                return $rv
            fi
        fi
    fi
    return 0
}

# Create SONiC configuration for first time bootup
#  - If minigraph.xml is available, use it to generate configuration
#  - If ZTP is enabled and no minigraph, ZTP configuration is created
#  - If ZTP is disabled and no minigraph, factory default configuration
#    is created
do_config_initialization()
{
    if golden_config_native_enabled; then
        echo "No config_db.json found and golden-native configuration is enabled, using complete gold..."
        reload_golden_config_native || return $?
        rm -f ${PENDING_CONFIG_INITIALIZATION} || return $?
        return 0
    fi

    # If minigraph.xml is available, prefer it over ZTP/factory default.
    # This avoids ZTP triggering a config reload that removes management IP
    # when the device has a valid minigraph but no config_db.json
    # (e.g., during upgrade path tests).
    if [ -r ${MINGRAPH_FILE} ]; then
        echo "No config_db.json found but minigraph.xml is available, using minigraph..."
        reload_minigraph || return $?
        set_config_db_initialized "1" || return $?
        rm -f ${PENDING_CONFIG_INITIALIZATION} || return $?
        return 0
    fi

    if ! ztp_is_enabled ; then
        echo "No configuration detected, generating factory default configuration..."
        generate_config factory ${CONFIG_DB_JSON} || return $?
        reload_configdb ${CONFIG_DB_JSON} || return $?
    fi

    if  ztp_is_enabled ; then
        echo "No configuration detected, initiating zero touch provisioning..."
        generate_config ztp ${TMP_ZTP_CONFIG_DB_JSON} || return $?
        reload_configdb ${TMP_ZTP_CONFIG_DB_JSON} || return $?
        rm -f ${TMP_ZTP_CONFIG_DB_JSON} || return $?
    fi

    set_config_db_initialized "1" || return $?
    rm -f ${PENDING_CONFIG_INITIALIZATION} || return $?
    return 0
}

# Not supported on chassis platforms (provisioned by minigraph or a migrated
# config) or on fast/express boot
multi_asic_config_initialization_supported()
{
    if [ -f ${SONIC_DEVICE_PATH}/$PLATFORM/chassisdb.conf ]; then
        echo "Chassis platform detected, skipping multi-npu config initialization."
        return 1
    fi

    case "$(cat /proc/cmdline)" in
    *SONIC_BOOT_TYPE=fast*|*SONIC_BOOT_TYPE=express*|*fast-reboot*)
        echo "Fast boot detected, skipping multi-npu config initialization."
        return 1
        ;;
    esac

    return 0
}

golden_config_native_multi_asic_supported()
{
    if [[ ${NUM_ASIC:-1} -le 1 ]]; then
        return 0
    fi

    if [ -f ${SONIC_DEVICE_PATH}/${PLATFORM}/chassisdb.conf ]; then
        echo "Golden-native configuration supports only single-host multi-ASIC systems; chassis platforms remain unsupported."
        return 1
    fi

    return 0
}

preflight_golden_config_native_migration()
{
    local marker_name=${GOLDEN_CONFIG_NATIVE_ENABLED_FILE##*/}
    local gold_name=${GOLDEN_CONFIG_DB_JSON##*/}
    local migration_gold

    if [ -f "${OLD_CONFIG_PATH}/${marker_name}" ]; then
        migration_gold="${OLD_CONFIG_PATH}/${gold_name}"
    elif golden_config_native_enabled; then
        migration_gold="${GOLDEN_CONFIG_DB_JSON}"
    else
        return 0
    fi

    golden_config_native_multi_asic_supported || return $?
    "${CONFIG_CLI}" load_golden_config --check-only "${migration_gold}"
}

# config_db.json and every config_db<N>.json exist and are not empty
multi_asic_config_db_complete()
{
    local asic_num=0

    [ -s ${CONFIG_DB_JSON} ] || return 1
    while [[ $asic_num -lt $NUM_ASIC ]]; do
        [ -s ${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}$asic_num${CONFIG_DB_SUFFIX} ] || return 1
        ((asic_num = asic_num + 1))
    done

    return 0
}

# Neither config_db.json nor any config_db<N>.json exists
multi_asic_config_db_absent()
{
    local asic_num=0

    [ -e ${CONFIG_DB_JSON} ] && return 1
    while [[ $asic_num -lt $NUM_ASIC ]]; do
        [ -e ${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}$asic_num${CONFIG_DB_SUFFIX} ] && return 1
        ((asic_num = asic_num + 1))
    done

    return 0
}

# Generate factory default for each missing or empty config db file and
# install them only if all succeed. A generated ASIC file needs a sub_role
# (multi-npu CLI and daemons fail without one) and, unless the preset is
# "empty", ports
generate_multi_asic_factory_config()
{
    local asic_num=-1
    local file
    local error
    local tmp_suffix=".factory.$$"
    local -a ns_option
    local -a generated=()

    read -r -a PRESET <<< "$(head -n 1 /usr/share/sonic/device/$PLATFORM/default_sku 2>/dev/null)"
    HW_KEY=${PRESET[0]}
    DEFAULT_PRESET=${PRESET[1]}
    if [ -z "${HW_KEY}" ] || [ -z "${DEFAULT_PRESET}" ]; then
        echo "No HwSKU/preset found in /usr/share/sonic/device/$PLATFORM/default_sku, cannot generate factory default configuration"
        return 1
    fi

    # Execute config initialization hooks
    run_hookdir ${FACTORY_DEFAULT_HOOKS} ${CONFIG_SETUP_INITIALIZATION_FLAG}

    # Remove files left by an interrupted run
    rm -f ${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}*${CONFIG_DB_SUFFIX}.factory.*

    while [[ $asic_num -lt $NUM_ASIC ]]; do
        if [[ $asic_num -lt 0 ]]; then
            file=${CONFIG_DB_JSON}
            ns_option=()
        else
            file=${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}$asic_num${CONFIG_DB_SUFFIX}
            ns_option=(-n "asic$asic_num")
        fi
        ((asic_num = asic_num + 1))

        if [ -s ${file} ]; then
            echo "Keeping existing ${file}"
            continue
        fi

        error=
        if ! sonic-cfggen -H -k ${HW_KEY} "${ns_option[@]}" --preset ${DEFAULT_PRESET} > ${file}${tmp_suffix} || \
           ! jq -e 'type == "object"' ${file}${tmp_suffix} > /dev/null 2>&1; then
            error="sonic-cfggen failed"
        elif [[ ${#ns_option[@]} -gt 0 ]] && \
             ! jq -e '.DEVICE_METADATA.localhost.sub_role | type == "string" and length > 0' ${file}${tmp_suffix} > /dev/null 2>&1; then
            error="no sub_role, check SUB_ROLE_ASIC_$((asic_num - 1)) in ${ASIC_CONF}"
        elif [[ ${#ns_option[@]} -gt 0 && ${DEFAULT_PRESET} != empty ]] && \
             ! jq -e '.PORT | type == "object" and length > 0' ${file}${tmp_suffix} > /dev/null 2>&1; then
            error="no ports, check the port config of asic$((asic_num - 1))"
        fi
        if [ -n "${error}" ]; then
            echo "Failed to generate factory default configuration ${file}: ${error}"
            rm -f ${file}${tmp_suffix}
            for file in "${generated[@]}"; do
                rm -f ${file}${tmp_suffix}
            done
            return 1
        fi
        generated+=("${file}")
    done

    for file in "${generated[@]}"; do
        mv -f ${file}${tmp_suffix} ${file}
        echo "Generated factory default configuration ${file}"
    done

    return 0
}

# Create SONiC configuration for first time bootup of a multi-npu platform
do_multi_asic_config_initialization()
{
    if ! multi_asic_config_initialization_supported; then
        return 0
    fi

    if multi_asic_config_db_complete; then
        echo "All config db files are present, loading them..."
        reload_configdb || echo "Failed to load config db files"
    # Minigraph replaces every namespace, so skip it for a partial set
    elif multi_asic_config_db_absent && [ -r ${MINGRAPH_FILE} ]; then
        echo "No config db files found but minigraph.xml is available, using minigraph..."
        # Saving after a failed load would leave near-empty config db files
        # that count as complete on the next boot
        if load_minigraph; then
            config save -y
        else
            echo "Failed to load minigraph"
        fi
    else
        if ztp_is_enabled ; then
            echo "Zero touch provisioning is not supported on multi-npu platforms, using factory default configuration..."
        fi
        echo "No configuration detected, generating factory default configuration..."
        if generate_multi_asic_factory_config; then
            reload_configdb || echo "Failed to load factory default configuration"
        fi
    fi

    # Set even after a failure so that swss starts, as on single-npu; the
    # missing config db files trigger another attempt on the next boot
    rm -f /etc/sonic/pending_config_initialization
    set_config_db_initialized "1"
}

# Restore config-setup post migration hooks from a backup copy
copy_post_migration_hooks()
{
    BACKUP_DIR=/etc/sonic/old_config/config-migration-post-hooks.d
    if [ -d ${BACKUP_DIR} ]; then
        [ -d ${CONFIG_POST_MIGRATION_HOOKS} ] || mkdir -p ${CONFIG_POST_MIGRATION_HOOKS}
        for hook in $(ls -1 ${BACKUP_DIR}) ; do
            if [ ! -e ${CONFIG_POST_MIGRATION_HOOKS}/$hook ]; then
                cp -ar ${BACKUP_DIR}/$hook ${CONFIG_POST_MIGRATION_HOOKS}
            fi
        done
    fi
}

# Get the list of config db for both
# single and multi-npu platforms
get_config_db_file_list()
{
    config_db_file_list=${CONFIG_DB_PREFIX}${CONFIG_DB_SUFFIX}
    asic_num=0
    while [[ ($asic_num -lt $NUM_ASIC) && ($NUM_ASIC -gt 1) ]]; do
        config_db_file_list+=' '${CONFIG_DB_PREFIX}$asic_num${CONFIG_DB_SUFFIX}
        ((asic_num = asic_num + 1))
    done

    echo $config_db_file_list
}

# Check if a given ASIC namespace has booted warm or fast.
# On multi-npu platforms individual ASICs can be excluded from a
# warm/fast reboot, in which case they cold boot while the system as a
# whole is warm booting.
check_namespace_warm_fast_boot()
{
    local -r namespace="$1"
    local -r warm_boot=$(sonic-db-cli -n "$namespace" STATE_DB hget "WARM_RESTART_ENABLE_TABLE|system" enable)
    local -r fast_boot=$(sonic-db-cli -n "$namespace" STATE_DB hget "FAST_RESTART_ENABLE_TABLE|system" enable)

    [[ x"$warm_boot" == x"true" || x"$fast_boot" == x"true" ]]
}

# Load config db of the ASIC namespaces that were excluded from a
# warm/fast reboot. Their database was not restored from a redis dump,
# and the database container could not load the config db file either
# because it is only restored from the previous image by
# do_config_migration, which runs after the database container starts.
load_cold_booted_namespaces()
{
    local -a cold_namespaces=()
    local -a cold_config_files=()
    local config_db_file
    local asic_num=0
    local index
    local namespace
    local status

    while [[ ($asic_num -lt $NUM_ASIC) && ($NUM_ASIC -gt 1) ]]; do
        config_db_file=${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}$asic_num${CONFIG_DB_SUFFIX}
        if [[ ! -r "$config_db_file" ]]; then
            echo "Required namespace config file is not readable: ${config_db_file}" >&2
            return 1
        fi
        ((asic_num = asic_num + 1))
    done

    asic_num=0
    while [[ ($asic_num -lt $NUM_ASIC) && ($NUM_ASIC -gt 1) ]]; do
        config_db_file=${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}$asic_num${CONFIG_DB_SUFFIX}
        if ! check_namespace_warm_fast_boot "asic$asic_num"; then
            cold_namespaces+=("asic$asic_num")
            cold_config_files+=("$config_db_file")
        fi
        ((asic_num = asic_num + 1))
    done

    for index in "${!cold_namespaces[@]}"; do
        namespace=${cold_namespaces[$index]}
        config_db_file=${cold_config_files[$index]}
        if [ -r "${INIT_CFG_JSON}" ]; then
            sonic-cfggen -n "$namespace" -j "${INIT_CFG_JSON}" \
                -j "$config_db_file" --print-data >/dev/null
        else
            sonic-cfggen -n "$namespace" -j "$config_db_file" \
                --print-data >/dev/null
        fi
        status=$?
        if [[ $status -ne 0 ]]; then
            return $status
        fi
    done

    for index in "${!cold_namespaces[@]}"; do
        namespace=${cold_namespaces[$index]}
        config_db_file=${cold_config_files[$index]}
        echo "${namespace} did not warm reboot, loading ${config_db_file} ..."
        if [ -r "${INIT_CFG_JSON}" ]; then
            sonic-cfggen -n "$namespace" -j "${INIT_CFG_JSON}" \
                -j "$config_db_file" --write-to-db
        else
            sonic-cfggen -n "$namespace" -j "$config_db_file" --write-to-db
        fi
        status=$?
        if [[ $status -ne 0 ]]; then
            return $status
        fi
    done
}

collect_cold_booted_namespace_configs()
{
    local asic_num=0
    local config_db_file

    COLD_NAMESPACE_CONFIG_ARGS=()
    while [[ ($asic_num -lt $NUM_ASIC) && ($NUM_ASIC -gt 1) ]]; do
        config_db_file=${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}$asic_num${CONFIG_DB_SUFFIX}
        if [[ ! -r "$config_db_file" ]]; then
            echo "Required namespace config file is not readable: ${config_db_file}" >&2
            return 1
        fi
        if ! check_namespace_warm_fast_boot "asic$asic_num"; then
            COLD_NAMESPACE_CONFIG_ARGS+=(
                --preload-namespace-config
                "asic$asic_num"
                "$config_db_file"
            )
        fi
        ((asic_num = asic_num + 1))
    done
}

# Check if all needed config db are present for both
# single and multi-npu platforms
check_all_config_db_present()
{
    if [[ ! -r ${CONFIG_DB_JSON} ]]; then
       return 1
    fi
    asic_num=0
    while [[ ($asic_num -lt $NUM_ASIC) && ($NUM_ASIC -gt 1) ]]; do
        if [[ ! -r ${CONFIG_DB_PATH}${CONFIG_DB_PREFIX}$asic_num${CONFIG_DB_SUFFIX} ]]; then
            return 1
        fi
        ((asic_num = asic_num + 1))
    done

    return 0   
}

# DB schema is subject to change between two images
# Perform DB schema migration after loading backup config/minigraph from previous image
do_db_migration()
{
    local skip_schema_migration=${1:-false}
    local -a db_migrator_args

    if [[ "${skip_schema_migration}" != "true" ]]; then
        if [[ -x ${DB_MIGRATOR} ]]; then
            db_migrator_args=(-o migrate)
            if golden_config_native_enabled; then
                db_migrator_args+=(--config-source golden --config-source-file "${GOLDEN_CONFIG_DB_JSON}")
            fi

            # Migrate the DB to the latest schema version if needed
            "${DB_MIGRATOR}" "${db_migrator_args[@]}" || return $?
        fi
        set_config_db_initialized "1" || return $?
    fi

    # Enforce CHASSIS_APP_DB.tsa_enabled to be in sync with BGP_DEVICE_GLOBAL.STATE.tsa_enabled when chassis TSA uses CHASSIS_APP_DB
    if [[ -f /etc/sonic/chassisdb.conf ]] && [[ $disaggregated_chassis -ne 1 ]]; then
       chassis_tsa_supported_cfg="$(sonic-db-cli CONFIG_DB HGET "BGP_DEVICE_GLOBAL|STATE" "chassis_tsa_supported")"
       if [[ "$chassis_tsa_supported_cfg" == "true" ]]; then
           tsa_cfg="$(sonic-db-cli CONFIG_DB HGET "BGP_DEVICE_GLOBAL|STATE" "tsa_enabled")"
           sonic-db-cli CHASSIS_APP_DB HMSET "BGP_DEVICE_GLOBAL|STATE" tsa_enabled ${tsa_cfg}
           OP_CODE=$?

           if [ $OP_CODE -ne 0 ]; then
             err_msg="Cmd failed (exit code $OP_CODE). CHASSIS_APP_DB and CONFIG_DB may be incosistent wrt tsa_enabled."
             echo "$err_msg"
             logger -t CHASSIS_APP_DB -p user.info "$err_msg"
           fi
       fi
    fi
}

# Perform configuration migration from backup copy.
#  - This step is performed when a new image is installed and SONiC switch boots into it
do_config_migration()
{
    # Identify list of files to migrate
    copy_list="minigraph.xml snmp.yml acl.json port_config.json frr telemetry credentials golden_config_db.json golden_config_native_enabled hft otel_config.yml"

    # Validate the old-system golden-native source and trusted local platform
    # before copying any persistent state into the new image.
    preflight_golden_config_native_migration || return $?

    # Migrate all configuration files from old to new
    copy_config_files_and_directories $copy_list || return $?

    # Migrate all config_db from old to new
    copy_config_files_and_directories $(get_config_db_file_list) || return $?

    # Migrate post-migration hooks
    copy_post_migration_hooks || return $?

    # Execute custom hooks if present
    run_hookdir ${CONFIG_POST_MIGRATION_HOOKS} ${CONFIG_SETUP_POST_MIGRATION_FLAG} || return $?

    if [ x"${WARM_BOOT}" == x"true" ]; then
        echo "Warm reboot detected..."
        if golden_config_native_enabled; then
            collect_cold_booted_namespace_configs || return $?
            migrate_golden_config_native \
                "${COLD_NAMESPACE_CONFIG_ARGS[@]}" || return $?
            do_db_migration true || return $?
        else
            load_cold_booted_namespaces || return $?
            do_db_migration || return $?
        fi
    elif golden_config_native_enabled; then
        echo "Golden-native configuration is enabled, using complete gold from old system..."
        reload_golden_config_native || return $?
        do_db_migration true || return $?
    elif check_all_config_db_present; then
        echo "Use config_db.json from old system..."
        reload_configdb || return $?
        do_db_migration || return $?
    elif [ -r ${MINGRAPH_FILE} ]; then
        echo "Use minigraph.xml from old system..."
        reload_minigraph || return $?
        do_db_migration || return $?
    else
        echo "No persistent configuration found to migrate; continuing with initialization."
    fi

    rm -f ${PENDING_CONFIG_MIGRATION} || return $?
}

# Take a backup of current SONiC configuration
do_config_backup()
{
    echo "Taking backup of current configuration"
    rm -rf /host/old_config || return $?
    cp -ar /etc/sonic /host/old_config || return $?
    if [ -d ${CONFIG_POST_MIGRATION_HOOKS} ]; then
        cp -arL ${CONFIG_POST_MIGRATION_HOOKS} /host/old_config || return $?
    fi

    # Execute custom hooks if present
    run_hookdir ${CONFIG_PRE_MIGRATION_HOOKS} ${CONFIG_SETUP_PRE_MIGRATION_FLAG}
}

# Process switch bootup event
#  - Check if it is warm boot and take no further action
#  - Perform configuration migration if requested
#  - Perform configuration initialization if requested
#  - If no saved SONiC configuration is found and ZTP is enabled,
#    start ZTP
boot_config()
{
    local config_migrated=false

    check_system_warm_boot || return $?
    if [ -e ${PENDING_CONFIG_MIGRATION} ] || [ -e  ${CONFIG_SETUP_POST_MIGRATION_FLAG} ]; then
        do_config_migration || return $?
        config_migrated=true
    fi

    # During warm boot the existing configuration must be preserved.
    # Never run config initialization or ZTP — doing so would generate
    # a new config and trigger config reload, wiping management IP.
    if [ x"${WARM_BOOT}" == x"true" ]; then
        echo "Warm boot detected, skipping config initialization and ZTP."
        # Mark config as initialized so subsequent boots don't re-trigger
        # initialization unnecessarily (warm-reboot to new image scenario).
        if [ x"${config_migrated}" != x"true" ]; then
            set_config_db_initialized "1" || return $?
        fi
        rm -f ${PENDING_CONFIG_INITIALIZATION} || return $?
        return 0
    fi

    # Multi-npu adds a config db file per ASIC namespace; these are missing
    # e.g. on the first boot after an ONIE install with nothing to migrate.
    if [[ ($NUM_ASIC -gt 1) ]]; then
        if golden_config_native_enabled; then
            golden_config_native_multi_asic_supported || return $?
            if ! multi_asic_config_initialization_supported; then
                return 0
            fi
            if [ -e ${PENDING_CONFIG_INITIALIZATION} ] || \
               [ -e ${CONFIG_SETUP_INITIALIZATION_FLAG} ] || \
               ! multi_asic_config_db_complete; then
                do_config_initialization || return $?
            fi
            return 0
        fi
        if [ -e /etc/sonic/pending_config_initialization ] || \
           ! multi_asic_config_db_complete; then
            do_multi_asic_config_initialization
        fi
        return 0
    fi

    if [ -e ${PENDING_CONFIG_INITIALIZATION} ] || [ -e  ${CONFIG_SETUP_INITIALIZATION_FLAG} ]; then
        do_config_initialization || return $?
    fi

    # If no startup configuration is found, create a configuration to be used.
    # do_config_initialization() will prefer minigraph.xml if available,
    # falling back to ZTP or factory default only when no minigraph exists.
    if [ ! -e ${CONFIG_DB_JSON} ]; then
        do_config_initialization || return $?
        # force ZTP to restart (only relevant when ZTP was actually used,
        # i.e., when minigraph.xml was not available)
        if ! golden_config_native_enabled && [ ! -e ${MINGRAPH_FILE} ] && ztp_is_enabled ; then
            ztp_status=$(ztp status -c)
            if [ "$ztp_status" = "5:SUCCESS" ] || \
          [ "$ztp_status" = "6:FAILED" ]; then
                # Clear completed ztp information, before starting a new one
                ztp erase -y || return $?
            else
                touch /tmp/pending_ztp_restart || return $?
            fi
        fi
    fi

    return 0
}

main()
{
    CMD=${1:-}
    if [ "${CMD}" = "boot" ]; then
        recover_golden_native_transactions || return $?
    fi

    # read SONiC immutable variables
    [ -f /etc/sonic/sonic-environment ] && . /etc/sonic/sonic-environment

    # read config-setup.conf
    [ -f $CONFIG_SETUP_CONF ] && . $CONFIG_SETUP_CONF

    PLATFORM=${PLATFORM:-`sonic-cfggen -H -v DEVICE_METADATA.localhost.platform`}
    # Parse the device specific asic conf file, if it exists
    ASIC_CONF=/usr/share/sonic/device/$PLATFORM/asic.conf
    if [[ -f "$ASIC_CONF" ]]; then
        source $ASIC_CONF
    fi

    PLATFORM_ENV_CONF_FILE=/usr/share/sonic/device/$PLATFORM/platform_env.conf
    if [[ -f "$PLATFORM_ENV_CONF_FILE" ]]; then
        source $PLATFORM_ENV_CONF_FILE
    fi

    if [ "$CMD" = "" ] || [ "$CMD" = "help" ] || \
       [ "$CMD" = "-h" ] || [ "$CMD" = "--help" ]; then
        usage
        return 1
    fi

    case "$CMD" in
        boot)
            recover_golden_native_transition || return $?
            boot_config
            ;;
        factory)
            FACTORY_TYPE=$2
            if [ "$FACTORY_TYPE" = "help" ] || [ "$FACTORY_TYPE" = "-h" ] || \
               [ "$FACTORY_TYPE" = "--help" ]; then
                usage_factory
                return 1
            fi
            generate_config factory ${CONFIG_DB_JSON} ${FACTORY_TYPE}
            ;;
        backup)
            do_config_backup
            ;;
        apply_tacacs)
            apply_tacacs
            ;;
        *)
            usage
            return 1
            ;;
    esac
}

### Execution starts here ###

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
    exit $?
fi
