# Different outer archive timestamps must leave the original OCI bytes intact.
# Each fixture invokes Make's actual publication helper before Bazel reads it.
run_binary(
    name = "oci_fixture_first",
    args = [
        "--out",
        "$@",
        "--mtime",
        "946684800",
    ],
    out_dirs = ["oci-fixture-first"],
    tool = ":oci_base_fixture",
)

run_binary(
    name = "oci_fixture_second",
    args = [
        "--out",
        "$@",
        "--mtime",
        "1700000000",
    ],
    out_dirs = ["oci-fixture-second"],
    tool = ":oci_base_fixture",
)

oci_base_layout(
    name = "oci_base_first",
    srcs = [":oci_fixture_first"],
    expected_platform = "linux/amd64",
    marker = "$(execpath :oci_fixture_first)/oci-layout",
    root = "tools/bazel/tests/oci-fixture-first",
)

oci_base_layout(
    name = "oci_base_second",
    srcs = [":oci_fixture_second"],
    expected_platform = "linux/amd64",
    marker = "$(execpath :oci_fixture_second)/oci-layout",
    root = "tools/bazel/tests/oci-fixture-second",
)

genrule(
    name = "oci_fixture_overlay",
    outs = ["oci-overlay.tar"],
    cmd = "$(execpath :oci_base_fixture) --overlay $@",
    tools = [":oci_base_fixture"],
)

oci_image(
    name = "oci-consumer-first",
    base = ":oci_base_first",
    env = {"CONSUMER_FIXTURE": "added"},
    tars = [":oci_fixture_overlay"],
)

oci_image(
    name = "oci-consumer-second",
    base = ":oci_base_second",
    env = {"CONSUMER_FIXTURE": "added"},
    tars = [":oci_fixture_overlay"],
)

