    name = "swss_package_contract_test",
    size = "large",
    srcs = ["integration/oci_source_layers_test.py"],
    args = [
        "--policy=$(rootpath //dockers/docker-orchagent:package_policy)",
        "--runtime=$(rootpath //dockers/docker-orchagent:ci_swss)",
        "--library=protobuf.tar=$(rootpath //dockers/docker-orchagent:ci_protobuf)",
        "--dependencies=$(rootpath //dockers/docker-orchagent:ci_rdeps)",
        "--config=$(rootpath //dockers/docker-orchagent:ci_config)",
        "--debug-symbols=$(rootpath //dockers/docker-orchagent:ci_debug_symbols)",
        "--source-file=dist/BUILD.bazel=$(rootpath @swss_install_contract//:dist-BUILD.bazel.txt)",
        "--source-file=debian/swss.install=$(rootpath @swss_install_contract//:swss.install.txt)",
        "--source-anchor=$(rootpath @sonic_swss//fpmsyncd:bgp_eoiu_marker.py)",
        "--source-anchor-relative=fpmsyncd/bgp_eoiu_marker.py",
        "--readelf=$(rootpath @sonic_build_infra//toolchains/binutils:readelf)",
        "--objcopy=$(rootpath @sonic_build_infra//toolchains/binutils:objcopy)",
        "--source-data",
        "$(rootpaths @sonic_swss//cfgmgr:lua_files)",
        "$(rootpaths @sonic_swss//orchagent:lua_files)",
        "$(rootpath @sonic_swss//fpmsyncd:bgp_eoiu_marker.py)",
        "$(rootpath @sonic_swss//neighsyncd:restore_neighbors.py)",
        "$(rootpath @sonic_swss//swssconfig:sample/netbouncer.json)",
    ],
    data = [
        "//dockers/docker-orchagent:ci_config",
        "//dockers/docker-orchagent:ci_debug_symbols",
        "//dockers/docker-orchagent:ci_protobuf",
        "//dockers/docker-orchagent:ci_rdeps",
        "//dockers/docker-orchagent:ci_swss",
        "//dockers/docker-orchagent:package_policy",
        "@sonic_build_infra//toolchains/binutils:objcopy",
        "@sonic_build_infra//toolchains/binutils:readelf",
        "@sonic_swss//cfgmgr:lua_files",
        "@sonic_swss//fpmsyncd:bgp_eoiu_marker.py",
        "@sonic_swss//neighsyncd:restore_neighbors.py",
