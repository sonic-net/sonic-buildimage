        "//tools/bazel/ci:artifact_validation",
        "//tools/bazel/oci:package_contract_lib",
    ],
)

# Exercise upstream package extraction with existing checked-in DEBs. These
# native genrules deliberately show the same tools the Syncd owner BUILD uses;
# no package-generating rule or shared import facade participates in the test.
_OCI_DEB_FIXTURES = {
    "gz": "fixtures/oci-debs/example-gz_1.0-1_all.deb",
    "xz": "fixtures/oci-debs/example-xz_1.0-1_all.deb",
    "foreign": "fixtures/oci-debs/example-foreign_1.0-1_arm64.deb",
}

[
    genrule(
        name = "oci_extract_fixture_" + kind,
        testonly = True,
        srcs = [source],
        outs = ["oci_deb_fixture/" + kind + "/" + filename for filename in [
            "members.txt",
            "debian-binary",
            "control.archive",
            "data.archive",
        ]],
        cmd = """set -euo pipefail
export LC_ALL=C.UTF-8
"$(BSDTAR_BIN)" -tf "$(execpath {source})" > "$(RULEDIR)/oci_deb_fixture/{kind}/members.txt"
mapfile -t members < "$(RULEDIR)/oci_deb_fixture/{kind}/members.txt"
[[ "$${{#members[@]}}" == 3 && "$${{members[0]}}" == debian-binary ]]
case "$${{members[1]}}" in control.tar|control.tar.gz|control.tar.xz|control.tar.bz2) ;; *) exit 1 ;; esac
case "$${{members[2]}}" in data.tar|data.tar.gz|data.tar.xz|data.tar.bz2) ;; *) exit 1 ;; esac
"$(BSDTAR_BIN)" -xOf "$(execpath {source})" debian-binary > "$(RULEDIR)/oci_deb_fixture/{kind}/debian-binary"
"$(BSDTAR_BIN)" -xOf "$(execpath {source})" "$${{members[1]}}" > "$(RULEDIR)/oci_deb_fixture/{kind}/control.archive"
"$(BSDTAR_BIN)" -xOf "$(execpath {source})" "$${{members[2]}}" > "$(RULEDIR)/oci_deb_fixture/{kind}/data.archive"
""".format(
            kind = kind,
            source = source,
        ),
        toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
        tools = ["@bsd_tar_toolchains//:resolved_toolchain"],
    )
    for kind, source in _OCI_DEB_FIXTURES.items()
]

_OCI_FIXTURE_INPUTS = [
    "oci_deb_fixture/" + kind + "/" + filename
    for kind in [
        "gz",
        "xz",
        "foreign",
    ]
    for filename in [
        "members.txt",
        "debian-binary",
        "control.archive",
        "data.archive",
    ]
]

[
    genrule(
        name = "oci_deb_fixture_" + suffix,
        testonly = True,
        srcs = _OCI_FIXTURE_INPUTS + _OCI_DEB_FIXTURES.values(),
        outs = [
            "oci_deb_fixture/" + suffix + "/payload.tar",
            "oci_deb_fixture/" + suffix + "/manifest.json",
        ],
        cmd = "set -euo pipefail\nexport LC_ALL=C.UTF-8\n" +
              "\"$(BSDTAR_BIN)\" --format=pax -cf '$(RULEDIR)/oci_deb_fixture/" + suffix + "/payload.tar' " +
              "'@$(execpath oci_deb_fixture/gz/data.archive)' '@$(execpath oci_deb_fixture/xz/data.archive)'\n" +
              "\"$(execpath //tools/bazel/oci:package_receipts)\"" +
              " --architecture=amd64" +
              " --payload='$(RULEDIR)/oci_deb_fixture/" + suffix + "/payload.tar'" +
              " --out='$(RULEDIR)/oci_deb_fixture/" + suffix + "/manifest.json'" +
              " ".join([" --package='" + json.encode({
                  "source_label": "//tools/bazel/tests:" + _OCI_DEB_FIXTURES[kind],
                  "source": "$(execpath " + _OCI_DEB_FIXTURES[kind] + ")",
                  "members": "$(execpath oci_deb_fixture/" + kind + "/members.txt)",
                  "version": "$(execpath oci_deb_fixture/" + kind + "/debian-binary)",
                  "control": "$(execpath oci_deb_fixture/" + kind + "/control.archive)",
                  "data": "$(execpath oci_deb_fixture/" + kind + "/data.archive)",
              }) + "'" for kind in [
                  "gz",
                  "xz",
              ]]),
        toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
        tools = [
            "//tools/bazel/oci:package_receipts",
            "@bsd_tar_toolchains//:resolved_toolchain",
        ],
    )
    for suffix in [
        "first",
        "repeat",
    ]
]

