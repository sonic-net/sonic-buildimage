# Package marker so .bzl files in this directory (e.g. gzip.bzl) are loadable.
# Also includes generally useful targets.

load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")

exports_files([
    "submodule-config.bazelrc",
    "root-unpinned-modules-config.bazelrc",
])

sonic_layer(
    name = "debug_utils_pkg",
    tars = [
        "@trixie//gdb",
        "@trixie//gdbserver",
        "@trixie//strace",
        "@trixie//sshpass",
        "@trixie//libgpm2",

        "@sonic_build_infra//deps/vim:vim_pkg",
        "@sonic_build_infra//deps/vim:vim_runtime_pkg",
        "@sonic_build_infra//deps/vim:vim_alternatives_pkg",

        # Shared libraries the FIPS OpenSSH binaries need.
        # The FIPS debs below are plain filegroups, so we don't get dependency resolution.
        "@trixie//libedit2",
        "@trixie//libfido2-1",

        # Packages we read from src/sonic-fips
        "@sonic_fips//:libssl",
        "@sonic_fips//:openssh_client",
        "@sonic_fips//:libk5crypto3",
        "@sonic_fips//:libkrb5support0",
        "@sonic_fips//:libkrb5_3",
        "@sonic_fips//:libgssapi_krb5_2",
    ],
    visibility = ["//visibility:public"],
)
