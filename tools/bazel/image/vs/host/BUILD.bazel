    srcs = sorted({source: True for source, _, _ in _FILES}.keys()),
    mtree = [
        "./" + path + " type=dir uid=0 gid=0 mode=0755 time=0"
        for path in _DIRECTORIES
    ] + [
        "./" + destination + " type=file uid=0 gid=0 mode=" + mode + " time=0 content=$(location " + source + ")"
        for source, destination, mode in _FILES
