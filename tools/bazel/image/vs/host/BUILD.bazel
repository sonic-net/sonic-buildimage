# Applied after the runtime/configuration layers, at build_debian.sh's final
# cleanup boundary. Whiteouts affect inherited content, without unpacking it.
tar(
    name = "final_cleanup",
    srcs = [":empty_file"],
    mtree = [
        "./host type=dir uid=0 gid=0 mode=0755 time=0",
        "./var/core type=dir uid=0 gid=0 mode=0755 time=0",
        "./var/lib/docker type=dir uid=0 gid=0 mode=0755 time=0",
        "./var/cache/sonic/system-health type=dir uid=0 gid=0 mode=0700 time=0",
        "./etc/sonic/frr type=dir uid=300 gid=300 mode=0750 time=0",
        "./etc/sonic/frr/frr.conf type=file uid=300 gid=300 mode=0640 time=0 content=$(location :empty_file)",
        "./etc/sonic/frr/vtysh.conf type=file uid=300 gid=300 mode=0640 time=0 content=$(location :empty_file)",
        "./etc/resolv.conf type=file uid=0 gid=0 mode=0644 time=0 content=$(location :empty_file)",
    ] + [
        "./" + path + " type=dir uid=0 gid=0 mode=" + mode + " time=0"
        for path, mode in [("usr/share/doc", "0755"), ("usr/share/locale", "0755"), ("var/lib/apt/lists", "0755"), ("tmp", "1777")]
    ] + [
        "./" + path + "/.wh..wh..opq type=file uid=0 gid=0 mode=0644 time=0 content=$(location :empty_file)"
        for path in ["usr/share/doc", "usr/share/locale", "var/lib/apt/lists", "tmp"]
    ] + [
        "./" + path + " type=file uid=0 gid=0 mode=0644 time=0 content=$(location :empty_file)"
        for path in [
            "etc/resolvconf/resolv.conf.d/.wh.original",
            "run/resolvconf/.wh.resolv.conf",
            "usr/local/bin/.wh.ctrmgr_tools.py",
            "etc/network/if-post-down.d/.wh.chrony",
