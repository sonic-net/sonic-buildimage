    architecture = "amd64",
)

# Debian Trixie merged-/usr layout, applied before package payloads.
tar(
    name = "merged_usr_skeleton",
    mtree = [
        "./" + path + " type=dir uid=0 gid=0 mode=0755 time=0"
        for path in ["usr", "usr/bin", "usr/sbin", "usr/lib", "usr/lib64", "run", "var"]
    ] + [
        "./" + name + " type=link uid=0 gid=0 mode=0777 time=0 link=usr/" + name
        for name in ["bin", "sbin", "lib", "lib64"]
    ] + [
        "./var/run type=link uid=0 gid=0 mode=0777 time=0 link=/run",
        "./var/lock type=link uid=0 gid=0 mode=0777 time=0 link=/run/lock",
        "./run/lock type=dir uid=0 gid=0 mode=1777 time=0",
    ],
)

py_binary(
    name = "package_configuration_tool",
    srcs = ["package_configuration.py", "alternatives_data.py", "authentication.py", "tar_filesystem.py"],
    main = "package_configuration.py",
    imports = ["."],
    deps = ["//tools/bazel/image:assembly_lib"],
)

