    name = "ldcache_tool",
    srcs = ["ldcache_layer.py", "tar_filesystem.py"],
    main = "ldcache_layer.py",
    imports = ["."],
    deps = ["//tools/bazel/image:assembly_lib", "//tools/bazel/image:ldcache"],
)

