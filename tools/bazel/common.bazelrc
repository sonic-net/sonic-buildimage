common --lockfile_mode=update

# Default direct invocations to AMD64; the Make container bridge selects the
# configured native architecture, and ARM64 callers can pass both platform flags.
common --platforms=@sonic_build_infra//platforms:x86_64_trixie
# Build-time cfggen has native Common/YANG dependencies too. Select the declared
# Trixie toolchain for execution tools instead of the ambient host compiler.
common --host_platform=@sonic_build_infra//platforms:x86_64_trixie
common --@sonic_swss_common//tools/bazel:yang_modules=True
common --noincompatible_disallow_empty_glob
build --@rules_rust//rust/settings:experimental_use_allocator_libraries_with_mangled_symbols=True
build:release --compilation_mode=opt
test --test_output=errors

# The Syncd image explicitly selects its source-built DASH SDK and daemon.
build:syncd-dash --@sonic_sairedis//:enable_dashsai=true
build:syncd-dash --@sonic_sairedis//:dash_sai=@sonic_dash//:sdk
build:syncd-dash --@sonic_sairedis//:dash_runtime_metadata=@sonic_dash//:runtime_packages.json

try-import %workspace%/.bazelrc.user

# Restore complete declared kernel/metadata tool trees from the action cache.
# A dependency's .bazelrc is not inherited by this image build root.
build --remote_download_regex=(^|.*/)tools/build_tools/kernel_runtime_(amd64|arm64)(/.*)?$
