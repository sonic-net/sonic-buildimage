diff --git a/bazel/unpack.py b/bazel/unpack.py
--- a/bazel/unpack.py
+++ b/bazel/unpack.py
@@ -1,11 +1,12 @@
 """Extract pinned target dependency payloads using the declared BSD tar tool."""
 import os
+import runpy
 from pathlib import Path
 import subprocess
 import sys
 
-tool, destination, *archives = sys.argv[1:]
-root = Path(destination)
+tool, destination, runtime_helpers, *archives = sys.argv[1:]
+root = Path(destination).resolve()
 root.mkdir(parents=True, exist_ok=True)
 for archive in sorted(archives):
     subprocess.run([tool, "-xf", archive, "-C", str(root), "--no-same-owner"], check=True)
@@ -14,3 +15,11 @@
         target = root / os.readlink(path).lstrip("/")
         path.unlink()
         path.symlink_to(os.path.relpath(target, path.parent))
+
+# Reuse Infra's kernel-runtime handling for cache-safe directory aliases.
+runpy.run_path(runtime_helpers)["materialize_directory_aliases"](root, copy_function=os.link)
+# Use the same empty-leaf transport convention as prepare_rootfs.
+for directory, _, _ in os.walk(root, followlinks=False):
+    leaf = Path(directory)
+    if not any(leaf.iterdir()):
+        (leaf / ".bazel-keep-directory").touch()
