module(
    name = "sonic-yang-mgmt",
    version = "1.0.1",
)

# Match the image root's published native library and execution interfaces.
bazel_dep(name = "libyang", version = "3.12.2.sonic.9")
bazel_dep(name = "libyang-python", version = "3.1.0.sonic.7", repo_name = "libyang_python")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.26", repo_name = None)
bazel_dep(name = "rules_python", version = "1.9.0.sonic.2")
bazel_dep(
    name = "sonic-build-infra",
    version = "0.0.45-77ef625a4ddafc8cdc15f3cc6aee31eabac8a5de",
    repo_name = "sonic_build_infra",
)

# Both source modules are maintained together in sonic-buildimage. This also
# keeps standalone checks on the same source model set as the parent checkout.
bazel_dep(name = "sonic-yang-models", version = "1.0.1-dd732f9512a84966487951250adae8e3e5c9943e", repo_name = "sonic_yang_models")
local_path_override(
    module_name = "sonic-yang-models",
    path = "../sonic-yang-models",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "sonic_yang_mgmt_pip",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
)
# Keep BUILD.bazel usable under both the image root and this source module.
use_repo(pip, config_engine_pip = "sonic_yang_mgmt_pip")

single_version_override(
    module_name = "sonic-build-infra",
    version = "0.0.45-77ef625a4ddafc8cdc15f3cc6aee31eabac8a5de",
)
