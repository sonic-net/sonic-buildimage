load("@config_engine_pip//:requirements.bzl", "requirement")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("@rules_python//python:py_library.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "setup.py",
    "requirements.in",
])

_MODULES = [
    "sonic_yang.py",
    "sonic_yang_ext.py",
    "sonic_yang_path.py",
]

py_library(
    name = "sonic_yang_mgmt",
    srcs = _MODULES,
    imports = ["."],
    deps = [
        "@libyang_python//:libyang",
        requirement("ijson"),
        requirement("jsonpointer"),
        requirement("jsondiff"),
        requirement("tabulate"),
    ],
)

genrule(
    name = "wheel_cfghelp_script",
    srcs = ["sonic-cfg-help"],
    outs = ["wheel_scripts/sonic-cfg-help"],
    cmd = "sed '1s|.*|#!python|' $(location sonic-cfg-help) > $@ && chmod 755 $@",
)

filegroup(
    name = "wheel_payload",
    srcs = _MODULES + glob(["tests/*.py"]),
)

py_wheel(
    name = "sonic_yang_mgmt_wheel",
    author = "lnos-coders",
    author_email = "lnos-coders@linkedin.com",
    data_files = {":wheel_cfghelp_script": "scripts/sonic-cfg-help"},
    description_file = "README.rst",
    distribution = "sonic-yang-mgmt",
    extra_distinfo_files = {"LICENSE": "licenses/LICENSE"},
    license = "GNU General Public License v3",
    python_requires = ">=2.7, !=3.0.*, !=3.1.*, !=3.2.*, !=3.3.*, !=3.4.*",
    python_tag = "py3",
    requires = [
        "ijson>=3.2.3",
        "jsonpointer>=1.9",
        "jsondiff>=1.2.0",
        "tabulate==0.9.0",
    ],
    strip_path_prefixes = ["src/sonic-yang-mgmt/"],
    summary = "Package contains Python Library for YANG for sonic.",
    version = "1.0",
    deps = [":wheel_payload"],
)

filegroup(
    name = "test_sources",
    srcs = _MODULES + glob(
        ["tests/**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ) + [
        "README.rst",
        "setup.cfg",
        "setup.py",
        "sonic-cfg-help",
    ],
)
