load("@config_engine_pip//:requirements.bzl", "requirement")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@sonic_build_infra//python:site_packages.bzl", "site_packages")

package(default_visibility = ["//visibility:public"])

exports_files([
    "setup.py",
    "requirements.in",
    "requirements_lock.txt",
])

_MODULES = [
    "sonic_yang.py",
    "sonic_yang_ext.py",
    "sonic_yang_path.py",
]

filegroup(
    name = "sonic_yang_mgmt_sources",
    srcs = _MODULES,
)

py_library(
    name = "sonic_yang_mgmt",
    srcs = [":sonic_yang_mgmt_sources"],
    imports = ["."],
    deps = [
        "@libyang_python//:libyang",
        requirement("ijson"),
        requirement("jsonpointer"),
        requirement("jsondiff"),
        requirement("tabulate"),
    ],
)

genrule(
    name = "wheel_cfghelp_script",
    srcs = ["sonic-cfg-help"],
    outs = ["wheel_scripts/sonic-cfg-help"],
    cmd = "sed '1s|.*|#!python|' $(location sonic-cfg-help) > $@ && chmod 755 $@",
)

filegroup(
    name = "wheel_payload",
    srcs = _MODULES + glob(["tests/*.py"]),
)

_SOURCE_AUTHOR = "lnos-coders"

_SOURCE_AUTHOR_EMAIL = "lnos-coders@linkedin.com"

_SOURCE_DESCRIPTION_FILE = "README.rst"

_SOURCE_DISTRIBUTION = "sonic-yang-mgmt"

_SOURCE_EXTRA_DISTINFO_FILES = {"LICENSE": "licenses/LICENSE"}

_SOURCE_LICENSE = "GNU General Public License v3"

_SOURCE_PYTHON_REQUIRES = ">=2.7, !=3.0.*, !=3.1.*, !=3.2.*, !=3.3.*, !=3.4.*"

_SOURCE_REQUIRES = [
    "ijson>=3.2.3",
    "jsonpointer>=1.9",
    "jsondiff>=1.2.0",
    "tabulate==0.9.0",
]

_SOURCE_SUMMARY = "Package contains Python Library for YANG for sonic."

_SOURCE_VERSION = "1.0"

py_wheel(
    name = "sonic_yang_mgmt_wheel",
    author = _SOURCE_AUTHOR,
    author_email = _SOURCE_AUTHOR_EMAIL,
    data_files = {":wheel_cfghelp_script": "scripts/sonic-cfg-help"},
    description_file = _SOURCE_DESCRIPTION_FILE,
    distribution = _SOURCE_DISTRIBUTION,
    extra_distinfo_files = _SOURCE_EXTRA_DISTINFO_FILES,
    license = _SOURCE_LICENSE,
    python_requires = _SOURCE_PYTHON_REQUIRES,
    python_tag = "py3",
    requires = _SOURCE_REQUIRES,
    strip_path_prefixes = ["src/sonic-yang-mgmt/"],
    summary = _SOURCE_SUMMARY,
    version = _SOURCE_VERSION,
    deps = [":wheel_payload"],
)

filegroup(
    name = "test_sources",
    srcs = _MODULES + glob(
        ["tests/**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ) + [
        "README.rst",
        "setup.cfg",
        "setup.py",
        "sonic-cfg-help",
    ],
)

# Direct source installation preserves setup.py metadata and original wheel API.
site_packages(
    name = "sonic-yang-mgmt.runtime",
    author = _SOURCE_AUTHOR,
    author_email = _SOURCE_AUTHOR_EMAIL,
    classifiers = [
        "Development Status :: 2 - Pre-Alpha",
        "Intended Audience :: Developers",
        "License :: OSI Approved :: GNU General Public License v3 (GPLv3)",
        "Natural Language :: English",
        "Programming Language :: Python :: 2",
        "Programming Language :: Python :: 2.7",
        "Programming Language :: Python :: 3",
        "Programming Language :: Python :: 3.5",
        "Programming Language :: Python :: 3.6",
        "Programming Language :: Python :: 3.7",
        "Programming Language :: Python :: 3.8",
    ],
    data_prefix = "/usr/local",
    description_file = _SOURCE_DESCRIPTION_FILE,
    distribution = _SOURCE_DISTRIBUTION,
    executable_files = ["sonic_yang_mgmt-1.0.data/scripts/sonic-cfg-help"],
    extra_distinfo_files = _SOURCE_EXTRA_DISTINFO_FILES | {"AUTHORS.rst": "licenses/AUTHORS.rst"},
    files = {p: p for p in _MODULES + glob(["tests/*.py"])} | {"sonic-cfg-help": "sonic_yang_mgmt-1.0.data/scripts/sonic-cfg-help"},
    headers = "/usr/local/include",
    interpreter = "/usr/bin/python3",
    keywords = "sonic-yang-mgmt",
    license = _SOURCE_LICENSE,
    license_files = [
        "LICENSE",
        "AUTHORS.rst",
    ],
    normalize_scripts = True,
    python_requires = _SOURCE_PYTHON_REQUIRES,
    regular_file_mode = "0644",
    requires = _SOURCE_REQUIRES,
    scripts = "/usr/local/bin",
    site_packages = "/usr/local/lib/python3.13/dist-packages",
    summary = _SOURCE_SUMMARY,
    version = _SOURCE_VERSION,
    runtime_deps = ["@sonic_yang_models//:sonic-yang-models.runtime"],
)

filegroup(
    name = "sonic-yang-mgmt.runtime_metadata",
    srcs = [":sonic-yang-mgmt.runtime"],
    output_group = "metadata",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source_install_test_sources",
    testonly = True,
    srcs = [":test_sources"] + glob([
        "LICENSE*",
        "LICENCE*",
        "COPYING*",
        "NOTICE*",
        "AUTHORS*",
    ], allow_empty = True),
    visibility = ["//tools/bazel/tests:__pkg__"],
)

# Preserve the registered module's public production-model consumer check.
py_test(
    name = "sonic_yang_mgmt_runtime_test",
    srcs = ["sonic_yang_mgmt_runtime_test.py"],
    args = ["$(rootpath @sonic_yang_models//:test_models)"],
    data = ["@sonic_yang_models//:test_models"],
    python_version = "3.13",
    deps = [":sonic_yang_mgmt"],
)
