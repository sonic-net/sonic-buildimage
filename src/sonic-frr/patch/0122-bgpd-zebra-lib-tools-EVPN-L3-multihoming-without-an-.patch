+/* Find the VRF bgp instance that owns a given L3VNI. */
+static struct bgp *bgp_evpn_l3vni_to_bgp_vrf(vni_t l3vni)
+{
+	struct listnode *node;
+	struct bgp *bgp_vrf;
+
+	if (!l3vni)
+		return NULL;
+
+	for (ALL_LIST_ELEMENTS_RO(bm->bgp, node, bgp_vrf))
+		if (bgp_vrf->l3vni == l3vni)
+			return bgp_vrf;
+
+	return NULL;
+}
