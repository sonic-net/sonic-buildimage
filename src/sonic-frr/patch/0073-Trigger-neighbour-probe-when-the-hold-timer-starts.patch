From 7f312cdf8b818222afe42027f7d1e6b3b261f9d0 Mon Sep 17 00:00:00 2001
From: Mike RE Mallin <mremallin@gmail.com>
Date: Wed, 4 Dec 2024 15:41:24 -0500
Subject: [PATCH] Trigger neighbour probe when the hold timer starts

(cherry picked from commit afd912bdefc0892297fee789b58eead2c82acde1)
Signed-off-by: Tamer Ahmed <tamerahmed@microsoft.com>
Signed-off-by: Deepak Singhal <deepsinghal@microsoft.com>
Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 zebra/zebra_dplane.c     |  8 ++++++--
 zebra/zebra_dplane.h     |  2 +-
 zebra/zebra_evpn_neigh.c | 21 ++++++++++++++++++++-
 3 files changed, 27 insertions(+), 4 deletions(-)

diff --git a/zebra/zebra_dplane.c b/zebra/zebra_dplane.c
index ba7cd65c48..b2610e7a96 100644
--- a/zebra/zebra_dplane.c
+++ b/zebra/zebra_dplane.c
@@ -5990,7 +5990,7 @@ enum zebra_dplane_result dplane_local_neigh_add(const struct interface *ifp,
 					  const struct ipaddr *ip,
 					  const struct ethaddr *mac,
 					  bool set_router, bool set_static,
-					  bool set_inactive)
+					  bool set_inactive, bool trigger_probe)
 {
 	enum zebra_dplane_result result = ZEBRA_DPLANE_REQUEST_FAILURE;
 	uint32_t update_flags = 0;
@@ -6000,8 +6000,12 @@ enum zebra_dplane_result dplane_local_neigh_add(const struct interface *ifp,
 	if (set_static)
 		update_flags |= DPLANE_NEIGH_SET_STATIC;
 
-	if (set_inactive) {
+	if (set_inactive)
 		update_flags |= DPLANE_NEIGH_SET_INACTIVE;
+
+	if (trigger_probe) {
+		state = DPLANE_NUD_PROBE;
+	} else if (set_inactive) {
 		state = DPLANE_NUD_STALE;
 	} else {
 		state = DPLANE_NUD_REACHABLE;
diff --git a/zebra/zebra_dplane.h b/zebra/zebra_dplane.h
index 7fd2b8d3f0..a0d82f8d79 100644
--- a/zebra/zebra_dplane.h
+++ b/zebra/zebra_dplane.h
@@ -1120,7 +1120,7 @@ enum zebra_dplane_result dplane_local_neigh_add(const struct interface *ifp,
 					  const struct ipaddr *ip,
 					  const struct ethaddr *mac,
 					  bool set_router, bool set_static,
-					  bool set_inactive);
+					  bool set_inactive, bool trigger_probe);
 enum zebra_dplane_result dplane_rem_neigh_delete(const struct interface *ifp,
 					     const struct ipaddr *ip);
 
diff --git a/zebra/zebra_evpn_neigh.c b/zebra/zebra_evpn_neigh.c
index b7bbd97c35..d32bf07994 100644
--- a/zebra/zebra_evpn_neigh.c
+++ b/zebra/zebra_evpn_neigh.c
@@ -219,7 +219,7 @@ static void zebra_evpn_sync_neigh_dp_install(struct zebra_neigh *n,
 			set_static ? " static" : "",
 			set_inactive ? " inactive" : "");
 	dplane_local_neigh_add(ifp, &n->ip, &n->emac, set_router, set_static,
-			       set_inactive);
+			       set_inactive, false /* trigger_probe */);
 }
 
 /*
@@ -393,6 +393,12 @@ static void zebra_evpn_neigh_hold_exp_cb(struct event *t)
 
 static inline void zebra_evpn_neigh_start_hold_timer(struct zebra_neigh *n)
 {
+	struct interface *ifp = NULL;
+	bool set_router = !!CHECK_FLAG(n->flags, ZEBRA_NEIGH_ROUTER_FLAG);
+	bool set_static = zebra_evpn_neigh_is_static(n);
+	bool set_inactive =
+		!!CHECK_FLAG(n->flags, ZEBRA_NEIGH_LOCAL_INACTIVE);
+
 	if (event_is_scheduled(n->hold_timer))
 		return;
 
@@ -401,6 +407,19 @@ static inline void zebra_evpn_neigh_start_hold_timer(struct zebra_neigh *n)
 			   n->zevpn->vni, &n->ip, &n->emac, n->flags);
 	event_add_timer(zrouter.master, zebra_evpn_neigh_hold_exp_cb, n,
 			zmh_info->neigh_hold_time, &n->hold_timer);
+
+	if (n->ifindex != IFINDEX_INTERNAL && n->zevpn && n->zevpn->vxlan_if
+	    && n->zevpn->vxlan_if->vrf) {
+		struct zebra_vrf *zvrf = n->zevpn->vxlan_if->vrf->info;
+
+		if (zvrf)
+			ifp = if_lookup_by_index_per_ns(zvrf->zns, n->ifindex);
+	}
+
+	if (ifp)
+		(void)dplane_local_neigh_add(ifp, &n->ip, &n->emac,
+					     set_router, set_static, set_inactive,
+					     true /* trigger_probe */);
 }
 
 static void zebra_evpn_local_neigh_deref_mac(struct zebra_neigh *n,
-- 
2.34.1

