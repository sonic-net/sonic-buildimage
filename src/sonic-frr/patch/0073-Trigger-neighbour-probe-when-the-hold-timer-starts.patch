From ef48ca8a7dbb251b4e88990c8a148fe924b601fd Mon Sep 17 00:00:00 2001
From: Mike RE Mallin <mremallin@gmail.com>
Date: Wed, 4 Dec 2024 15:41:24 -0500
Subject: [PATCH] Trigger neighbour probe when the hold timer starts

(cherry picked from commit afd912bdefc0892297fee789b58eead2c82acde1)
Signed-off-by: Tamer Ahmed <tamerahmed@microsoft.com>
---
 zebra/zebra_evpn_neigh.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/zebra/zebra_evpn_neigh.c b/zebra/zebra_evpn_neigh.c
index b7bbd97c35..c095cdb289 100644
--- a/zebra/zebra_evpn_neigh.c
+++ b/zebra/zebra_evpn_neigh.c
@@ -393,6 +393,8 @@ static void zebra_evpn_neigh_hold_exp_cb(struct event *t)
 
 static inline void zebra_evpn_neigh_start_hold_timer(struct zebra_neigh *n)
 {
+	struct interface *ifp = NULL;
+
 	if (event_is_scheduled(n->hold_timer))
 		return;
 
@@ -401,6 +403,17 @@ static inline void zebra_evpn_neigh_start_hold_timer(struct zebra_neigh *n)
 			   n->zevpn->vni, &n->ip, &n->emac, n->flags);
 	event_add_timer(zrouter.master, zebra_evpn_neigh_hold_exp_cb, n,
 			zmh_info->neigh_hold_time, &n->hold_timer);
+
+	if (n->ifindex != IFINDEX_INTERNAL && n->zevpn && n->zevpn->vxlan_if
+	    && n->zevpn->vxlan_if->vrf) {
+		struct zebra_vrf *zvrf = n->zevpn->vxlan_if->vrf->info;
+
+		if (zvrf)
+			ifp = if_lookup_by_index_per_ns(zvrf->zns, n->ifindex);
+	}
+
+	if (ifp)
+		(void)dplane_neigh_discover(ifp, &n->ip);
 }
 
 static void zebra_evpn_local_neigh_deref_mac(struct zebra_neigh *n,
