diff --git a/tests/zebra/test_zebra_evpn_mh_decisions.c b/tests/zebra/test_zebra_evpn_mh_decisions.c
new file mode 100644
index 0000000000..c173c5382b
--- /dev/null
+++ b/tests/zebra/test_zebra_evpn_mh_decisions.c
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Unit tests for the EVPN multihoming local-inactive decisions.
+ *
+ * Copyright (C) 2026 Microsoft Corporation
+ */
+
+/*
+ * Each of these decides whether a host that has gone quiet is retired or kept.
+ * Wrong in one direction and a departed host is advertised forever; wrong in
+ * the other and a live host is withdrawn. Reproducing the states on real
+ * hardware needs an Ethernet Segment, two PEs and expired hold timers, so they
+ * are driven directly from here.
+ */
+
+#include <stdio.h>
+
+#include <CUnit/CUnit.h>
+#include <CUnit/Basic.h>
+
+#include "zebra/zebra_evpn_mh_decisions.h"
+
+#define ADV_REACHABLE_ONLY true
+#define ADV_ALL false
+#define WAS_INACTIVE true
+#define WAS_ACTIVE false
+
+/*
+ * With reachable-only advertisement enabled the kernel's local_inactive is a
+ * real liveness signal, so it decides on its own.
+ */
+static void test_reachable_only_trusts_the_kernel(void)
+{
+	CU_ASSERT_TRUE(zebra_evpn_neigh_local_inactive_next(
+		WAS_ACTIVE, true, ADV_REACHABLE_ONLY, false));
+	CU_ASSERT_FALSE(zebra_evpn_neigh_local_inactive_next(
+		WAS_INACTIVE, false, ADV_REACHABLE_ONLY, true));
+}
+
+/*
+ * With it disabled, which is what SONiC runs, local_inactive is hardcoded
+ * false for every kernel update. A neighbour whose MAC is still locally active
+ * may be cleared, because that combination only occurs for a live host.
+ */
+static void test_active_mac_clears_the_neighbour(void)
+{
+	CU_ASSERT_FALSE(zebra_evpn_neigh_local_inactive_next(WAS_INACTIVE, false,
+							     ADV_ALL, false));
+}
+
+/* But a neighbour whose MAC has already left the dataplane must survive it. */
+static void test_inactive_mac_keeps_the_neighbour(void)
+{
+	CU_ASSERT_TRUE(zebra_evpn_neigh_local_inactive_next(WAS_INACTIVE, false,
+							    ADV_ALL, true));
+}
+
+/* The kernel can still report inactivity explicitly, and that always wins. */
+static void test_explicit_inactive_always_wins(void)
+{
+	CU_ASSERT_TRUE(zebra_evpn_neigh_local_inactive_next(WAS_ACTIVE, true,
+							    ADV_ALL, false));
+	CU_ASSERT_TRUE(zebra_evpn_neigh_local_inactive_next(WAS_ACTIVE, true,
+							    ADV_ALL, true));
+}
+
+/* Nothing here may invent inactivity for a neighbour that never had it. */
+static void test_active_neighbour_stays_active(void)
+{
+	CU_ASSERT_FALSE(zebra_evpn_neigh_local_inactive_next(WAS_ACTIVE, false,
+							     ADV_ALL, true));
+}
+
+/* Only the transition hands the neighbours to a walker, so echoes are free. */
+static void test_only_the_transition_moves_neighbours(void)
+{
+	CU_ASSERT_TRUE(zebra_evpn_mac_neighs_go_inactive(true, false));
+	CU_ASSERT_FALSE(zebra_evpn_mac_neighs_go_inactive(true, true));
+	CU_ASSERT_TRUE(zebra_evpn_mac_neighs_go_active(false, true, false));
+	CU_ASSERT_FALSE(zebra_evpn_mac_neighs_go_active(false, false, false));
+}
+
+/* upd_neigh means the existing change walker already revives them. */
+static void test_upd_neigh_defers_the_revive(void)
+{
+	CU_ASSERT_FALSE(zebra_evpn_mac_neighs_go_active(false, true, true));
+}
+
+/* The two walkers are mutually exclusive on any single update. */
+static void test_walkers_never_both_run(void)
+{
+	bool inactive, old;
+
+	for (inactive = false; ; inactive = true) {
+		for (old = false; ; old = true) {
+			CU_ASSERT_FALSE(
+				zebra_evpn_mac_neighs_go_inactive(inactive,
+								  old) &&
+				zebra_evpn_mac_neighs_go_active(inactive, old,
+								false));
+			if (old)
+				break;
+		}
+		if (inactive)
+			break;
+	}
+}
+
+/*
+ * A MAC is pinned by its own peer flags and by its sync neighbours, and the two
+ * are released independently. Reading only one of them is what left a departed
+ * MAC advertised forever.
+ */
+static void test_either_reference_pins_the_mac(void)
+{
+	CU_ASSERT_TRUE(zebra_evpn_mac_pinned(true, 0));
+	CU_ASSERT_TRUE(zebra_evpn_mac_pinned(false, 1));
+	CU_ASSERT_TRUE(zebra_evpn_mac_pinned(true, 2));
+	CU_ASSERT_FALSE(zebra_evpn_mac_pinned(false, 0));
+}
+
+/*
+ * The interleave that produced the bug: the peer flags clear first, then the
+ * MAC delete is evaluated while a sync neighbour reference is still held, and
+ * only afterwards does the count reach zero.
+ */
+static void test_flush_waits_for_the_last_reference(void)
+{
+	/* peer flags gone, one neighbour still holding it */
+	CU_ASSERT_FALSE(zebra_evpn_mac_should_flush_inactive(true, true, true,
+							     false, 1));
+	/* last neighbour released, nothing pins it any more */
+	CU_ASSERT_TRUE(zebra_evpn_mac_should_flush_inactive(true, true, true,
+							    false, 0));
+	/* the other order: neighbours gone first, peer flags still set */
+	CU_ASSERT_FALSE(zebra_evpn_mac_should_flush_inactive(true, true, true,
+							     true, 0));
+}
+
+/* Outside external-learning mode the dataplane ages the MAC out by itself. */
+static void test_no_flush_without_ext_learn(void)
+{
+	CU_ASSERT_FALSE(zebra_evpn_mac_should_flush_inactive(false, true, true,
+							     false, 0));
+}
+
+/* A MAC that is not local, or still locally active, is not ours to flush. */
+static void test_no_flush_for_a_live_or_remote_mac(void)
+{
+	CU_ASSERT_FALSE(zebra_evpn_mac_should_flush_inactive(true, false, true,
+							     false, 0));
+	CU_ASSERT_FALSE(zebra_evpn_mac_should_flush_inactive(true, true, false,
+							     false, 0));
+}
+
+/* Both walkers skip remote neighbours and anything already in the target
+ * state, which is what makes repeated dataplane echoes harmless.
+ */
+static void test_walk_skip_is_idempotent(void)
+{
+	/* retiring: skip the ones already inactive, take the active ones */
+	CU_ASSERT_TRUE(zebra_evpn_neigh_walk_skip(true, true, true));
+	CU_ASSERT_FALSE(zebra_evpn_neigh_walk_skip(true, false, true));
+	/* reviving: the mirror image */
+	CU_ASSERT_TRUE(zebra_evpn_neigh_walk_skip(true, false, false));
+	CU_ASSERT_FALSE(zebra_evpn_neigh_walk_skip(true, true, false));
+	/* a remote neighbour is never touched by either */
+	CU_ASSERT_TRUE(zebra_evpn_neigh_walk_skip(false, true, true));
+	CU_ASSERT_TRUE(zebra_evpn_neigh_walk_skip(false, false, false));
+}
+
+int main(int argc, char **argv)
+{
+	CU_pSuite suite;
+
+	if (CU_initialize_registry() != CUE_SUCCESS)
+		return CU_get_error();
+
+	suite = CU_add_suite("zebra_evpn_mh_decisions", NULL, NULL);
+	if (!suite) {
+		CU_cleanup_registry();
+		return CU_get_error();
+	}
+
+	if (!CU_add_test(suite, "reachable-only trusts the kernel",
+			 test_reachable_only_trusts_the_kernel) ||
+	    !CU_add_test(suite, "active mac clears the neighbour",
+			 test_active_mac_clears_the_neighbour) ||
+	    !CU_add_test(suite, "inactive mac keeps the neighbour",
+			 test_inactive_mac_keeps_the_neighbour) ||
+	    !CU_add_test(suite, "explicit inactive always wins",
+			 test_explicit_inactive_always_wins) ||
+	    !CU_add_test(suite, "active neighbour stays active",
+			 test_active_neighbour_stays_active) ||
+	    !CU_add_test(suite, "only the transition moves neighbours",
+			 test_only_the_transition_moves_neighbours) ||
+	    !CU_add_test(suite, "upd_neigh defers the revive",
+			 test_upd_neigh_defers_the_revive) ||
+	    !CU_add_test(suite, "walkers never both run",
+			 test_walkers_never_both_run) ||
+	    !CU_add_test(suite, "either reference pins the mac",
+			 test_either_reference_pins_the_mac) ||
+	    !CU_add_test(suite, "flush waits for the last reference",
+			 test_flush_waits_for_the_last_reference) ||
+	    !CU_add_test(suite, "no flush without ext-learn",
+			 test_no_flush_without_ext_learn) ||
+	    !CU_add_test(suite, "no flush for a live or remote mac",
+			 test_no_flush_for_a_live_or_remote_mac) ||
+	    !CU_add_test(suite, "walk skip is idempotent",
+			 test_walk_skip_is_idempotent)) {
+		CU_cleanup_registry();
+		return CU_get_error();
+	}
+
+	CU_basic_set_mode(CU_BRM_VERBOSE);
+	CU_basic_run_tests();
+
+	if (CU_get_number_of_failures() == 0)
+		puts("test_zebra_evpn_mh_decisions: PASS");
+
+	CU_cleanup_registry();
+	return CU_get_error();
+}
