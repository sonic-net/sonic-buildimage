+tests_zebra_test_zebra_evpn_mh_decisions_CPPFLAGS = $(TESTS_CPPFLAGS)
+tests_zebra_test_zebra_evpn_mh_decisions_LDADD = -lcunit
+tests_zebra_test_zebra_evpn_mh_decisions_SOURCES = tests/zebra/test_zebra_evpn_mh_decisions.c
+EXTRA_DIST += \
