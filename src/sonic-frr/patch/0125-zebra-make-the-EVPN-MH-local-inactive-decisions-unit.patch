diff --git a/zebra/zebra_evpn_mh_decisions.h b/zebra/zebra_evpn_mh_decisions.h
new file mode 100644
index 0000000000..83f6f71c8d
--- /dev/null
+++ b/zebra/zebra_evpn_mh_decisions.h
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * EVPN multihoming local-inactive decisions.
+ *
+ * Copyright (C) 2026 Microsoft Corporation
+ */
+
+/*
+ * These decide when a MAC or a neighbour stops being locally active and when it
+ * may be retired. They are kept free of zebra types so they can be driven
+ * directly from tests/zebra/test_zebra_evpn_mh_decisions.c: the states that
+ * matter need an Ethernet Segment, two PEs and expired hold timers, which is
+ * expensive to stage and easy to get wrong by hand.
+ */
+
+#ifndef _FRR_ZEBRA_EVPN_MH_DECISIONS_H
+#define _FRR_ZEBRA_EVPN_MH_DECISIONS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/*
+ * Next value of ZEBRA_NEIGH_LOCAL_INACTIVE for a local neighbour update.
+ *
+ * With reachable-only advertisement disabled the kernel reports local_inactive
+ * as false for every update, so that value carries no liveness information and
+ * must not clear a neighbour whose MAC has already left the local dataplane.
+ * The MAC is the trustworthy signal there; the NUD state is not.
+ */
+static inline bool zebra_evpn_neigh_local_inactive_next(bool cur_inactive,
+							bool local_inactive,
+							bool adv_reachable_only,
+							bool mac_local_inactive)
+{
+	if (local_inactive)
+		return true;
+
+	if (adv_reachable_only || !mac_local_inactive)
+		return false;
+
+	return cur_inactive;
+}
+
+/* A MAC that has just left the local dataplane retires its neighbours. */
+static inline bool zebra_evpn_mac_neighs_go_inactive(bool local_inactive,
+						     bool old_local_inactive)
+{
+	return local_inactive && !old_local_inactive;
+}
+
+/*
+ * And brings them back when the host returns. upd_neigh marks a MAC that has
+ * just turned local or moved, where the existing change walker already revives
+ * the neighbours.
+ */
+static inline bool zebra_evpn_mac_neighs_go_active(bool local_inactive,
+						   bool old_local_inactive,
+						   bool upd_neigh)
+{
+	return !local_inactive && old_local_inactive && !upd_neigh;
+}
+
+/*
+ * A MAC is pinned in the dataplane while an ES peer claims it or while any of
+ * its neighbours is a sync neighbour. The two references are released
+ * independently and in either order, so whichever goes last is the one that
+ * has to act.
+ */
+static inline bool zebra_evpn_mac_pinned(bool peer_flags,
+					 uint32_t sync_neigh_cnt)
+{
+	return peer_flags || sync_neigh_cnt;
+}
+
+/*
+ * In external-learning mode a local MAC is programmed static and never ages out
+ * of the dataplane, so it has to be flushed explicitly once nothing pins it.
+ */
+static inline bool zebra_evpn_mac_should_flush_inactive(bool ext_learn_mode,
+							bool mac_local,
+							bool mac_local_inactive,
+							bool peer_flags,
+							uint32_t sync_neigh_cnt)
+{
+	if (!ext_learn_mode || !mac_local || !mac_local_inactive)
+		return false;
+
+	return !zebra_evpn_mac_pinned(peer_flags, sync_neigh_cnt);
+}
+
+/*
+ * Per-neighbour skip used by both walkers. want_inactive is the state the
+ * walker is moving neighbours towards, so a neighbour already in that state is
+ * skipped and the walk stays idempotent.
+ */
+static inline bool zebra_evpn_neigh_walk_skip(bool neigh_local,
+					      bool neigh_inactive,
+					      bool want_inactive)
+{
+	if (!neigh_local)
+		return true;
+
+	return neigh_inactive == want_inactive;
+}
+
+#endif /* _FRR_ZEBRA_EVPN_MH_DECISIONS_H */
