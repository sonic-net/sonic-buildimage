+#include "zebra/zebra_neigh.h"
 
 /* definitions */
 
@@ -467,6 +468,9 @@ void zebra_l2if_update_bridge_slave(struct interface *ifp,
 		if (zif->es_info.es)
 			zebra_evpn_es_local_br_port_update(zif);
 	} else if (old_bridge_ifindex != IFINDEX_INTERNAL) {
+		/* The kernel flushed the port's FDB entries as it left. */
+		zebra_neigh_dplane_port_flush(ifp);
+
 		/*
 		 * In the case of VxLAN, invoke the handler for EVPN.
 		 * Note that this should be done *prior*
diff --git a/zebra/zebra_neigh.c b/zebra/zebra_neigh.c
index b0350e2c0d..7f87949a2e 100644
--- a/zebra/zebra_neigh.c
+++ b/zebra/zebra_neigh.c
@@ -580,6 +580,57 @@ static void zebra_neigh_ipaddr_update(struct zebra_dplane_ctx *ctx)
 		zebra_vxlan_handle_kernel_neigh_del(ifp, link_if, &ip);
 }
 
+static bool dplane_mac_learning;
+
+DEFINE_HOOK(zebra_dplane_mac_read, (struct zebra_evpn *zevpn), (zevpn));
+
+void zebra_neigh_set_dplane_mac_learning(bool enable)
+{
+	dplane_mac_learning = enable;
+}
+
+bool zebra_neigh_dplane_mac_learning(void)
+{
+	return dplane_mac_learning;
+}
+
+void zebra_neigh_dplane_mac_read(struct zebra_evpn *zevpn)
+{
+	if (dplane_mac_learning)
+		hook_call(zebra_dplane_mac_read, zevpn);
+}
+
+DEFINE_HOOK(zebra_dplane_mac_port_flush, (struct interface *ifp), (ifp));
+
+/* Called before the port is unlinked from its bridge, while its ifindex
+ * still names it.
+ */
+void zebra_neigh_dplane_port_flush(struct interface *ifp)
+{
+	struct zebra_if *zif = ifp->info;
+
+	if (!dplane_mac_learning || !zif || !zif->brslave_info.br_if || IS_ZEBRA_IF_VXLAN(ifp))
+		return;
+
+	if (IS_ZEBRA_DEBUG_KERNEL)
+		zlog_debug("Applying the kernel's FDB flush of %s(%u)", ifp->name, ifp->ifindex);
+
+	zebra_vxlan_local_macs_port_flush(ifp);
+	hook_call(zebra_dplane_mac_port_flush, ifp);
+}
+
+DEFINE_HOOK(zebra_dplane_mac_port_up, (struct interface *ifp), (ifp));
+
+void zebra_neigh_dplane_port_up(struct interface *ifp)
+{
+	struct zebra_if *zif = ifp->info;
+
+	if (!dplane_mac_learning || !zif || !zif->brslave_info.br_if || IS_ZEBRA_IF_VXLAN(ifp))
+		return;
+
+	hook_call(zebra_dplane_mac_port_up, ifp);
+}
+
 static void zebra_neigh_macfdb_update(struct zebra_dplane_ctx *ctx)
 {
 	ns_id_t ns_id;
@@ -653,6 +704,14 @@ static void zebra_neigh_macfdb_update(struct zebra_dplane_ctx *ctx)
 	ndm_state = dplane_ctx_mac_get_ndm_state(ctx);
 	ndm_flags = dplane_ctx_mac_get_ndm_flags(ctx);
 
+	/* The dataplane module learns local MACs; this entry is zebra's own write. */
+	if (dplane_mac_learning && !IS_ZEBRA_IF_VXLAN(ifp)) {
+		if (IS_ZEBRA_DEBUG_KERNEL)
+			zlog_debug("        Ignoring %s MAC %pEA on %s, a dataplane module learns local MACs",
+				   dplane_op2str(op), &mac, ifp->name);
+		return;
+	}
+
 	/* If add or update, do accordingly if learnt on a "local" interface; if
 	 * the notification is over VxLAN, this has to be related to
 	 * multi-homing,
diff --git a/zebra/zebra_neigh.h b/zebra/zebra_neigh.h
index 30c9f4b644..fd735217a2 100644
--- a/zebra/zebra_neigh.h
+++ b/zebra/zebra_neigh.h
@@ -14,12 +14,15 @@
 #include "lib/prefix.h"
 #include "lib/ns.h"
 #include "lib/if.h"
+#include "lib/hook.h"
 
 struct zebra_pbr_rule;
 struct zebra_dplane_ctx;
 
 #define zneigh_info zrouter.neigh_info
 
+struct zebra_evpn;
+
 struct zebra_neigh_ent {
 	ns_id_t ns_id;
 	ifindex_t ifindex;
@@ -60,4 +63,25 @@ extern void zebra_neigh_deref(struct zebra_pbr_rule *rule);
 extern void zebra_neigh_ref(ns_id_t ns_id, int ifindex, struct ipaddr *ip,
 			    struct zebra_pbr_rule *rule);
 void zebra_neigh_dplane_update(struct zebra_dplane_ctx *ctx);
+/* A dataplane module, not the kernel, learns and ages local MACs. */
+extern void zebra_neigh_set_dplane_mac_learning(bool enable);
+extern bool zebra_neigh_dplane_mac_learning(void);
+/* Where zebra reads local MACs from the kernel, it asks that module for them
+ * instead. zevpn is the EVPN being read, or NULL for all of them.
+ */
+DECLARE_HOOK(zebra_dplane_mac_read, (struct zebra_evpn *zevpn), (zevpn));
+extern void zebra_neigh_dplane_mac_read(struct zebra_evpn *zevpn);
+/* When a bridge port leaves its bridge or goes away, the kernel flushes the
+ * port's FDB entries, which zebra ignores while that module learns local
+ * MACs. zebra applies the flush itself: it deletes the port's local MACs as
+ * the flush would have, then tells the module, which drops what it keeps for
+ * the port.
+ */
+DECLARE_HOOK(zebra_dplane_mac_port_flush, (struct interface *ifp), (ifp));
+extern void zebra_neigh_dplane_port_flush(struct interface *ifp);
+/* A bridge port came up: the module gives zebra the port's MACs it held back
+ * while the port was down.
+ */
+DECLARE_HOOK(zebra_dplane_mac_port_up, (struct interface *ifp), (ifp));
+extern void zebra_neigh_dplane_port_up(struct interface *ifp);
 #endif /* _ZEBRA_NEIGH_H */
