 DEFINE_MTYPE_STATIC(ZEBRA, ZEVPN, "VNI hash");
 DEFINE_MTYPE_STATIC(ZEBRA, ZEVPN_VTEP, "VNI remote VTEP");
@@ -953,6 +954,10 @@ void zebra_evpn_read_mac_neigh(struct zebra_evpn *zevpn, struct interface *ifp)
 			zif->brslave_info.bridge_ifindex);
 
 	dplane_fdb_read_for_bridge(zns, ifp, zif->brslave_info.br_if, vni->access_vlan);
+	/* The local MACs this read reports are ignored while a dataplane
+	 * module learns them, so ask the module instead.
+	 */
+	zebra_neigh_dplane_mac_read(zevpn);
 	/* We need to specifically read and retrieve the entry for BUM handling
 	 * via multicast, if any.
 	 */
diff --git a/zebra/zebra_evpn_mac.c b/zebra/zebra_evpn_mac.c
index 5f9f84f34e..0d88150f17 100644
--- a/zebra/zebra_evpn_mac.c
+++ b/zebra/zebra_evpn_mac.c
@@ -26,6 +26,7 @@
 #include "zebra/zebra_evpn_mh.h"
 #include "zebra/zebra_evpn_mac.h"
 #include "zebra/zebra_evpn_neigh.h"
+#include "zebra/zebra_neigh.h"
 
 DEFINE_MTYPE_STATIC(ZEBRA, MAC, "EVPN MAC");
 
@@ -1480,9 +1481,13 @@ int zebra_evpn_sync_mac_dp_install(struct zebra_mac *mac, bool set_inactive,
 		return 0;
 	}
 
-	if (!zebra_mac_ext_learn_mode() || CHECK_FLAG(mac->flags, ZEBRA_MAC_LOCAL_INACTIVE)) {
+	if (!zebra_mac_ext_learn_mode() || CHECK_FLAG(mac->flags, ZEBRA_MAC_LOCAL_INACTIVE) ||
+	    (zebra_neigh_dplane_mac_learning() && !set_static)) {
 		/* For Extern Only mode:
-		 *  Update the dataplane only when the MAC is inactive
+		 *  Update the dataplane only when the MAC is inactive, or when
+		 *  an active MAC stops being static and a dataplane module
+		 *  learns local MACs: the module keeps the static entry in
+		 *  the ASIC until this write ends it.
 		 */
 		if (IS_ZEBRA_DEBUG_EVPN_MH_MAC) {
 			char mac_buf[MAC_BUF_SIZE];
@@ -1546,7 +1551,13 @@ static void zebra_evpn_mac_hold_exp_cb(struct event *t)
 			   zebra_evpn_zebra_mac_flag_dump(mac, mac_buf, sizeof(mac_buf)));
 	}
 
-	if (zebra_mac_ext_learn_mode()) {
+	/* A dataplane module that learns local MACs also ages them, so only a
+	 * local-inactive MAC is flushed here; an active one stays until the
+	 * module reports it gone.
+	 */
+	if (zebra_mac_ext_learn_mode() &&
+	    (!zebra_neigh_dplane_mac_learning() ||
+	     CHECK_FLAG(mac->flags, ZEBRA_MAC_LOCAL_INACTIVE))) {
 		vlanid_t vid;
 		struct interface *ifp;
 		/* Upon expiry, MAC is deleted from DP. */
@@ -2482,6 +2493,52 @@ int zebra_evpn_del_local_mac(struct zebra_evpn *zevpn, struct zebra_mac *mac,
 	return 0;
 }
 
+struct zebra_evpn_port_flush {
+	struct interface *ifp;
+	struct list *macs;
+};
+
+static void zebra_evpn_port_flush_collect(struct hash_bucket *bucket, void *arg)
+{
+	struct zebra_evpn_port_flush *pf = arg;
+	struct zebra_mac *mac = bucket->data;
+	struct interface *ifp;
+	vlanid_t vid;
+
+	if (!CHECK_FLAG(mac->flags, ZEBRA_MAC_LOCAL))
+		return;
+
+	/* The port of the MAC's FDB entry: its Ethernet Segment's, if any. */
+	zebra_evpn_mac_get_access_info(mac, &ifp, &vid);
+	if (ifp == pf->ifp)
+		listnode_add(pf->macs, mac);
+}
+
+/*
+ * Delete the local MACs of a bridge port in this EVPN, as
+ * zebra_vxlan_local_mac_del() does for each entry of a kernel flush of the
+ * port's FDB.
+ */
+void zebra_evpn_local_macs_port_flush(struct zebra_evpn *zevpn, struct interface *ifp)
+{
+	struct zebra_evpn_port_flush pf = { .ifp = ifp };
+	struct listnode *node, *nnode;
+	struct zebra_mac *mac;
+
+	if (!zevpn->mac_table)
+		return;
+
+	pf.macs = list_new();
+	hash_iterate(zevpn->mac_table, zebra_evpn_port_flush_collect, &pf);
+	for (ALL_LIST_ELEMENTS(pf.macs, node, nnode, mac)) {
+		if (IS_ZEBRA_DEBUG_VXLAN || IS_ZEBRA_DEBUG_EVPN_MH_MAC)
+			zlog_debug("Port flush: DEL local MAC %pEA VNI %u", &mac->macaddr,
+				   zevpn->vni);
+		zebra_evpn_del_local_mac(zevpn, mac, false);
+	}
+	list_delete(&pf.macs);
+}
+
 void zebra_evpn_mac_gw_macip_add(struct interface *ifp, struct zebra_evpn *zevpn,
 				 const struct ipaddr *ip,
 				 struct zebra_mac **macp,
