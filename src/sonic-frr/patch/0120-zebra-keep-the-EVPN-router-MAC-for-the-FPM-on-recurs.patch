From bcd98e6d765c6f5c48e527600861867f78f45da7 Mon Sep 17 00:00:00 2001
From: Ryan Wolfe <rnwolfe@google.com>
Date: Mon, 28 Sep 2026 02:29:51 -0400
Subject: [PATCH] zebra: keep the EVPN router MAC for the FPM on recursive
 nexthops

The l3vni EVPN support carries the router MAC for the FPM in
nh_encap.encap_data, which is set only when an EVPN nexthop arrives over
zapi. A nexthop resolved recursively through an EVPN route gets the EVPN
flag and rmac from the resolving nexthop, but not encap_data, so its FPM
message carries the VNI with a zero router MAC. Copy it along with the
rest.

Signed-off-by: Ryan Wolfe <rnwolfe@google.com>
---
 zebra/zebra_nhg.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/zebra/zebra_nhg.c b/zebra/zebra_nhg.c
index 03441baca7..64f3543a8b 100644
--- a/zebra/zebra_nhg.c
+++ b/zebra/zebra_nhg.c
@@ -2006,6 +2006,9 @@ static struct nexthop *nexthop_set_resolved(afi_t afi, const struct nexthop *new
 	if (CHECK_FLAG(newhop->flags, NEXTHOP_FLAG_EVPN)) {
 		resolved_hop->nh_encap_type = newhop->nh_encap_type;
 		memcpy(&(resolved_hop->rmac), &(newhop->rmac), ETH_ALEN);
+		/* The FPM encodes the router MAC from nh_encap.encap_data. */
+		memcpy(&(resolved_hop->nh_encap.encap_data.rmac),
+		       &(newhop->nh_encap.encap_data.rmac), ETH_ALEN);
 		SET_FLAG(resolved_hop->flags, NEXTHOP_FLAG_EVPN);
 	}
 
