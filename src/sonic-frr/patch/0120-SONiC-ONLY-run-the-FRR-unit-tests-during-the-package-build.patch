@@ -39,7 +39,8 @@ Build-Depends: bison,
 	       protobuf-compiler (>=3.6.1) <pkg.frr.grpc>,
 	       protobuf-compiler-grpc (>=1.16.1) <pkg.frr.grpc>,
                libprotobuf-dev (>=3.6.1) <pkg.frr.grpc>,
-               libgoogle-perftools-dev <pkg.frr.tcmalloc>
+               libgoogle-perftools-dev <pkg.frr.tcmalloc>,
