From 48f00263745ab4e912006ba87b31cbfab054c5fe Mon Sep 17 00:00:00 2001
From: Tamer Ahmed <tamerahmed@microsoft.com>
Date: Mon, 2 Nov 2026 08:58:02 -0800
Subject: [PATCH] zebra: let a dataplane module mark the local MACs it writes

A dataplane module that learns local MACs writes their kernel bridge FDB
entries itself, plain ones, with dplane_local_mac_add(). zebra writes
plain local entries too, and while a module learns local MACs each of
them ends a static entry: zebra writes one when a MAC stops being static,
and when it removes an L2VNI it writes one for each static MAC before it
deletes the EVPN. A module that pins the static entries in its hardware
sees all these writes, but cannot tell its own from zebra's, so it
cannot tell which one ends a pin, least of all once the L2VNI is gone
and zebra's state no longer shows it.

Add dplane_local_mac_learnt(), which writes the same plain entry, marked
DPLANE_MAC_LEARNT. The kernel write does not look at the flag.

Signed-off-by: Tamer Ahmed <tamerahmed@microsoft.com>
---
 zebra/zebra_dplane.c | 14 ++++++++++++++
 zebra/zebra_dplane.h | 12 ++++++++++++
 2 files changed, 26 insertions(+)

diff --git a/zebra/zebra_dplane.c b/zebra/zebra_dplane.c
index 191e66eda9..2ac34f56d1 100644
--- a/zebra/zebra_dplane.c
+++ b/zebra/zebra_dplane.c
@@ -5934,6 +5934,20 @@ enum zebra_dplane_result dplane_local_mac_add(const struct interface *ifp,
 	return result;
 }
 
+/*
+ * Enqueue the entry of a local mac a dataplane module learnt
+ */
+enum zebra_dplane_result dplane_local_mac_learnt(const struct interface *ifp,
+						 const struct interface *bridge_ifp,
+						 vlanid_t vid, const struct ethaddr *mac,
+						 bool sticky)
+{
+	struct ipaddr vtep_ip = { .ipa_type = IPADDR_NONE };
+
+	return mac_update_common(DPLANE_OP_MAC_INSTALL, ifp, bridge_ifp, vid, mac, 0, &vtep_ip,
+				 sticky, 0, DPLANE_MAC_LEARNT);
+}
+
 /*
  * Enqueue local mac del
  */
diff --git a/zebra/zebra_dplane.h b/zebra/zebra_dplane.h
index 787d4c5670..7216c4b5cc 100644
--- a/zebra/zebra_dplane.h
+++ b/zebra/zebra_dplane.h
@@ -271,6 +271,8 @@ enum dplane_op_e {
 #define DPLANE_MAC_WAS_STATIC   (1 << 1)
 #define DPLANE_MAC_SET_STATIC   (1 << 2)
 #define DPLANE_MAC_SET_INACTIVE (1 << 3)
+/* A dataplane module's own write, see dplane_local_mac_learnt() */
+#define DPLANE_MAC_LEARNT       (1 << 4)
 
 /* Neigh update flags - dplane_neigh_info.update_flags */
 #define DPLANE_NEIGH_REMOTE       (1 << 0)
@@ -1100,6 +1102,16 @@ enum zebra_dplane_result dplane_local_mac_add(const struct interface *ifp,
 					uint32_t set_static,
 					uint32_t set_inactive);
 
+/*
+ * The entry of a local MAC that a dataplane module learnt, which it writes
+ * itself: the plain entry dplane_local_mac_add() writes, marked
+ * DPLANE_MAC_LEARNT so that the module can tell it from zebra's writes.
+ */
+enum zebra_dplane_result dplane_local_mac_learnt(const struct interface *ifp,
+						 const struct interface *bridge_ifp,
+						 vlanid_t vid, const struct ethaddr *mac,
+						 bool sticky);
+
 enum zebra_dplane_result
 dplane_local_mac_del(const struct interface *ifp,
 		     const struct interface *bridge_ifp, vlanid_t vid,
