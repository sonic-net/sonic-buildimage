+		return;
+
+	expected_ifp = zebra_evpn_l3mh_neigh_expected_ifp(n);
+	mac_ownership = zebra_evpn_neigh_compat_mac_ownership(n);
+	timer_state = event_is_scheduled(timer) ? "peer-hold" : "inactive";
+	if (event_is_scheduled(n->l3mh_down_timer)) {
