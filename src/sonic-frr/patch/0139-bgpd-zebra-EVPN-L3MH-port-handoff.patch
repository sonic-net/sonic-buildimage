+		vty_out(vty, " Expected interface: %s\n",
+			expected_ifp ? expected_ifp->name : "-");
+		vty_out(vty, " Generation: %u\n", n->l3mh_generation);
+		vty_out(vty, " Last removal reason: %s\n",
