+	if (!IS_ZEBRA_NEIGH_ACTIVE(n) || n->sync_mac_bridge_ifindex != event->bridge ||
+	    n->sync_mac_ifindex != event->port)
+		return false;
+	if (event->deleted) {
+		n->sync_mac_confirmed = false;
+		n->sync_mac_seq = 0;
+	}
+	event->pinned_or_pending |= n->sync_mac_confirmed || n->sync_mac_seq;
+	if (!event->user)
+		event->user = n;
+	return false;
