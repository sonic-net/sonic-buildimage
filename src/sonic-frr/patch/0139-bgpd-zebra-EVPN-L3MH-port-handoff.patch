+	if (current != ZEBRA_L3MH_NEIGH_HANDOFF_WAIT &&
+	    (current != ZEBRA_L3MH_NEIGH_PEER_SYNC_PROTECTED || !zebra_evpn_l3vni_has_peer(n) ||
