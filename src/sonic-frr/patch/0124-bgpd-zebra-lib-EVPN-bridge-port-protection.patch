+			p.prefix.ead_addr.frag_id = es_frag->rd_id;
+			bgp_evpn_mh_route_delete(bgp, es, NULL, es_frag, &p);
+		}
+	}
+
+	bgp_evpn_es_frag_free_unused(es_frag);
