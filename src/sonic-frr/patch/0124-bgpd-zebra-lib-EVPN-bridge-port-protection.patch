+static void bgp_evpn_es_vrf_show_ip_ad_vteps(struct vty *vty, struct bgp_evpn_es_vrf *es_vrf,
+					     json_object *json)
+{
+	struct bgp_evpn_es_vrf_vtep *vtep;
+	json_object *json_vteps = NULL;
+
+	if (json) {
+		bgp_evpn_es_vrf_json_identity(json, es_vrf);
+		json_vteps = json_object_new_array();
+	} else {
+		vty_out(vty, "%-30s %s\n", es_vrf->es->esi_str, es_vrf->bgp_vrf->name);
+		vty_out(vty, "  %-39s %-9s %-8s %-6s %s\n", "Remote-VTEP", "IP-AD-EVI", "IP-AD-ES",
+			"Active", "RMAC");
+	}
+
+	frr_each (bgp_evpn_es_vrf_vtep_list, &es_vrf->es_vrf_vtep_list, vtep) {
+		bool evi = CHECK_FLAG(vtep->flags, BGP_EVPN_ES_VRF_VTEP_IP_EAD_EVI);
+		bool es = CHECK_FLAG(vtep->flags, BGP_EVPN_ES_VRF_VTEP_IP_EAD_ES);
+		bool active = bgp_evpn_es_vrf_vtep_is_active(vtep);
+
+		if (json) {
+			json_object *json_vtep = json_object_new_object();
+
+			json_object_string_addf(json_vtep, "vtep", "%pIA", &vtep->vtep_ip);
+			json_object_boolean_add(json_vtep, "ip_ead_per_evi", evi);
+			json_object_boolean_add(json_vtep, "ip_ead_per_es", es);
+			json_object_boolean_add(json_vtep, "active", active);
+			if (!is_zero_mac(&vtep->rmac))
+				json_object_string_addf(json_vtep, "rmac", "%pEA", &vtep->rmac);
+			json_object_array_add(json_vteps, json_vtep);
+		} else {
+			vty_out(vty, "  %-39pIA %-9s %-8s %-6s %pEA\n", &vtep->vtep_ip,
+				evi ? "yes" : "no", es ? "yes" : "no", active ? "yes" : "no",
+				&vtep->rmac);
+		}
+	}
+
+	if (json)
+		json_object_object_add(json, "vteps", json_vteps);
+}
