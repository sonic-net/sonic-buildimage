diff --git a/tests/bgpd/test_local_nexthop.c b/tests/bgpd/test_local_nexthop.c
new file mode 100644
index 0000000..49962b7
--- /dev/null
+++ b/tests/bgpd/test_local_nexthop.c
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <zebra.h>
+
+#include "debug.h"
+#include "if.h"
+#include "memory.h"
+#include "northbound.h"
+#include "privs.h"
+#include "bgpd/bgpd.h"
+#include "bgpd/bgp_fsm.h"
+#include "bgpd/bgp_network.h"
+
+struct zebra_privs_t bgpd_privs = {0};
+struct event_loop *master;
+extern int zclient_num_connects;
+
+static struct peer *make_peer(struct bgp *bgp, bool ipv6, bool configured)
+{
+	struct peer *peer;
+	union sockunion local, remote;
+
+	assert(str2sockunion(ipv6 ? "2001:db8::1" : "192.0.2.1", &local) == 0);
+	assert(str2sockunion(ipv6 ? "2001:db8::2" : "192.0.2.2", &remote) == 0);
+	peer = peer_create(&remote, NULL, bgp, 65001, 65002, AS_SPECIFIED,
+			   NULL, configured, "65002",
+			   configured ? CONNECTION_OUTGOING : CONNECTION_INCOMING);
+	peer->connection->su_local = sockunion_dup(&local);
+	peer->connection->su_remote = sockunion_dup(&remote);
+	peer->afc[ipv6 ? AFI_IP6 : AFI_IP][SAFI_UNICAST] = 1;
+	return peer;
+}
+
+static int attach_socket(struct peer *peer, enum bgp_fsm_status state)
+{
+	int sockets[2];
+
+	assert(socketpair(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK, 0, sockets) == 0);
+	peer->connection->fd = sockets[0];
+	peer->connection->status = state;
+	return sockets[1];
+}
+
+static void test_missing_address(struct bgp *bgp, bool ipv6, bool delayopen,
+				 enum bgp_fsm_status state, bool configured,
+				 bool dynamic)
+{
+	struct peer *peer = make_peer(bgp, ipv6, configured);
+	enum bgp_fsm_events event = delayopen ? TCP_connection_open_w_delay
+					    : TCP_connection_open;
+	int other = attach_socket(peer, state);
+	char byte;
+	uint32_t start = peer->v_start;
+
+	if (delayopen)
+		SET_FLAG(peer->flags, PEER_FLAG_TIMER_DELAYOPEN);
+	if (dynamic)
+		SET_FLAG(peer->flags, PEER_FLAG_DYNAMIC_NEIGHBOR);
+	/* Keep accepted peers inspectable after the FSM deletes them. */
+	peer_lock(peer);
+	assert(bgp_getsockname(peer->connection) < 0);
+	assert(bgp_event_update(peer->connection, event) == FSM_PEER_STOPPED);
+	assert(peer->connection->fd == -1);
+	assert(!peer->connection->t_delayopen);
+	assert(peer->v_start == start);
+	assert(atomic_load_explicit(&peer->notify_out, memory_order_relaxed) == 0);
+	assert(recv(other, &byte, sizeof(byte), 0) == 0);
+	if (configured && !dynamic) {
+		assert(peer->connection->status == Idle);
+		assert(peer->connection->t_start);
+		peer_delete(peer);
+	} else {
+		assert(peer->connection->status == Deleted);
+	}
+	close(other);
+	peer_unlock(peer);
+}
+
+static void test_address_ready(struct bgp *bgp, bool ipv6, bool delayopen,
+			       enum bgp_fsm_status state)
+{
+	struct interface *ifp = if_get_by_name("test0", VRF_DEFAULT, NULL);
+	struct prefix address, linklocal;
+	struct connected *ifc;
+	struct peer *peer = make_peer(bgp, ipv6, true);
+	enum bgp_fsm_events event = delayopen ? TCP_connection_open_w_delay
+					    : TCP_connection_open;
+	int other = attach_socket(peer, state);
+
+	ifp->ifindex = 1;
+	if (delayopen) {
+		SET_FLAG(peer->flags, PEER_FLAG_TIMER_DELAYOPEN);
+		peer->delayopen = 10;
+	}
+	for (int retry = 0; retry < 6; retry++) {
+		assert(bgp_getsockname(peer->connection) < 0);
+		assert(bgp_event_update(peer->connection, event) == FSM_PEER_STOPPED);
+		assert(peer->connection->status == Idle);
+		assert(peer->connection->t_start);
+		assert(peer->v_start == BGP_INIT_START_TIMER);
+		close(other);
+		other = attach_socket(peer, state);
+	}
+	assert(str2prefix(ipv6 ? "2001:db8::1/64" : "192.0.2.1/24", &address));
+	connected_add_by_prefix(ifp, &address, NULL);
+	if (ipv6) {
+		/* A global address alone cannot supply the required link-local nexthop. */
+		assert(bgp_getsockname(peer->connection) < 0);
+		assert(bgp_event_update(peer->connection, event) == FSM_PEER_STOPPED);
+		assert(peer->connection->status == Idle);
+		assert(peer->v_start == BGP_INIT_START_TIMER);
+		close(other);
+		other = attach_socket(peer, state);
+		assert(str2prefix("fe80::1/64", &linklocal));
+		connected_add_by_prefix(ifp, &linklocal, NULL);
+	}
+	assert(bgp_getsockname(peer->connection) == 0);
+	assert(bgp_event_update(peer->connection, event) ==
+	       (delayopen ? FSM_PEER_NOOP : FSM_PEER_TRANSITIONED));
+	assert(peer->connection->status == (delayopen ? state : OpenSent));
+	assert(!!peer->connection->t_delayopen == delayopen);
+	assert(peer->v_start == BGP_INIT_START_TIMER);
+	assert(atomic_load_explicit(&peer->notify_out, memory_order_relaxed) == 0);
+	peer_delete(peer);
+	close(other);
+	ifc = connected_delete_by_prefix(ifp, &address);
+	connected_free(&ifc);
+	if (ipv6) {
+		ifc = connected_delete_by_prefix(ifp, &linklocal);
+		connected_free(&ifc);
+	}
+	if_delete(&ifp);
+}
+
+static void test_protocol_error(struct bgp *bgp)
+{
+	struct peer *peer = make_peer(bgp, false, true);
+	int other = attach_socket(peer, OpenConfirm);
+	uint32_t start = peer->v_start;
+
+	assert(bgp_event_update(peer->connection, Receive_NOTIFICATION_message) ==
+	       FSM_PEER_TRANSITIONED);
+	assert(peer->connection->status == Idle);
+	assert(peer->connection->fd == -1);
+	assert(peer->v_start == 2 * start);
+	peer_delete(peer);
+	close(other);
+}
+
+int main(void)
+{
+	struct bgp *bgp = NULL;
+	as_t asn = 65001;
+
+	cmd_init(1);
+	debug_init();
+	zlog_aux_init("local-nexthop: ", LOG_DEBUG);
+	zprivs_preinit(&bgpd_privs);
+	zprivs_init(&bgpd_privs);
+	master = event_master_create(NULL);
+	nb_init(master, NULL, 0, false, false);
+	bgp_master_init(master, BGP_SOCKET_SNDBUF_SIZE, list_new());
+	bgp_option_set(BGP_OPT_NO_LISTEN);
+	vrf_init(NULL, NULL, NULL, NULL);
+	frr_pthread_init();
+	bgp_init(0);
+	bgp_pthreads_run();
+	assert(bgp_get(&bgp, &asn, NULL, BGP_INSTANCE_TYPE_DEFAULT, NULL,
+		       ASNOTATION_PLAIN) >= 0);
+	zclient_num_connects = 1;
+
+	for (int ipv6 = 0; ipv6 < 2; ipv6++)
+		for (int delayopen = 0; delayopen < 2; delayopen++)
+			for (int active = 0; active < 2; active++) {
+				enum bgp_fsm_status state = active ? Active : Connect;
+
+				test_missing_address(bgp, ipv6, delayopen, state, true, false);
+				test_missing_address(bgp, ipv6, delayopen, state, false, false);
+				test_missing_address(bgp, ipv6, delayopen, state, true, true);
+				test_address_ready(bgp, ipv6, delayopen, state);
+			}
+
+	test_protocol_error(bgp);
+	bgp_delete(bgp);
+	bgp_pthreads_finish();
+	puts("Local nexthop recovery checks passed");
+	return 0;
+}
diff --git a/tests/bgpd/test_local_nexthop.py b/tests/bgpd/test_local_nexthop.py
new file mode 100644
index 0000000..daa5f36
--- /dev/null
+++ b/tests/bgpd/test_local_nexthop.py
@@ -0,0 +1,9 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+import frrtest
+
+
+class TestLocalNexthop(frrtest.TestMultiOut):
+    program = "./test_local_nexthop"
+
+
+TestLocalNexthop.onesimple("Local nexthop recovery checks passed")
