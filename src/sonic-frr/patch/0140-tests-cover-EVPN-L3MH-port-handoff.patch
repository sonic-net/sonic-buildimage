+        check_origin(first)
+        assert {spine1, spine2} <= source_sessions(first)
+
+        learn(second)
+        l3mh._settle(leaves)
+        check_origin(second)
+        assert {spine1, spine2} <= source_sessions(second)
+
+        configure(
