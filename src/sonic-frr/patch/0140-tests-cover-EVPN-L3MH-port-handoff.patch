+        check_origin(first)
+
+        l3mh._l3mh_knob(receiver, 65012, False)
+        l3mh._l3mh_knob(receiver, 65012, True)
+        l3mh._settle(leaves)
+        check_origin(first)
+    finally:
+        configure(
+            f"router bgp 65012\n address-family l2vpn evpn\n"
+            f"  no neighbor {spine2} route-map {rmap} in\n exit-address-family\n exit\n"
