+        check_origin(second)
+
+        with check_static_fdb(receiver, (ip, mac, vid), permanent_arp=True):
+            second.cmd_raises(f"ip neigh del {ip} dev vlan{vid}")
+            l3mh._settle(leaves)
+        assert (
+            "PERMANENT"
+            in receiver.cmd_raises(f"ip neigh show to {ip} dev vlan{vid}").split()
