load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_python//python:defs.bzl", "py_test")
load("//:flags.bzl", "CFLAGS_GTEST", "DBGFLAGS")

# Standalone source tests default to this module's packages. CI sets these
# test-only inputs to the exact files installed by the same VS build.
[
    label_flag(name = name, build_setting_default = default, testonly = True)
    for name, default in [
        ("runtime_under_test", "//:sysmgr_pkg"),
        ("metadata_under_test", "//:runtime_packages.json"),
        ("symbols_under_test", "//:sysmgr_debug_pkg"),
        ("swss_fixture_under_test", "@sonic_swss_common//tools/bazel/runtime:test_runtime"),
        ("common_under_test", "@sonic_swss_common//dist:libswsscommon_pkg"),
        ("protobuf_under_test", "@sonic_protobuf//:libprotobuf_pkg"),
    ]
]

config_setting(
    name = "runtime_only",
    define_values = {"sysmgr_test_symbols": "off"},
)

genrule(
    name = "mock_header",
    testonly = True,
    srcs = ["//rebootbackend:reboot.xml"],
    outs = ["reboot_dbus_mock.h"],
    cmd = "$(execpath //tools/dbus:generate) --runtime $(location //tools/dbus:runtime) --xml $(location //rebootbackend:reboot.xml) --mode adaptor --output $@",
    tools = [
        "//tools/dbus:generate",
        "//tools/dbus:runtime",
    ],
)

cc_binary(
    name = "reboot_dbus_mock",
    testonly = True,
    srcs = [
        "reboot_dbus_mock.cpp",
        ":mock_header",
    ],
    includes = ["."],
    deps = ["@trixie//libdbus-c++-dev:libdbus-c++"],
)

flatten(
    name = "test_runtime",
    testonly = True,
    deduplicate = True,
    tars = [
        ":swss_fixture_under_test",
        ":common_under_test",
        ":protobuf_under_test",
        "@trixie//libdbus-c++-1-0v5",
        "@trixie//gdb",
        "@build_tools//binutils",
        "@build_tools//bubblewrap",
        "@build_tools//dbus-daemon",
        "@build_tools//redis-server",
    ],
)

py_test(
    name = "installed_sysmgr_test",
    # This test needs a nested private PID/mount/network namespace. CI grants
    # that container capability; no host Redis, D-Bus or reboot path is used.
    timeout = "moderate",
    srcs = ["package_test.py"],
    args = [
        "--runtime-tar=$(rootpath :runtime_under_test)",
        "--dependencies=$(rootpath :test_runtime)",
        "--mock=$(rootpath :reboot_dbus_mock)",
        "--probe=$(rootpath //rebootbackend:gnoi_runtime_test)",
        "--fixture=$(rootpath :installed_reboot_test.py)",
        "--metadata=$(rootpath :metadata_under_test)",
        "--control=$(rootpath //:debian/control)",
        "--changelog=$(rootpath //:debian/changelog)",
    ] + select({
        ":runtime_only": [],
        "//conditions:default": ["--debug-tar=$(rootpath :symbols_under_test)"],
    }),
    data = [
        ":installed_reboot_test.py",
        ":reboot_dbus_mock",
        ":test_runtime",
        "//:debian/changelog",
        "//:debian/control",
        ":metadata_under_test",
        ":runtime_under_test",
        "//rebootbackend:gnoi_runtime_test",
    ] + select({
        ":runtime_only": [],
        "//conditions:default": [":symbols_under_test"],
    }),
    main = "package_test.py",
)

cc_binary(
    name = "original_unit_tests_binary",
    testonly = True,
    srcs = [
        "mock_reboot_interfaces.h",
        "reboot_thread_test.cpp",
        "rebootbe_test.cpp",
        "test_main.cpp",
    ],
    cxxopts = DBGFLAGS + CFLAGS_GTEST,
    deps = [
        "//rebootbackend:reboot_core",
        # The pinned upstream gtest target includes Google Mock.
        "@com_google_googletest//:gtest",
    ],
)

py_test(
    name = "original_unit_tests",
    timeout = "long",
    srcs = [
        "installed_reboot_test.py",
        "package_test.py",
        "unit_test.py",
    ],
    args = [
        "--binary=$(rootpath :original_unit_tests_binary)",
        "--dependencies=$(rootpath :test_runtime)",
        "--runtime-tar=$(rootpath :runtime_under_test)",
    ],
    data = [
        ":original_unit_tests_binary",
        ":test_runtime",
        ":runtime_under_test",
    ],
    # The rules_python launcher does not add the main file's directory.
    imports = ["."],
    main = "unit_test.py",
)
