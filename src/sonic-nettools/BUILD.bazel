load("@sonic_build_infra//rust:release.bzl", "cargo_release_binary")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@sonic_build_infra//tar:sonic_deploy_tar.bzl", "sonic_deploy_tar")
load("@sonic_build_infra//oci:runtime_packages.bzl", "runtime_packages")
package(default_visibility = ["//visibility:public"])
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@sonic_build_infra//cc:runtime_test.bzl", "native_runtime_test")
_DEPS = ["@sonic_rust_deps//:" + name for name in ["pnet", "clap", "libc"]]
rust_binary(name = "wol.binary", srcs = glob(["wol/src/*.rs"]), crate_root = "wol/src/main.rs", crate_name = "wol", edition = "2015", version = "0.0.1", experimental_use_cc_common_link = 0, rustc_flags = ["-Copt-level=3", "-Cdebuginfo=2", "-Cstrip=none"], deps = _DEPS)
rust_test(name = "wol_tests_binary", srcs = glob(["wol/src/*.rs"]), crate_root = "wol/src/main.rs", crate_name = "wol", edition = "2015", version = "0.0.1", experimental_use_cc_common_link = 0, deps = _DEPS, tags = ["manual"])
native_runtime_test(name = "wol_tests", binary = ":wol_tests_binary", runtime_payloads = ["@base_debian//" + name + ":data" for name in ["libc6", "libgcc-s1"]])
sonic_deploy_tar(name = "nettools.runtime", binaries = {"usr/bin/wol uid=0 gid=0 mode=0755 type=file": ":wol"}, force_debug_build = True)
runtime_packages(name = "runtime_packages.json", packages = {"sonic-nettools": ":nettools.runtime"}, control = "debian/control", changelog = "debian/changelog")

cargo_release_binary(name = "wol", src = ":wol.binary")
