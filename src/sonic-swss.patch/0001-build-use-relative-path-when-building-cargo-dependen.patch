From: Ashutosh Agrawal <ashu@cisco.com>
Subject: [PATCH] build: select local swss-common for branch and revision dependencies

Use a Cargo patch table so the image selects its checked-out provider
for workspaces that declare either a Git revision or a branch.

---
 Cargo.toml | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -19,6 +19,9 @@
 trivial_numeric_casts = 'warn'
 unstable_features = 'warn'
 unused_import_braces = 'warn'
+
+[patch."https://github.com/sonic-net/sonic-swss-common.git"]
+swss-common = { path = "../sonic-swss-common/crates/swss-common" }
 
 [workspace.dependencies]
 # Async runtime
