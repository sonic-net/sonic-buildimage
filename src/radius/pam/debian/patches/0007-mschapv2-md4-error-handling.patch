diff --git a/tests/test_mschapv2.c b/tests/test_mschapv2.c
new file mode 100644
index 0000000..639696b
--- /dev/null
+++ b/tests/test_mschapv2.c
@@ -0,0 +1,234 @@
+#include <assert.h>
+#include <openssl/evp.h>
+#include <openssl/opensslv.h>
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+#include <openssl/provider.h>
+#endif
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+
+#include "mschapv2.h"
+
+enum failure_stage {
+	FAIL_NONE,
+	FAIL_DEFAULT_PROVIDER,
+	FAIL_LEGACY_PROVIDER,
+	FAIL_FETCH,
+	FAIL_INIT,
+	FAIL_UPDATE,
+	FAIL_FINAL,
+};
+
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+#define FIRST_DIGEST_FAILURE FAIL_FETCH
+#else
+#define FIRST_DIGEST_FAILURE FAIL_INIT
+#endif
+
+static enum failure_stage fail_stage;
+static int fail_occurrence;
+static int stage_calls;
+
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+OSSL_PROVIDER *__real_OSSL_PROVIDER_load(OSSL_LIB_CTX *libctx,
+					 const char *name);
+EVP_MD *__real_EVP_MD_fetch(OSSL_LIB_CTX *ctx, const char *algorithm,
+			    const char *properties);
+#endif
+int __real_EVP_DigestInit_ex(EVP_MD_CTX *ctx, const EVP_MD *type,
+			     ENGINE *impl);
+int __real_EVP_DigestUpdate(EVP_MD_CTX *ctx, const void *data, size_t count);
+int __real_EVP_DigestFinal_ex(EVP_MD_CTX *ctx, unsigned char *md,
+			      unsigned int *size);
+
+static int fail_now(enum failure_stage stage)
+{
+	if (fail_stage != stage)
+		return 0;
+
+	stage_calls++;
+	return stage_calls == fail_occurrence;
+}
+
+static int is_md4(const EVP_MD *md)
+{
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+	const char *name = md == NULL ? NULL : EVP_MD_get0_name(md);
+
+	return name != NULL && strcasecmp(name, "MD4") == 0;
+#else
+	return md != NULL && EVP_MD_type(md) == NID_md4;
+#endif
+}
+
+static const EVP_MD *ctx_md(EVP_MD_CTX *ctx)
+{
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+	return EVP_MD_CTX_get0_md(ctx);
+#else
+	return EVP_MD_CTX_md(ctx);
+#endif
+}
+
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+OSSL_PROVIDER *__wrap_OSSL_PROVIDER_load(OSSL_LIB_CTX *libctx,
+					 const char *name)
+{
+	if (strcmp(name, "default") == 0 && fail_now(FAIL_DEFAULT_PROVIDER))
+		return NULL;
+	if (strcmp(name, "legacy") == 0 && fail_now(FAIL_LEGACY_PROVIDER))
+		return NULL;
+	return __real_OSSL_PROVIDER_load(libctx, name);
+}
+
+EVP_MD *__wrap_EVP_MD_fetch(OSSL_LIB_CTX *ctx, const char *algorithm,
+			    const char *properties)
+{
+	if (strcasecmp(algorithm, "MD4") == 0 && fail_now(FAIL_FETCH))
+		return NULL;
+	return __real_EVP_MD_fetch(ctx, algorithm, properties);
+}
+#endif
+
+int __wrap_EVP_DigestInit_ex(EVP_MD_CTX *ctx, const EVP_MD *type,
+			     ENGINE *impl)
+{
+	if (is_md4(type) && fail_now(FAIL_INIT))
+		return 0;
+	return __real_EVP_DigestInit_ex(ctx, type, impl);
+}
+
+int __wrap_EVP_DigestUpdate(EVP_MD_CTX *ctx, const void *data, size_t count)
+{
+	if (is_md4(ctx_md(ctx)) && fail_now(FAIL_UPDATE))
+		return 0;
+	return __real_EVP_DigestUpdate(ctx, data, count);
+}
+
+int __wrap_EVP_DigestFinal_ex(EVP_MD_CTX *ctx, unsigned char *md,
+			      unsigned int *size)
+{
+	if (is_md4(ctx_md(ctx)) && fail_now(FAIL_FINAL))
+		return 0;
+	return __real_EVP_DigestFinal_ex(ctx, md, size);
+}
+
+static void set_failure(enum failure_stage stage, int occurrence)
+{
+	fail_stage = stage;
+	fail_occurrence = occurrence;
+	stage_calls = 0;
+}
+
+static int all_zero(const unsigned char *buf, size_t len)
+{
+	size_t i;
+
+	for (i = 0; i < len; i++)
+		if (buf[i] != 0)
+			return 0;
+	return 1;
+}
+
+static void test_rfc2759_vectors(void)
+{
+	unsigned char auth_challenge[16] = {
+		0x5b, 0x5d, 0x7c, 0x7d, 0x7b, 0x3f, 0x2f, 0x3e,
+		0x3c, 0x2c, 0x60, 0x21, 0x32, 0x26, 0x26, 0x28,
+	};
+	unsigned char peer_challenge[16] = {
+		0x21, 0x40, 0x23, 0x24, 0x25, 0x5e, 0x26, 0x2a,
+		0x28, 0x29, 0x5f, 0x2b, 0x3a, 0x33, 0x7c, 0x7e,
+	};
+	unsigned char expected_hash[16] = {
+		0x44, 0xeb, 0xba, 0x8d, 0x53, 0x12, 0xb8, 0xd6,
+		0x11, 0x47, 0x44, 0x11, 0xf5, 0x69, 0x89, 0xae,
+	};
+	unsigned char expected_hash_hash[16] = {
+		0x41, 0xc0, 0x0c, 0x58, 0x4b, 0xd2, 0xd9, 0x1c,
+		0x40, 0x17, 0xa2, 0xa1, 0x2f, 0xa5, 0x9f, 0x3f,
+	};
+	unsigned char expected_nt_response[24] = {
+		0x82, 0x30, 0x9e, 0xcd, 0x8d, 0x70, 0x8b, 0x5e,
+		0xa0, 0x8f, 0xaa, 0x39, 0x81, 0xcd, 0x83, 0x54,
+		0x42, 0x33, 0x11, 0x4a, 0x3d, 0x85, 0xd6, 0xdf,
+	};
+	unsigned char expected_auth_response[20] = {
+		0x40, 0x7a, 0x55, 0x89, 0x11, 0x5f, 0xd0, 0xd6,
+		0x20, 0x9f, 0x51, 0x0f, 0xe9, 0xc0, 0x45, 0x66,
+		0x93, 0x2c, 0xda, 0x56,
+	};
+	unsigned char password_hash[16];
+	unsigned char password_hash_hash[16];
+	unsigned char nt_response[24];
+	unsigned char auth_response[20];
+
+	set_failure(FAIL_NONE, 0);
+	assert(NtPasswordHash("clientPass", (char *)password_hash));
+	assert(memcmp(password_hash, expected_hash, sizeof(password_hash)) == 0);
+	assert(HashNtPasswordHash((char *)password_hash,
+				  (char *)password_hash_hash));
+	assert(memcmp(password_hash_hash, expected_hash_hash,
+		      sizeof(password_hash_hash)) == 0);
+	assert(GenerateNTResponse((char *)auth_challenge, (char *)peer_challenge,
+				  "User", "clientPass", (char *)nt_response, 0));
+	assert(memcmp(nt_response, expected_nt_response, sizeof(nt_response)) == 0);
+	assert(GenerateAuthenticatorResponse(
+		"clientPass", (char *)nt_response, (char *)peer_challenge,
+		(char *)auth_challenge, "User", (char *)auth_response, 0));
+	assert(memcmp(auth_response, expected_auth_response,
+		      sizeof(auth_response)) == 0);
+}
+
+static void test_failures_propagate(void)
+{
+	unsigned char auth_challenge[16] = {0};
+	unsigned char peer_challenge[16] = {0};
+	unsigned char nt_response[24];
+	unsigned char auth_response[20];
+	enum failure_stage stage;
+	int occurrence;
+
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+	for (stage = FAIL_DEFAULT_PROVIDER; stage <= FAIL_LEGACY_PROVIDER;
+	     stage++) {
+		memset(nt_response, 0xa5, sizeof(nt_response));
+		set_failure(stage, 1);
+		assert(!GenerateNTResponse((char *)auth_challenge,
+					   (char *)peer_challenge, "User",
+					   "clientPass", (char *)nt_response, 0));
+		assert(all_zero(nt_response, sizeof(nt_response)));
+	}
+#endif
+
+	for (stage = FIRST_DIGEST_FAILURE; stage <= FAIL_FINAL; stage++) {
+		memset(nt_response, 0xa5, sizeof(nt_response));
+		set_failure(stage, 1);
+		assert(!GenerateNTResponse((char *)auth_challenge,
+					   (char *)peer_challenge, "User",
+					   "clientPass", (char *)nt_response, 0));
+		assert(all_zero(nt_response, sizeof(nt_response)));
+	}
+
+	memset(nt_response, 0, sizeof(nt_response));
+	for (stage = FIRST_DIGEST_FAILURE; stage <= FAIL_FINAL; stage++) {
+		for (occurrence = 1; occurrence <= 2; occurrence++) {
+			memset(auth_response, 0xa5, sizeof(auth_response));
+			set_failure(stage, occurrence);
+			assert(!GenerateAuthenticatorResponse(
+				"clientPass", (char *)nt_response,
+				(char *)peer_challenge, (char *)auth_challenge,
+				"User", (char *)auth_response, 0));
+			assert(all_zero(auth_response, sizeof(auth_response)));
+		}
+	}
+}
+
+int main(void)
+{
+	test_failures_propagate();
+	test_rfc2759_vectors();
+	puts("MSCHAPv2 digest tests passed");
+	return 0;
+}
