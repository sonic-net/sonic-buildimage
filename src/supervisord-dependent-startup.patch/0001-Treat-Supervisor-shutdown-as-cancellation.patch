From: Xichen Lin <lukelin0907@gmail.com>
Subject: Treat Supervisor shutdown as cancellation

SONiC carries this patch on upstream v1.4.0 (736256fcfafc9a8a738544393d4293cb15db2761).
Keep the package version and all non-shutdown launcher behavior unchanged.

--- a/supervisord_dependent_startup/supervisord_dependent_startup.py
+++ b/supervisord_dependent_startup/supervisord_dependent_startup.py
@@ -19,7 +19,7 @@
 from supervisor.datatypes import boolean, integer
 from supervisor.options import UnhosedConfigParser
 from supervisor.states import RUNNING_STATES
-from supervisor.xmlrpc import xmlrpclib
+from supervisor.xmlrpc import Faults, xmlrpclib
 import toposort


@@ -908,6 +908,10 @@
     exit_code = 0
     try:
         main()
+    except xmlrpclib.Fault as error:
+        if error.faultCode != Faults.SHUTDOWN_STATE:
+            log.error("Error occured:", exc_info=sys.exc_info())
+            exit_code = 3
     except:  # noqa: E722
         log.error("Error occured:", exc_info=sys.exc_info())
         exit_code = 3
