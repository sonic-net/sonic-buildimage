load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@sonic_build_infra//oci:runtime_packages.bzl", "runtime_packages")
load("@sonic_build_infra//tar:sonic_deploy_tar.bzl", "sonic_deploy_tar")
load("//src/sonic-supervisord-utilities-rs:bazel/release.bzl", "release_binary")

package(default_visibility = ["//visibility:public"])

exports_files(["bazel/shared-crate-dependencies.patch"])

rust_binary(
    name = "sonic-containercfgd-rs",
    srcs = glob(["src/*.rs"]),
    crate_name = "sonic_containercfgd_rs",
    crate_root = "src/main.rs",
    edition = "2024",
    experimental_use_cc_common_link = 0,
    rustc_flags = ["-Cdebuginfo=2", "-Cstrip=none"],
    version = "1.0.0",
    deps = ["@sonic_swss_common//crates/swss-common:swss_common"] + [
        "@sonic_rust_deps//:" + crate
        for crate in [
            "anyhow",
            "clap",
            "epoll",
            "libc",
            "log",
            "regex",
            "rustix",
            "syslog-tracing",
            "tracing",
            "tracing-subscriber",
        ]
    ],
)

release_binary(
    name = "release",
    binary = ":sonic-containercfgd-rs",
)

sonic_deploy_tar(
    name = "runtime",
    binaries = {"usr/bin/sonic-containercfgd-rs uid=0 gid=0 mode=0755 type=file": ":release"},
)

runtime_packages(
    name = "bazel/runtime_packages.json",
    changelog = "debian/changelog",
    control = "debian/control",
    dependencies = ["@sonic_swss_common//:runtime_packages.json"],
    packages = {"sonic-containercfgd-rs": ":runtime"},
    required_paths = {"sonic-containercfgd-rs": ["usr/bin/sonic-containercfgd-rs"]},
)
