module(name = "sonic_device_data")

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "pigz", version = "2.8.bcr.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_gzip", version = "1.0.0")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "tar.bzl", version = "0.10.5")
bazel_dep(name = "toolchain_utils", version = "1.0.2")
bazel_dep(name = "toolchains_musl", version = "0.2.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(is_default = True, python_version = "3.13")

# Build the upstream pigz target with a pinned static compiler and libc.
musl = use_extension("@toolchains_musl//:toolchains_musl.bzl", "toolchains_musl")
use_repo(musl, "musl_toolchains_hub")
register_toolchains("@musl_toolchains_hub//:all", "//:gzip_toolchain")

device_data_metadata = use_repo_rule("//src/sonic-device-data:input_metadata.bzl", "device_data_metadata")
device_data_metadata(name = "vs_device_data_inputs")
