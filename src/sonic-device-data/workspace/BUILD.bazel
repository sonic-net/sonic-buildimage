load("@rules_multirun//:defs.bzl", "command")
load("@toolchain_utils//toolchain/info:defs.bzl", "toolchain_info")

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

# rules_gzip delegates to this executable. GNU --no-name omits the source
# filename and timestamp from the package's compressed Debian changelog.
command(
    name = "reproducible_gzip",
    arguments = ["--no-name"],
    command = "@pigz//:pigz",
)

toolchain_info(
    name = "gzip_info",
    target = ":reproducible_gzip",
)

toolchain(
    name = "gzip_toolchain",
    toolchain = ":gzip_info",
    toolchain_type = "@rules_gzip//gzip/toolchain/gzip:type",
)
