cc_shared_library(name="bash_tacplus",deps=[":code"],dynamic_deps=["@pam-tacplus//:libtac_shared","@pam-tacplus//:libtacsupport_shared"],shared_lib_name="bash_tacplus.so",features=FEATURES,user_link_flags=["-g","-Wl,-soname,bash_tacplus.so","-Wl,-z,relro"])
