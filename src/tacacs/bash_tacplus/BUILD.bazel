py_test(name="installation_test",srcs=["installation_test.py"],args=["$(rootpath :bash-tacplus.runtime)","$(rootpath :bash-tacplus.control)"],data=[":bash-tacplus.runtime",":bash-tacplus.control",":original_check_binary"],deps=["@sonic_build_infra//deb:elf_metadata"])
