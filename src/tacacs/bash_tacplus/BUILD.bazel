sonic_deploy_tar(name="bash-tacplus.runtime",compress_debug_sections=True,binaries={"./usr/lib/x86_64-linux-gnu/security/bash_tacplus.so type=file uid=0 gid=0 mode=0644 time=0":":bash_tacplus"},srcs=[":libtool_archive"],mtree=["./usr/lib/x86_64-linux-gnu/security/bash_tacplus.la type=file uid=0 gid=0 mode=0644 time=0 content=$(location :libtool_archive)"])
runtime_packages(name="runtime_metadata",module_name="bash-tacplus",control="debian/control",changelog="debian/changelog",packages={"bash-tacplus":":bash-tacplus.runtime"},dependencies=["@pam-tacplus//:runtime_metadata"],required_paths={"bash-tacplus":["usr/lib/x86_64-linux-gnu/security/bash_tacplus.so","usr/lib/x86_64-linux-gnu/security/bash_tacplus.la"]},debian_files={"compat":"debian/compat","bash-tacplus.postinst":"debian/bash-tacplus.postinst"},control_file_helpers=[["dh_installdeb"]])
