cc_binary(name="original_check_binary",srcs=["unittest/plugin_test.c","unittest/mock_helper.c","bash_tacplus.c"]+glob(["unittest/*.h"]),copts=["-DHAVE_CONFIG_H","-g","-O2","-fstack-protector-strong","-fstack-clash-protection","-Wformat","-Werror=format-security","-Wno-parentheses","-Wno-format-security","-Wno-implicit-function-declaration","-Wno-int-to-pointer-cast","-DDEBUG","-DBASH_PLUGIN_UT","'-DTACACS_DEVICE_TYPE=\"Test\\040Device\\040Type\"'"],features=FEATURES,deps=[":headers","@tacacs_build_debian//libcunit1-dev:libcunit_cc"])
