load("@sonic_build_infra//rust:release.bzl", "cargo_release_binary")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@sonic_build_infra//tar:sonic_deploy_tar.bzl", "sonic_deploy_tar")
load("@sonic_build_infra//oci:runtime_packages.bzl", "runtime_packages")
package(default_visibility = ["//visibility:public"])
_DOCKER_DEPS = ["@sonic_rust_deps//:" + name for name in ["bollard", "chrono", "enumset", "futures-util", "clap", "tokio", "serde_json", "thiserror", "tracing", "tracing-subscriber", "syslog-tracing"]]
rust_binary(name = "docker-rs.binary", srcs = glob(["crates/docker-rs/src/*.rs"]), crate_root = "crates/docker-rs/src/main.rs", crate_name = "docker_rs", edition = "2021", version = "0.1.0", experimental_use_cc_common_link = 0, rustc_flags = ["-Copt-level=3", "-Cdebuginfo=2", "-Cstrip=none"], deps = _DOCKER_DEPS)
_WAIT_DEPS = ["@sonic_rust_deps//:" + name for name in ["async-trait", "bollard", "clap", "tokio", "futures-util", "thiserror", "tracing", "tracing-subscriber", "syslog-tracing"]] + ["//src/sonic-rs-common:sonic_rs_common", "@sonic_swss_common//crates/swss-common:swss_common"]
rust_library(name = "docker_wait_any_library", srcs = glob(["crates/docker-wait-any-rs/src/*.rs"], exclude = ["crates/docker-wait-any-rs/src/main.rs"]), crate_root = "crates/docker-wait-any-rs/src/lib.rs", crate_name = "docker_wait_any_rs", edition = "2021", version = "0.1.0", deps = _WAIT_DEPS)
rust_binary(name = "docker-wait-any-rs.binary", srcs = ["crates/docker-wait-any-rs/src/main.rs"], crate_root = "crates/docker-wait-any-rs/src/main.rs", crate_name = "docker_wait_any_rs_bin", edition = "2021", version = "0.1.0", experimental_use_cc_common_link = 0, rustc_flags = ["-Copt-level=3", "-Cdebuginfo=2", "-Cstrip=none"], deps = _WAIT_DEPS + [":docker_wait_any_library"])
sonic_deploy_tar(name = "ctrmgrd_rs.runtime", binaries = {"usr/bin/docker-rs uid=0 gid=0 mode=0755 type=file": ":docker-rs", "usr/bin/docker-wait-any-rs uid=0 gid=0 mode=0755 type=file": ":docker-wait-any-rs"}, force_debug_build = True)
runtime_packages(name = "runtime_packages.json", packages = {"sonic-ctrmgrd-rs": ":ctrmgrd_rs.runtime"}, control = "debian/control", changelog = "debian/changelog", dependencies = ["@sonic_swss_common//:runtime_packages.json"])

cargo_release_binary(name = "docker-rs", src = ":docker-rs.binary")

cargo_release_binary(name = "docker-wait-any-rs", src = ":docker-wait-any-rs.binary")
