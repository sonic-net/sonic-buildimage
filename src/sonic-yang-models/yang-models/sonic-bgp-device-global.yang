module sonic-bgp-device-global {
    namespace "http://github.com/sonic-net/sonic-bgp-device-global";
    prefix bgp_device_global;
    yang-version 1.1;

    organization
        "SONiC";

    contact
        "SONiC";

    description
        "SONIC Device-specific BGP global data";

    revision 2026-10-06 {
        description "Add BGP_DEVICE_GLOBAL_AF table with per-AFI-SAFI install_backup_path (BGP PIC Local) control, restricted to unicast address families";
    }

    revision 2026-04-28 {
        description "Add chassis_tsa_supported to select CHASSIS_APP_DB vs per-linecard TSA orchestration";
    }

    revision 2024-01-28 {
        description "Add Weighted ECMP using BGP link bandwidth";
    }

    revision 2022-06-26 {
        description "Initial revision";
    }

    container sonic-bgp-device-global {

        container BGP_DEVICE_GLOBAL {

            description "Device-level BGP global settings such as TSA, WCMP, and IDF isolation.";

            container STATE {

                description "BGP device-specific global data";

                leaf tsa_enabled {
                    type boolean;
                    default "false";
                    description
                    "When set to true, Traffic is shifted away (TSA), i.e, BGP routes are not advertised to neighboring routers";
                }

                leaf chassis_tsa_supported {
                    type boolean;
                    default "false";
                    description
                    "When true, chassis-wide TSA state is synchronized using CHASSIS_APP_DB on the supervisor.
                     When false (default), CHASSIS_APP_DB is not used for TSA, the supervisor should push TSA/TSB
                     to linecards out-of-band (for example via rexec).";
                }

                leaf wcmp_enabled {
                    description "Enables/Disables Weighted-Equal Cost-Multipath using BGP link bandwidth";
                    type boolean;
                    default "false";
                }

                leaf idf_isolation_state {
                    description "Configures device IDF isolation state";
                    type enumeration {
                        enum isolated_no_export {
                            description "IDF isolated using no-export community tag";
                        }
                        enum isolated_withdraw_all {
                            description "IDF isolated by withdrawing routes";
                        }
                        enum unisolated {
                            description "IDF un-isolated";
                        }
                    }
                    default "unisolated";
                }

            }
            /* end of STATE container */
            /* start of CONFED container */
            container CONFED
            {
                description "BGP Confederation related configuration";

                leaf asn {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Autonomous System Number for BGP confederation";
                }

                /* List of peer ASN part of the confederation */
                leaf peers {
                    type string;
                    description "List of sub-ASNs in the confederation separated by semi-colon";
                }
            }
            /* end of CONFED container */
        }
        /* end of BGP_DEVICE_GLOBAL container */

        container BGP_DEVICE_GLOBAL_AF {

            description "Per-address-family BGP device global settings (BGP_DEVICE_GLOBAL_AF part of config_db.json)";

            list BGP_DEVICE_GLOBAL_AF_LIST {

                key "afi_safi";

                description "Each entry controls BGP behavior for one address family across the entire device.
                             Key is the AFI-SAFI string, e.g. ipv4_unicast, ipv6_unicast,
                             ipv4_multicast, ipv6_multicast, l2vpn_evpn.";

                leaf afi_safi {
                    type string;
                    description "Address family identifier, e.g. ipv4_unicast, ipv6_unicast,
                                 ipv4_multicast, ipv6_multicast, l2vpn_evpn";
                }

                leaf install_backup_path {
                    must "current() = 'disabled' or
                          contains(current()/../afi_safi, '_unicast')" {
                        error-message "install_backup_path is supported only for unicast address families (ipv4_unicast, ipv6_unicast)!";
                    }
                    type enumeration {
                        enum disabled {
                            description "No backup path installation (default). BGP will not pre-program
                                         alternate next-hops for fast failover.";
                        }
                        enum pic {
                            description "Prefix Independent Convergence (PIC): install a single backup
                                         next-hop so that route failover triggers a fast local dataplane
                                         swap without waiting for BGP reconvergence.";
                        }
                        enum pic-ecmp {
                            description "PIC with ECMP backup paths: install multiple backup next-hops,
                                         enabling load-balanced fast failover across all available
                                         alternate paths.";
                        }
                    }
                    default disabled;
                    description "Controls BGP Prefix Independent Convergence (PIC) backup path
                                 installation for this address family across the device.
                                 Translated to FRR 'install backup-path [ecmp]' in the address-family block.";
                }
            }
            /* end of BGP_DEVICE_GLOBAL_AF_LIST */
        }
        /* end of BGP_DEVICE_GLOBAL_AF container */
    }
    /* end of container sonic-bgp-device-global */
}
/* end of module sonic-bgp-device-global */
