module sonic-bgp-peerrange {
    namespace "http://github.com/sonic-net/sonic-bgp-peerrange";
    prefix pr;
    yang-version 1.1;

    import ietf-inet-types {
        prefix inet;
    }

    import sonic-types {
        prefix stypes;
    }

    import sonic-vrf {
        prefix vrf;
    }

    import sonic-vnet {
        prefix svnet;
    }

    organization
        "SONiC";

    contact
        "SONiC";

    description
        "SONIC BGP Peer Range YANG";

    revision 2026-09-18 {
        description
            "Reject line breaks in dynamic peer-range names and qualified keys.";
    }

    revision 2022-02-24 {
        description
            "Initial revision.";
    }

    typedef peer-range-name {
        type string {
            pattern '[^\n\r]*' {
                error-message "BGP peer-range name must not contain line breaks";
            }
        }
        description "A single-line dynamic BGP peer-range identifier.";
    }

    container sonic-bgp-peerrange {
        container BGP_PEER_RANGE {
            list BGP_PEER_RANGE_LIST {
                description "This list supports BGP_PEER_RANGE_TEMPLATE configurations with vnet and vrf support";
                key "vrf_name peer_range_name";

                leaf vrf_name {
                    type union {
                        type leafref {
                            path "/vrf:sonic-vrf/vrf:VRF/vrf:VRF_LIST/vrf:name";
                        }
                        type leafref {
                            path "/svnet:sonic-vnet/svnet:VNET/svnet:VNET_LIST/svnet:name";
                        }
                    }
                    must "re-match(current(), '[^\\n\\r]*')" {
                        error-message "BGP peer-range VRF or VNET name must not contain line breaks";
                    }
                    description "VRF or VNET name for this peer range.";
                }

                leaf peer_range_name {
                    type peer-range-name;
                    description "Peer range name";
                }

                leaf name {
                    type peer-range-name;
                    must "(current() = current()/../peer_range_name)" {
                        error-message "Invalid name, name must match peer_range_name";
                    }
                    description "Peer range display name, must match the peer_range_name key.";
                }

                leaf src_address {
                    type inet:ip-address;
                    description "Source address to use for connection";
                }

                leaf peer_asn {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Peer AS number";
                }

                leaf-list ip_range {
                    type stypes:sonic-ip-prefix;
                    ordered-by user;
                    description "A range of addresses";
                }
            }

            list BGP_PEER_RANGE_TEMPLATE_LIST {
                description "This list is to support template based BGP peer range configurations.";
                key "peer_range_name";

                leaf peer_range_name {
                    type peer-range-name;
                    description "Peer range name";
                }

                leaf name {
                    type peer-range-name;
                    must "(current() = current()/../peer_range_name)" {
                        error-message "Invalid name, name must match peer_range_name";
                    }
                    description "Peer range display name, must match the peer_range_name key.";
                }

                leaf src_address {
                    type inet:ip-address;
                    description "Source address to use for connection";
                }

                leaf peer_asn {
                    type uint32 {
                        range "1..4294967295";
                    }
                    description "Peer AS number";
                }

                leaf-list ip_range {
                    type stypes:sonic-ip-prefix;
                    ordered-by user;
                    description "A range of addresses";
                }
            }
        }
    }
}
