module sonic-vnet {
    yang-version 1.1;
    namespace "http://github.com/sonic-net/sonic-vnet";
    prefix svnet;

    import ietf-yang-types {
        prefix yang;
    }

    import ietf-inet-types {
        prefix inet;
    }

    import sonic-types {
        prefix stypes;
    }

    import sonic-vxlan {
        prefix svxlan;
    }
    organization
        "SONiC";

    contact
        "SONiC";

    description
        "Virtual Network (VNET) configuration for overlay networking using VxLAN tunnels";

    revision 2026-10-12 {
        description
            "Add vxlan_tunnel_list as a comma-separated string to VNET_LIST. vxlan_tunnel is no longer
             mandatory on its own; at least one of vxlan_tunnel or vxlan_tunnel_list
             must be configured. Limit the list to one IPv4 and one IPv6 tunnel.";
    }

    revision 2023-04-25 {
        description
            "First revision.";
    }

    container sonic-vnet {

        container VNET {

            description "Virtual Network configuration table for overlay networking";

            list VNET_LIST {

                description "Configuration entry for a Virtual Network instance";

                key "name";

                must "boolean(vxlan_tunnel) or string-length(vxlan_tunnel_list) > 0" {
                    error-message "At least one of vxlan_tunnel or vxlan_tunnel_list must be configured.";
                }

                must "count(/svxlan:sonic-vxlan/svxlan:VXLAN_TUNNEL/svxlan:VXLAN_TUNNEL_LIST" +
                     "[contains(concat(',', current()/vxlan_tunnel_list, ','), concat(',', svxlan:name, ','))]" +
                     "[not(contains(svxlan:src_ip, ':'))]) <= 1" {
                    error-message "vxlan_tunnel_list must not contain more than one IPv4 tunnel.";
                }

                must "count(/svxlan:sonic-vxlan/svxlan:VXLAN_TUNNEL/svxlan:VXLAN_TUNNEL_LIST" +
                     "[contains(concat(',', current()/vxlan_tunnel_list, ','), concat(',', svxlan:name, ','))]" +
                     "[contains(svxlan:src_ip, ':')]) <= 1" {
                    error-message "vxlan_tunnel_list must not contain more than one IPv6 tunnel.";
                }

                leaf name {
                    description "Unique alphanumeric name identifying the virtual network";
                    type string {
                        length 1..255;
                    }
                }

                leaf vxlan_tunnel {
                    description "A valid and active vxlan tunnel to be used with this vnet for traffic encapsulation.
                                 Required when vxlan_tunnel_list is empty or absent. A non-empty
                                 vxlan_tunnel_list takes precedence over this leaf.";
                    type leafref {
                        path "/svxlan:sonic-vxlan/svxlan:VXLAN_TUNNEL/svxlan:VXLAN_TUNNEL_LIST/svxlan:name";
                    }
                }

                leaf vxlan_tunnel_list {
                    description "Comma-separated names of valid and active vxlan tunnels to be used
                                 with this vnet for traffic encapsulation. This field is a string in
                                 both CONFIG_DB and YANG, like peer_list.
                                 As required by vnetorch, at most one IPv4 tunnel and one
                                 IPv6 tunnel are allowed, determined by each tunnel's src_ip.
                                 The string may be empty, name one tunnel of either address family,
                                 or name one of each. An empty or absent string requires vxlan_tunnel.
                                 A non-empty string takes precedence over vxlan_tunnel.";
                    type string {
                        pattern '([^,]+(,[^,]+)?)?' {
                            error-message "vxlan_tunnel_list must be empty or contain one or two comma-separated tunnel names.";
                        }
                    }
                    must "not(contains(., ',')) or substring-before(., ',') != substring-after(., ',')" {
                        error-message "vxlan_tunnel_list must not contain duplicate tunnels.";
                    }
                    must ". = '' or " +
                         "(substring-before(concat(., ','), ',') = " +
                         "/svxlan:sonic-vxlan/svxlan:VXLAN_TUNNEL/svxlan:VXLAN_TUNNEL_LIST/svxlan:name and " +
                         "(not(contains(., ',')) or substring-after(., ',') = " +
                         "/svxlan:sonic-vxlan/svxlan:VXLAN_TUNNEL/svxlan:VXLAN_TUNNEL_LIST/svxlan:name))" {
                        error-message "vxlan_tunnel_list must reference existing VXLAN tunnels.";
                    }
                }

                leaf vni {
                    mandatory true;
                    description "A valid and unique vni which will become part of the encapsulated traffic header.";
                    type stypes:vnid_type;
                }

                leaf peer_list {
                    description "Set of peers";
                    /* Values in leaf list are UNIQUE */
                    type string;
                }

                leaf guid {
                    description "An optional guid.";
                    type string {
                        length 1..255;
                    }
                }

                leaf scope {
                    description "can only be default.";
                    type string {
                        pattern "default" {
                            error-message "Invalid VRF name";
                        }
                    }
                }

                leaf advertise_prefix {
                    description "Flag to enable advertisement of route prefixes belonging to the Vnet.";
                    type  boolean;
                }

                leaf overlay_dmac {
                    description "Overlay Dest MAC address to be used by Vnet ping.";
                    type yang:mac-address;
                }

                leaf src_mac {
                    description "source mac address for the Vnet";
                    type yang:mac-address;
                }
            }
            /* end of list VNET_LIST */
        }
        /* end of container VNET */

        container VNET_ROUTE {

            description "Static routes within a virtual network";

            list VNET_ROUTE_LIST {
                description "Static route entry within a virtual network";

                key "vnet_name prefix";

                leaf vnet_name {
                    description "VNET name";
                    type leafref {
                        path "/svnet:sonic-vnet/svnet:VNET/svnet:VNET_LIST/svnet:name";
                    }
                }

                leaf prefix {
                    description "IP prefix in CIDR format (IPv4 or IPv6)";
                    type stypes:sonic-ip-prefix;
                }

                leaf nexthop {
                    description "Nexthop IP addresses (IPv4 or IPv6, comma-separated)";
                    type union {
                        type stypes:ipv4-address-list;
                        type stypes:ipv6-address-list;
                    }
                    mandatory true;
                }

                leaf ifname {
                    description "Interface names";
                    type string;
                    mandatory true;
                }
            }
            /* end of list VNET_ROUTE_LIST */
        }
        /* end of container VNET_ROUTE */

        container VNET_ROUTE_TUNNEL {

            description "Tunnel-encapsulated routes within a virtual network";
            
            list VNET_ROUTE_TUNNEL_LIST {
                description "Tunnel-encapsulated route entry for overlay traffic within a virtual network";
                key "vnet_name prefix";

                leaf vnet_name {
                    description "VNET name";
                    type leafref {
                        path "/svnet:sonic-vnet/svnet:VNET/svnet:VNET_LIST/svnet:name";
                    }
                }
                
                leaf prefix {
                    description "IP prefix in CIDR format (IPv4 or IPv6)";
                    type stypes:sonic-ip-prefix;
                }
                
                leaf endpoint {
                    description "Endpoint/nexthop tunnel IPs (IPv4 or IPv6, comma-separated)";
                    type union {
                        type stypes:ipv4-address-list;
                        type stypes:ipv6-address-list;
                    }
                    mandatory true;
                }

                leaf mac_address {
                    description "Inner dest macs in encapsulated packet";
                    type stypes:mac-address-list;
                }

                leaf vni {
                    description "Valid and active vni values in encapsulated packet";
                    type stypes:vnid-list;
                }

                leaf consistent_hashing_buckets {
                    description "Number of consistent hashing buckets to use, if consistent hashing is desired";
                    type uint16;
                }

                leaf metric {
                    description "Value that can be set to categorize or determine the type of route. This value does not affect route behavior.";
                    type uint8;
                }
            }
            /* end of list VNET_ROUTE_TUNNEL_LIST */
        }
        /* end of container VNET_ROUTE_TUNNEL */
    }
    /* end of container sonic-vnet */
}
/* end of module sonic-vnet */