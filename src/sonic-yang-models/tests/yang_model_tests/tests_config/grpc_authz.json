    "GRPC_AUTHZ_POLICY_WITH_VALID_CONFIG": {
        "sonic-grpc-authz:sonic-grpc-authz": {
            "sonic-grpc-authz:GRPC_AUTHZ_METADATA": {
                "GRPC_AUTHZ_METADATA_LIST": [
                    {
