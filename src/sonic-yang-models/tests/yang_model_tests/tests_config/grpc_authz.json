                    {
                        "name": "client.example.com",
                        "roles": [
                            "reader"
                        ]
                    }
                ]
            },
            "sonic-grpc-authz:GRPC_AUTHZ_RULE": {
                "GRPC_AUTHZ_RULE_LIST": [
                    {
                        "name": "allow-gnmi-get",
                        "roles": [
                            "reader"
                        ],
                        "rpc": "/gnmi.gNMI/Get",
                        "effect": "allow",
                        "priority": "100"
                    },
                    {
                        "name": "allow-interface-read",
                        "roles": [
                            "reader"
                        ],
                        "rpc": "/gnmi.gNMI/Get",
                        "path": "/interfaces",
                        "operations": [
                            "READ"
                        ],
                        "effect": "allow",
                        "priority": "200"
                    }
                ]
            }
        }
