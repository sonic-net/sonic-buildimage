{
    "GRIBI_TABLE_WITH_VALID_CONFIG": {
        "sonic-gribi:sonic-gribi": {
            "sonic-gribi:GRIBI": {
                "certs": {
                    "server_crt": "/etc/sonic/tls/gribi.crt",
                    "server_key": "/etc/sonic/tls/gribi.key",
                    "ca_crt": "/etc/sonic/tls/ca.crt"
                },
                "config": {
                    "port": "9340",
                    "fib_ack_timeout": "30",
                    "log_level": "info",
                    "enable_reflection": "false"
                }
            }
        }
    },
    "GRIBI_TABLE_WITHOUT_CERTS": {
