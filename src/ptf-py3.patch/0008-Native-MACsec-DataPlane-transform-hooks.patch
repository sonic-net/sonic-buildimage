@@ -669,6 +679,25 @@ class DataPlane(Thread):
 
         self.logger.info("Thread exit")
 
+    def register_port_transform(self, device_number, port_number, tx=None, rx=None):
+        self._port_transforms[(device_number, port_number)] = {"tx": tx, "rx": rx}
+
+    def _install_native_macsec(self):
+        try:
+            import ptf_macsec
+        except ImportError:
+            return
+        try:
+            if ptf_macsec.install(self):
+                global NATIVE_MACSEC_CAPABLE
+                NATIVE_MACSEC_CAPABLE = True
+                logging.getLogger("dataplane").info(
+                    "Native MACsec codec installed for %d port(s)",
+                    len(self._port_transforms))
+        except Exception as e:
+            logging.getLogger("dataplane").warning(
+                "Native MACsec codec install failed: %s", e)
+
     def set_qlen(self, qlen):
