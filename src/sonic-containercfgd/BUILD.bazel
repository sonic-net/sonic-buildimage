load("@rules_python//python:packaging.bzl", "py_wheel")
load("@rules_python//python:py_library.bzl", "py_library")
load("@sonic_build_infra//python:site_packages.bzl", "site_packages")

package(default_visibility = ["//visibility:public"])

exports_files(["setup.py"])

py_library(
    name = "containercfgd",
    srcs = glob(["containercfgd/*.py"]),
    imports = ["."],
    deps = [
        "//src/sonic-py-common:sonic_py_common",
        "@sonic_swss_common//pyext:swsscommon",
    ],
)

# setup.py installs both packages. Preserve that public wheel contract while
# the separate test target executes the complete existing pytest suite.
filegroup(
    name = "wheel_payload",
    srcs = glob([
        "containercfgd/*.py",
        "tests/*.py",
    ]),
)

_SOURCE_DISTRIBUTION = "sonic-containercfgd"

_SOURCE_ENTRY_POINTS = {"console_scripts": ["containercfgd = containercfgd.containercfgd:main"]}

_SOURCE_LICENSE = "Apache 2.0"

_SOURCE_PYTHON_TAG = "py3"

_SOURCE_REQUIRES = ["sonic_py_common"]

_SOURCE_SUMMARY = "SONiC container config daemon package"

_SOURCE_VERSION = "1.0"

py_wheel(
    name = "sonic_containercfgd_wheel",
    distribution = _SOURCE_DISTRIBUTION,
    entry_points = _SOURCE_ENTRY_POINTS,
    license = _SOURCE_LICENSE,
    python_tag = _SOURCE_PYTHON_TAG,
    requires = _SOURCE_REQUIRES,
    strip_path_prefixes = ["src/sonic-containercfgd/"],
    summary = _SOURCE_SUMMARY,
    version = _SOURCE_VERSION,
    deps = [":wheel_payload"],
)

filegroup(
    name = "test_sources",
    srcs = glob(
        [
            "containercfgd/**",
            "tests/**",
        ],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ) + [
        "pytest.ini",
        "setup.cfg",
        "setup.py",
    ],
)

# Direct source installation preserves setup.py metadata and original wheel API.
site_packages(
    name = "sonic-containercfgd.runtime",
    author = "SONiC Team",
    author_email = "linuxnetdev@microsoft.com",
    classifiers = [
        "Development Status :: 4 - Beta",
        "Environment :: No Input/Output (Daemon)",
        "Intended Audience :: Developers",
        "Intended Audience :: Information Technology",
        "Intended Audience :: System Administrators",
        "License :: OSI Approved :: Apache Software License",
        "Natural Language :: English",
        "Operating System :: POSIX :: Linux",
        "Programming Language :: Python :: 3.7",
        "Topic :: System :: Hardware",
    ],
    data_prefix = "/usr/local",
    distribution = _SOURCE_DISTRIBUTION,
    entry_points = _SOURCE_ENTRY_POINTS,
    files = {p: p for p in glob([
        "containercfgd/*.py",
        "tests/*.py",
    ])},
    headers = "/usr/local/include",
    homepage = "https://github.com/Azure/sonic-buildimage",
    interpreter = "/usr/bin/python3",
    keywords = "SONiC sonic container config daemon",
    license = _SOURCE_LICENSE,
    maintainer = "Junchao Chen",
    maintainer_email = "junchaow@nvidia.com",
    python_tag = _SOURCE_PYTHON_TAG,
    regular_file_mode = "0644",
    requires = _SOURCE_REQUIRES,
    scripts = "/usr/local/bin",
    site_packages = "/usr/local/lib/python3.13/dist-packages",
    summary = _SOURCE_SUMMARY,
    version = _SOURCE_VERSION,
    runtime_deps = ["//src/sonic-py-common:sonic-py-common.runtime"],
)

filegroup(
    name = "sonic-containercfgd.runtime_metadata",
    srcs = [":sonic-containercfgd.runtime"],
    output_group = "metadata",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "source_install_test_sources",
    testonly = True,
    srcs = [":test_sources"],
    visibility = ["//tools/bazel/tests:__pkg__"],
)
