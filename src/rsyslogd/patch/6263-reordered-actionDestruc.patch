From 084dd714f155b4a8ec0b6beffcac684b5183dc53 Mon Sep 17 00:00:00 2001
From: Cropi <alakatos@redhat.com>
Date: Fri, 24 Oct 2025 07:45:32 +0200
Subject: [PATCH] action.c: reordered actionDestruc
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Worker instances are destroyed before the shared module data, preventing
modules such as omfwd from touching freed state during teardown.

Problem description:
When shutting down an action, rsyslog first frees the shared
configuration data, then tries to free each worker's data. The problem
is that workers need to read the shared configuration during their
cleanup—for example, to check how many TCP connections to close. Since
the shared data was already freed, the workers end up reading from
deallocated memory, which is a use-after-free bug.
---
 action.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/action.c b/action.c
index 928c16690c..64e03d06e0 100644
--- a/action.c
+++ b/action.c
@@ -314,9 +314,6 @@ rsRetVal actionDestruct(action_t *const pThis) {
 	if(pThis->statsobj != NULL)
 		statsobj.Destruct(&pThis->statsobj);
 
-	if(pThis->pModData != NULL)
-		pThis->pMod->freeInstance(pThis->pModData);
-
 	if(pThis->fdErrFile != -1)
 		close(pThis->fdErrFile);
 	pthread_mutex_destroy(&pThis->mutErrFile);
@@ -327,6 +325,12 @@ rsRetVal actionDestruct(action_t *const pThis) {
 	free(pThis->peParamPassing);
 	freeWrkrDataTable(pThis);
 
+    /* The module's instance data must be freed after the worker data table,
+     * as workers may need to access the shared module data during their
+     * cleanup.
+     */
+    if (pThis->pModData != NULL) pThis->pMod->freeInstance(pThis->pModData);
+
 finalize_it:
 	free(pThis);
 	RETiRet;
