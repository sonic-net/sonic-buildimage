# Module versions, source commits and package snapshots remain pinned.
common --registry=https://raw.githubusercontent.com/sonic-net/sonic-bazel-registry/main
common --registry=https://bcr.bazel.build

# Reuse prepared dependencies across local checkouts and fresh output bases.
common --repo_contents_cache=~/.cache/sonic/bazel-repo-contents
try-import /etc/sonic-buildimage/repo-contents.bazelrc
import %workspace%/tools/bazel/common.bazelrc

# Reference only; cache-reachable CI jobs opt in through .bazelrc.user.
# common --remote_cache=grpc://172.16.0.4:9092
# common --experimental_remote_downloader=grpc://172.16.0.4:9092
# common --experimental_remote_downloader_local_fallback
