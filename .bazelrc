try-import %workspace%/tools/bazel/common.bazelrc

# Always build our own src/ modules from the checked-out tree, regardless of
# what version any consumer's bazel_dep declares -- see the file's header
# comment for why. Enabled unconditionally (not opt-in) since this is only
# ever imported by sonic-buildimage's own root .bazelrc.
try-import %workspace%/tools/bazel/root-unpinned-modules-config.bazelrc
common --config=local-modules

common --per_file_copt=.*external.*@-w
common --cxxopt=-std=c++17 --host_cxxopt=-std=c++17
common --features=external_include_paths

# TODO(bazel-ready): YANG-driven cfg_schema.h generation (gen_cfg_schema.py) is not
# wired into the Bazel build yet. It needs the YANG toolchain in the registry plus a
# python toolchain.
#
# Until then, disable YANG modules so swss-common builds with the
# minimal cfg_schema.h stub instead of failing as deliberately-incompatible.
common --@sonic_swss_common//tools/bazel:yang_modules=False

# Select the (only) venv configuration for pip dependencies resolved by the `uv`
# extension in src/sonic-build-infra/deps/pyproject.toml
common --@aspect_rules_py//uv/private/constraints/venv:venv=sonic-build-infra-python-deps
